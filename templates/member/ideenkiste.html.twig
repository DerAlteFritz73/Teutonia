{% extends 'base.html.twig' %}

{% block title %}Ideenkiste - {{ parent() }}{% endblock %}

{% block body %}
<!-- template: templates/member/ideenkiste.html.twig -->
<main id="main-content">
    <div class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1><i class="bi bi-lightbulb"></i> Ideenkiste</h1>
            <a href="{{ path('member_ideenkiste_new') }}" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Neuer Vorschlag
            </a>
        </div>

        <p class="lead">Schlage neue Songs für unser Repertoire vor!</p>

        {# Sort Controls #}
        <div class="btn-group mb-4" role="group">
            <a href="{{ path('member_ideenkiste', {sort: 'newest'}) }}"
               class="btn btn-outline-primary {{ sort == 'newest' ? 'active' : '' }}">
                Neueste zuerst
            </a>
            <a href="{{ path('member_ideenkiste', {sort: 'popular'}) }}"
               class="btn btn-outline-primary {{ sort == 'popular' ? 'active' : '' }}">
                Beliebteste zuerst
            </a>
        </div>

        {# Flash Messages #}
        {% for message in app.flashes('success') %}
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}

        {# Suggestions Grid #}
        <div class="row">
            {% for suggestion in suggestions %}
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card suggestion-card">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">{{ suggestion.title }}</h5>
                        {% if suggestion.artist %}
                            <h6 class="card-subtitle mb-2 text-muted">{{ suggestion.artist }}</h6>
                        {% endif %}
                        {% if suggestion.description %}
                            <div class="suggestion-description collapsed" onclick="toggleDescription(this)">
                                <p class="card-text mb-0">{{ suggestion.description|nl2br }}</p>
                            </div>
                        {% endif %}

                        <div class="mt-auto">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <small class="text-muted">
                                    von {{ suggestion.submittedBy.firstName }} {{ suggestion.submittedBy.lastName }}
                                    <br>
                                    {{ suggestion.createdAt|date('d.m.Y') }}
                                </small>

                                {# Like Button #}
                                <button class="btn btn-sm like-button {{ suggestion.isLikedByUser(app.user) ? 'btn-danger' : 'btn-outline-danger' }}"
                                        data-suggestion-id="{{ suggestion.id }}">
                                    <i class="bi bi-heart{{ suggestion.isLikedByUser(app.user) ? '-fill' : '' }}"></i>
                                    <span class="like-count">{{ suggestion.likeCount }}</span>
                                </button>
                            </div>

                            {% if suggestion.pdfPath %}
                                {% set ext = suggestion.pdfPath|split('.')|last|lower %}
                                {% if ext in ['jpg', 'jpeg', 'png', 'gif', 'webp', 'bmp', 'svg'] %}
                                    {% set fileIcon = 'bi-file-image' %}
                                {% elseif ext in ['mp3', 'm4a', 'ogg', 'wav', 'aac', 'flac', 'mscz', 'mscx'] %}
                                    {% set fileIcon = 'bi-file-music' %}
                                {% elseif ext == 'pdf' %}
                                    {% set fileIcon = 'bi-file-pdf' %}
                                {% else %}
                                    {% set fileIcon = 'bi-file-earmark' %}
                                {% endif %}
                                <a href="{{ asset(suggestion.pdfPath) }}" target="_blank" class="btn btn-sm btn-outline-primary w-100 mb-2">
                                    <i class="bi {{ fileIcon }}"></i> Datei ansehen
                                </a>
                            {% endif %}

                            {% if suggestion.link %}
                                {% set isYoutube = 'youtube.com' in suggestion.link or 'youtu.be' in suggestion.link %}
                                <a href="{{ suggestion.link }}" target="_blank" rel="noopener noreferrer"
                                   class="btn btn-sm btn-outline-secondary w-100 mb-2">
                                    {% if isYoutube %}
                                        <i class="bi bi-youtube text-danger me-1"></i>YouTube
                                    {% else %}
                                        <i class="bi bi-link-45deg me-1"></i>Link
                                    {% endif %}
                                </a>
                            {% endif %}

                            {# Edit/Delete for own suggestions or admins #}
                            {% if suggestion.submittedBy.id == app.user.id or is_granted('ROLE_ADMIN') %}
                                <div class="d-flex gap-2">
                                    <a href="{{ path('member_ideenkiste_edit', {id: suggestion.id}) }}"
                                       class="btn btn-sm btn-outline-secondary flex-fill">
                                        <i class="bi bi-pencil"></i> Bearbeiten
                                    </a>
                                    <form method="post"
                                          action="{{ path('member_ideenkiste_delete', {id: suggestion.id}) }}"
                                          class="flex-fill"
                                          onsubmit="return confirm('Wirklich löschen?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ suggestion.id) }}">
                                        <button class="btn btn-sm btn-outline-danger w-100">
                                            <i class="bi bi-trash"></i> Löschen
                                        </button>
                                    </form>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
            {% else %}
            <div class="col-12">
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i>
                    Noch keine Vorschläge vorhanden. Sei der Erste!
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</main>

<style>
.suggestion-description {
    position: relative;
    cursor: pointer;
    margin-bottom: .5rem;
}
.suggestion-description.collapsed {
    max-height: 4.5em;
    overflow: hidden;
}
.suggestion-description.collapsed::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 2em;
    background: linear-gradient(transparent, #fff);
    pointer-events: none;
}
</style>

<script src="{{ asset('js/member-ideenkiste.js') }}"></script>
<script>
function toggleDescription(el) {
    el.classList.toggle('collapsed');
}
</script>
{% endblock %}
