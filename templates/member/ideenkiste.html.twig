{% extends 'base.html.twig' %}

{% block title %}Ideenkiste - {{ parent() }}{% endblock %}

{% block body %}
<main id="main-content">
    <div class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1><i class="bi bi-lightbulb"></i> Ideenkiste</h1>
            <a href="{{ path('member_ideenkiste_new') }}" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Neuer Vorschlag
            </a>
        </div>

        <p class="lead">Schlage neue Songs für unser Repertoire vor!</p>

        {# Sort Controls #}
        <div class="btn-group mb-4" role="group">
            <a href="{{ path('member_ideenkiste', {sort: 'newest'}) }}"
               class="btn btn-outline-primary {{ sort == 'newest' ? 'active' : '' }}">
                Neueste zuerst
            </a>
            <a href="{{ path('member_ideenkiste', {sort: 'popular'}) }}"
               class="btn btn-outline-primary {{ sort == 'popular' ? 'active' : '' }}">
                Beliebteste zuerst
            </a>
        </div>

        {# Flash Messages #}
        {% for message in app.flashes('success') %}
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}

        {# Suggestions Grid #}
        <div class="row">
            {% for suggestion in suggestions %}
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 suggestion-card">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">{{ suggestion.title }}</h5>
                        {% if suggestion.artist %}
                            <h6 class="card-subtitle mb-2 text-muted">{{ suggestion.artist }}</h6>
                        {% endif %}
                        {% if suggestion.description %}
                            <p class="card-text">{{ suggestion.description|nl2br }}</p>
                        {% endif %}

                        <div class="mt-auto">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <small class="text-muted">
                                    von {{ suggestion.submittedBy.firstName }} {{ suggestion.submittedBy.lastName }}
                                    <br>
                                    {{ suggestion.createdAt|date('d.m.Y') }}
                                </small>

                                {# Like Button #}
                                <button class="btn btn-sm like-button {{ suggestion.isLikedByUser(app.user) ? 'btn-danger' : 'btn-outline-danger' }}"
                                        data-suggestion-id="{{ suggestion.id }}">
                                    <i class="bi bi-heart{{ suggestion.isLikedByUser(app.user) ? '-fill' : '' }}"></i>
                                    <span class="like-count">{{ suggestion.likeCount }}</span>
                                </button>
                            </div>

                            {% if suggestion.pdfPath %}
                                <a href="{{ asset(suggestion.pdfPath) }}" target="_blank" class="btn btn-sm btn-outline-primary w-100 mb-2">
                                    <i class="bi bi-file-pdf"></i> Noten ansehen
                                </a>
                            {% endif %}

                            {# Edit/Delete for own suggestions #}
                            {% if suggestion.submittedBy == app.user %}
                                <div class="d-flex gap-2">
                                    <a href="{{ path('member_ideenkiste_edit', {id: suggestion.id}) }}"
                                       class="btn btn-sm btn-outline-secondary flex-fill">
                                        <i class="bi bi-pencil"></i> Bearbeiten
                                    </a>
                                    <form method="post"
                                          action="{{ path('member_ideenkiste_delete', {id: suggestion.id}) }}"
                                          class="flex-fill"
                                          onsubmit="return confirm('Wirklich löschen?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ suggestion.id) }}">
                                        <button class="btn btn-sm btn-outline-danger w-100">
                                            <i class="bi bi-trash"></i> Löschen
                                        </button>
                                    </form>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
            {% else %}
            <div class="col-12">
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i>
                    Noch keine Vorschläge vorhanden. Sei der Erste!
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</main>

{# JavaScript for AJAX like functionality #}
<script>
document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.like-button').forEach(button => {
        button.addEventListener('click', function() {
            const suggestionId = this.dataset.suggestionId;
            const buttonElement = this;

            fetch(`/mitglieder/ideenkiste/${suggestionId}/like`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                }
            })
            .then(response => response.json())
            .then(data => {
                // Update button appearance
                const icon = buttonElement.querySelector('i');
                if (data.liked) {
                    buttonElement.classList.remove('btn-outline-danger');
                    buttonElement.classList.add('btn-danger');
                    icon.classList.remove('bi-heart');
                    icon.classList.add('bi-heart-fill');
                } else {
                    buttonElement.classList.remove('btn-danger');
                    buttonElement.classList.add('btn-outline-danger');
                    icon.classList.remove('bi-heart-fill');
                    icon.classList.add('bi-heart');
                }
                // Update count
                buttonElement.querySelector('.like-count').textContent = data.likeCount;
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Fehler beim Liken. Bitte versuchen Sie es erneut.');
            });
        });
    });
});
</script>
{% endblock %}
