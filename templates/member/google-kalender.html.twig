{% extends 'base.html.twig' %}

{% block title %}Kalender - {{ parent() }}{% endblock %}

{% block body %}
<!-- template: templates/member/google-kalender.html.twig -->
<div class="container-fluid py-4" style="max-width: 1200px">
    <div class="d-flex align-items-center justify-content-between mb-1">
        <h1 class="mb-0">Kalender</h1>
        {% if is_granted('ROLE_ADMIN') %}
        <div class="text-end">
            <a href="https://calendar.google.com/calendar/r" target="_blank" rel="noopener" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-pencil-square me-1"></i>Kalender bearbeiten
            </a>
            <div class="text-muted small mt-1">Als chor.teutonia@gmail.com anmelden</div>
        </div>
        {% endif %}
    </div>
    <p class="lead text-muted">Kalender von chor.teutonia@gmail.com</p>

    {% set fcEvents = [] %}
    {% for event in events %}
        {% set isAllDay = event.start.date is defined %}
        {% set fcEvents = fcEvents|merge([{
            title: event.summary ?? '(kein Titel)',
            start: isAllDay ? event.start.date : event.start.dateTime,
            end:   isAllDay ? event.end.date   : event.end.dateTime,
            allDay: isAllDay
        }]) %}
    {% endfor %}

    <div class="row g-4">
        <div class="col-lg-8">
            <div id="fullcalendar" style="border-radius:.5rem;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,.12)"></div>
        </div>

        <div class="col-lg-4">
            <h5 class="mb-3"><i class="bi bi-calendar-event me-2"></i>Nächste Termine</h5>
            {% set monthNames = ['Jan', 'Feb', 'Mär', 'Apr', 'Mai', 'Jun', 'Jul', 'Aug', 'Sep', 'Okt', 'Nov', 'Dez'] %}
            {% if events is not empty %}
            <div class="list-group" id="events-list">
                {% for event in events %}
                    {% set isAllDay = event.start.date is defined %}
                    {% set startRaw = isAllDay ? event.start.date : event.start.dateTime %}
                    {% set endRaw   = isAllDay ? event.end.date   : event.end.dateTime %}
                    <div class="list-group-item list-group-item-action py-3 event-item" style="display:none">
                        <div class="d-flex align-items-start gap-3">
                            <div class="text-center bg-light rounded px-2 py-1" style="min-width:54px; line-height:1.2;">
                                <div class="fw-bold fs-5 lh-1">{{ startRaw|date('d') }}</div>
                                <div class="text-muted small text-uppercase">{{ monthNames[startRaw|date('n') - 1] }}</div>
                                <div class="text-muted" style="font-size:.7rem">{{ startRaw|date('Y') }}</div>
                            </div>
                            <div class="flex-grow-1">
                                <div class="fw-semibold">{{ event.summary ?? '(kein Titel)' }}</div>
                                <div class="text-muted small">
                                    {% if isAllDay %}
                                        Ganztägig
                                    {% else %}
                                        {{ startRaw|date('H:i') }} Uhr
                                        {%- if endRaw is defined and endRaw != startRaw %} – {{ endRaw|date('H:i') }} Uhr{% endif %}
                                    {% endif %}
                                    {% if event.location is defined and event.location %}
                                        &nbsp;<i class="bi bi-geo-alt"></i> {{ event.location }}
                                    {% endif %}
                                </div>
                                {% if event.description is defined and event.description %}
                                    <div class="text-muted small mt-1">{{ event.description|striptags|slice(0, 120) }}{% if event.description|striptags|length > 120 %}…{% endif %}</div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
            <div class="d-flex align-items-center justify-content-between mt-2">
                <button class="btn btn-sm btn-outline-secondary" id="events-prev" disabled>
                    <i class="bi bi-chevron-left"></i>
                </button>
                <span class="text-muted small" id="events-pager"></span>
                <button class="btn btn-sm btn-outline-secondary" id="events-next">
                    <i class="bi bi-chevron-right"></i>
                </button>
            </div>
            <script>
            (function () {
                const PER_PAGE = 5;
                const items = document.querySelectorAll('#events-list .event-item');
                const total = items.length;
                const pages = Math.ceil(total / PER_PAGE);
                let page = 0;

                function render() {
                    items.forEach((el, i) => {
                        el.style.display = (i >= page * PER_PAGE && i < (page + 1) * PER_PAGE) ? '' : 'none';
                    });
                    document.getElementById('events-pager').textContent =
                        (page * PER_PAGE + 1) + '–' + Math.min((page + 1) * PER_PAGE, total) + ' / ' + total;
                    document.getElementById('events-prev').disabled = page === 0;
                    document.getElementById('events-next').disabled = page >= pages - 1;
                }

                document.getElementById('events-prev').addEventListener('click', function () { if (page > 0) { page--; render(); } });
                document.getElementById('events-next').addEventListener('click', function () { if (page < pages - 1) { page++; render(); } });

                render();
            }());
            </script>
            {% else %}
            <p class="text-muted">Keine bevorstehenden Termine.</p>
            {% endif %}
        </div>
    </div>
</div>

<script>
var _fcInstance = null;
var _fcEvents   = {{ fcEvents|json_encode|raw }};

pageLoad(function () {
    var el = document.getElementById('fullcalendar');
    if (!el) return;

    function initCalendar() {
        if (_fcInstance) { _fcInstance.destroy(); _fcInstance = null; }
        _fcInstance = new FullCalendar.Calendar(el, {
            initialView:      'dayGridMonth',
            locale:           'de',
            firstDay:         1,
            headerToolbar:    { left: 'prev,next today', center: 'title', right: '' },
            height:           'auto',
            eventColor:       '#0d6efd',
            displayEventTime: false,
            events: _fcEvents.flatMap(function (e) {
                return [
                    e,
                    Object.assign({}, e, { display: 'background', color: 'rgba(13,110,253,0.12)', title: '' })
                ];
            })
        });
        _fcInstance.render();
    }

    if (window.FullCalendar) {
        initCalendar();
    } else {
        var s = document.createElement('script');
        s.src = 'https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js';
        s.onload = initCalendar;
        document.head.appendChild(s);
    }
});
</script>
{% endblock %}
