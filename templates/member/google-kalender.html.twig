{% extends 'base.html.twig' %}

{% block title %}Google-Kalender - {{ parent() }}{% endblock %}

{% block body %}
<!-- template: templates/member/google-kalender.html.twig -->
<div class="container-fluid py-4" style="max-width: 1200px">
    <h1>Google-Kalender</h1>
    <p class="lead text-muted">Kalender von chor.teutonia@gmail.com</p>

    <div class="mt-3" style="position: relative; padding-bottom: 75%; height: 0; overflow: hidden; border-radius: .5rem; box-shadow: 0 2px 8px rgba(0,0,0,.12);">
        <iframe
            src="https://calendar.google.com/calendar/embed?src=chor.teutonia%40gmail.com&ctz=Europe%2FBerlin&hl=de&showTitle=0&showNav=1&showDate=1&showPrint=0&showTabs=1&showCalendars=1&showTz=1"
            style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0;"
            frameborder="0"
            scrolling="no"
            title="Google-Kalender Teutonia">
        </iframe>
    </div>
</div>
{% endblock %}
