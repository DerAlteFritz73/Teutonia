{# Shared styles, modals and scripts for the song-browser pages
   (Aktuelle Proben + Noten). Included once per page after the accordion markup. #}
<style>
    /* The Etikett / title / genres column layout for these accordion rows lives
       in public/css/app.css (see ".song-row"). */
</style>

<!-- PDF Viewer Modal -->
<div class="modal fade" id="pdfViewerModal" tabindex="-1" aria-labelledby="pdfViewerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-fullscreen-lg-down">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="pdfViewerModalLabel">
                    <i class="bi bi-file-pdf-fill text-danger me-2"></i>
                    <span id="pdfFileName"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0" style="height: 80vh;">
                <iframe id="pdfViewerFrame" style="width: 100%; height: 100%; border: none;"></iframe>
            </div>
            <div class="modal-footer">
                <a id="pdfDownloadLink" href="#" download class="btn btn-primary">
                    <i class="bi bi-download me-2"></i>Herunterladen
                </a>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Schließen</button>
            </div>
        </div>
    </div>
</div>

<!-- Audio Player Modal -->
<div class="modal fade" id="audioPlayerModal" tabindex="-1" aria-labelledby="audioPlayerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="audioPlayerModalLabel">
                    <i class="bi bi-music-note-beamed text-primary me-2"></i>
                    <span id="audioFileName"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <audio id="audioPlayer" controls class="w-100 mb-4" style="outline: none;">
                    Ihr Browser unterstützt das Audio-Element nicht.
                </audio>

                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title mb-3">
                            <i class="bi bi-speedometer2 me-2"></i>Wiedergabegeschwindigkeit
                        </h6>
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <label for="speedSlider" class="form-label mb-0" style="min-width: 60px;">
                                <span id="speedValue">1.0</span>x
                            </label>
                            <input type="range" class="form-range flex-grow-1" id="speedSlider"
                                   min="0.25" max="2.0" step="0.05" value="1.0">
                        </div>
                        <div class="d-flex gap-2 flex-wrap">
                            <button class="btn btn-sm btn-outline-secondary speed-preset" data-speed="0.5">0.5x</button>
                            <button class="btn btn-sm btn-outline-secondary speed-preset" data-speed="0.75">0.75x</button>
                            <button class="btn btn-sm btn-outline-primary speed-preset" data-speed="1">1.0x</button>
                            <button class="btn btn-sm btn-outline-secondary speed-preset" data-speed="1.25">1.25x</button>
                            <button class="btn btn-sm btn-outline-secondary speed-preset" data-speed="1.5">1.5x</button>
                            <button class="btn btn-sm btn-outline-secondary speed-preset" data-speed="2">2.0x</button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success" id="audioPlayBtn">
                    <i class="bi bi-play-fill me-1"></i>Abspielen
                </button>
                <button type="button" class="btn btn-outline-success" id="audioMitlesenBtn">
                    <i class="bi bi-music-note-list me-1"></i>Mitlesen
                </button>
                <a id="audioDownloadLink" href="#" download class="btn btn-primary">
                    <i class="bi bi-download me-2"></i>Herunterladen
                </a>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Schließen</button>
            </div>
        </div>
    </div>
</div>

<!-- Sync Viewer Modal -->
<div class="modal fade" id="syncViewerModal" tabindex="-1" aria-labelledby="syncViewerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen-lg-down modal-xl">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h5 class="modal-title" id="syncViewerModalLabel">
                    <i class="bi bi-music-note-list text-success me-2"></i>
                    <span id="syncViewerTitle"></span>
                </h5>
                <div class="d-flex align-items-center gap-2 ms-3">
                    <button id="syncPrevPage" class="btn btn-sm btn-outline-secondary" title="Vorherige Seite">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    <span id="syncPageInfo" class="small text-muted" style="min-width:5rem;text-align:center">Seite 1 / ?</span>
                    <button id="syncNextPage" class="btn btn-sm btn-outline-secondary" title="Nächste Seite">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
                {% if is_granted('ROLE_ADMIN') %}
                <button id="syncEditToggle" class="btn btn-sm btn-outline-warning ms-2" title="Anker bearbeiten">
                    <i class="bi bi-pencil-square me-1"></i>Anker bearbeiten
                </button>
                {% endif %}
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0 d-flex flex-column" style="min-height:0;overflow:hidden">
                <!-- Score canvas area -->
                <div id="scoreCanvasWrapper" style="position:relative;flex:1 1 auto;overflow-y:auto;overflow-x:auto;background:#888;min-height:0">
                    <canvas id="scoreCanvas" style="display:block;margin:0 auto"></canvas>
                    <canvas id="cursorCanvas" style="position:absolute;top:0;left:50%;transform:translateX(-50%);pointer-events:none"></canvas>
                </div>
                <!-- Audio bar -->
                <div class="border-top p-2 bg-light flex-shrink-0">
                    <audio id="syncAudioPlayer" controls class="w-100" style="outline:none;height:2.5rem"></audio>
                    <div class="d-flex align-items-center gap-2 mt-1">
                        <small class="text-muted">Tempo:</small>
                        <button class="btn btn-xs btn-outline-secondary sync-speed-btn py-0 px-2" style="font-size:.75rem" data-speed="0.5">0.5×</button>
                        <button class="btn btn-xs btn-outline-secondary sync-speed-btn py-0 px-2" style="font-size:.75rem" data-speed="0.75">0.75×</button>
                        <button class="btn btn-xs btn-outline-primary   sync-speed-btn py-0 px-2" style="font-size:.75rem" data-speed="1">1×</button>
                        <button class="btn btn-xs btn-outline-secondary sync-speed-btn py-0 px-2" style="font-size:.75rem" data-speed="1.25">1.25×</button>
                    </div>
                </div>
                {% if is_granted('ROLE_ADMIN') %}
                <!-- Admin anchor editor (hidden by default) -->
                <div id="syncAnchorEditor" class="border-top p-3 bg-warning-subtle d-none flex-shrink-0" style="max-height:220px;overflow-y:auto">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <strong><i class="bi bi-pin-map me-1"></i>Anker (<span id="anchorCount">0</span>)</strong>
                        <div class="d-flex gap-2">
                            <button id="syncSaveAnchors" class="btn btn-sm btn-success">
                                <i class="bi bi-floppy me-1"></i>Speichern
                            </button>
                            <button id="syncDeleteAllAnchors" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash me-1"></i>Alle löschen
                            </button>
                        </div>
                    </div>
                    <p class="text-muted small mb-2">Klicke auf den Notentext, um einen Anker bei der aktuellen Audioposition zu setzen.</p>
                    <div id="anchorList" class="d-flex flex-wrap gap-1"></div>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<script>
window.PROBEN_CONFIG = {
    filesUrl:    '{{ path('api_dropbox_song_files') }}',
    linkUrl:     '{{ path('api_dropbox_link') }}',
    viewUrl:     '{{ path('api_dropbox_view') }}',
    syncUrl:     '{{ path('api_sync_anchors') }}',
    isAdmin:     {{ is_granted('ROLE_ADMIN') ? 'true' : 'false' }},
    syncCsrfToken: '{{ csrf_token('sync_anchors') }}'
};
</script>
<script src="{{ asset('js/member-proben.js') }}?v=2"></script>
<script src="{{ asset('js/score-sync.js') }}?v=1"></script>
{% if is_granted('ROLE_ADMIN') %}
<script>
/* Admin-only: toggle a song's "Aktuell in Proben" flag by clicking the badge
   (same endpoint as the Admin-Lieder page). The badge sits outside the accordion
   button, so a click here does not expand the panel. Green = in Aktuelle Proben. */
(function () {
    const token = '{{ csrf_token('song_patch') }}';
    document.addEventListener('click', function (e) {
        const badge = e.target.closest('.admin-proben-badge');
        if (!badge || badge.dataset.disabled || badge.dataset.busy) return;
        const id        = badge.dataset.songId;
        const newActive = badge.dataset.active !== '1';
        badge.dataset.busy = '1';
        badge.style.opacity = '.5';
        fetch('/admin/songs/' + id + '/patch-field', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ _token: token, field: 'isAktuelleProben', value: newActive ? '1' : '0' })
        })
        .then(function (r) { return r.json().then(function (j) {
            if (!r.ok || j.error) throw new Error(j.error || ('HTTP ' + r.status));
            return j;
        }); })
        .then(function () {
            badge.dataset.active = newActive ? '1' : '0';
            badge.classList.toggle('bg-success', newActive);
            badge.classList.toggle('bg-light', !newActive);
            badge.classList.toggle('text-secondary', !newActive);
            badge.classList.toggle('border', !newActive);
            badge.title = newActive
                ? 'In „Aktuelle Proben“ – klicken zum Entfernen'
                : 'Klicken, um zu „Aktuelle Proben“ hinzuzufügen';
        })
        .catch(function (err) { alert(err.message || 'Fehler beim Speichern'); })
        .finally(function () { delete badge.dataset.busy; badge.style.opacity = ''; });
    });

    /* Aktuelle-Proben page: × button removes the song from Aktuelle Proben and
       drops it from the list on success. */
    document.addEventListener('click', function (e) {
        const btn = e.target.closest('.admin-proben-remove');
        if (!btn || btn.dataset.busy) return;
        if (!confirm('Lied aus „Aktuelle Proben“ entfernen?')) return;
        btn.dataset.busy = '1';
        btn.disabled = true;
        fetch('/admin/songs/' + btn.dataset.songId + '/patch-field', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ _token: token, field: 'isAktuelleProben', value: '0' })
        })
        .then(function (r) { return r.json().then(function (j) {
            if (!r.ok || j.error) throw new Error(j.error || ('HTTP ' + r.status));
            return j;
        }); })
        .then(function () {
            const item = btn.closest('.accordion-item');
            if (item) {
                item.style.transition = 'opacity .3s';
                item.style.opacity = '0';
                setTimeout(function () { item.remove(); }, 300);
            }
        })
        .catch(function (err) {
            btn.disabled = false;
            delete btn.dataset.busy;
            alert(err.message || 'Fehler beim Speichern');
        });
    });

    /* Inline Etikett editing — same endpoint/field as the Admin-Lieder page. */
    const esc = window.escapeHtml || function (s) { return s; };
    function badgeHtml(value) {
        if (!value) return '<span class="badge bg-light text-muted border fw-normal">＋ Etikett</span>';
        const map = { blau: 'bg-primary text-white', gelb: 'bg-warning text-dark',
                      rosa: 'bg-danger-subtle text-danger-emphasis border border-danger-subtle',
                      extrabox: 'bg-secondary text-white' };
        const cls = map[value.split(' ')[0].toLowerCase()] || 'bg-light text-dark border';
        return '<span class="badge ' + cls + ' fw-normal">' + esc(value) + '</span>';
    }
    function deactivate(cell) {
        cell.querySelector('.display-val').classList.remove('d-none');
        cell.querySelector('.edit-input').classList.add('d-none');
    }
    async function commitEtikett(cell) {
        const inp = cell.querySelector('.edit-input');
        if (inp.classList.contains('d-none')) return;       // already closed
        const value = inp.value.trim();
        deactivate(cell);
        if (value === inp.dataset.original.trim()) return;  // no change
        try {
            const res = await fetch('/admin/songs/' + cell.dataset.songId + '/patch-field', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ _token: token, field: 'etikett', value: value })
            });
            const j = await res.json();
            if (!res.ok || j.error) throw new Error(j.error || ('HTTP ' + res.status));
            inp.dataset.original = value; inp.value = value;
            cell.querySelector('.display-val').innerHTML = badgeHtml(value);
            // Keep the Noten search filter (which reads data-etikett) in sync.
            const item = cell.closest('.accordion-item');
            if (item) item.dataset.etikett = value;
        } catch (err) {
            inp.value = inp.dataset.original;
            alert(err.message || 'Fehler beim Speichern');
        }
    }
    document.addEventListener('click', function (e) {
        const dv = e.target.closest('.editable-etikett .display-val');
        if (!dv) return;
        const cell = dv.closest('.editable-etikett');
        const inp = cell.querySelector('.edit-input');
        inp.dataset.original = inp.value;
        dv.classList.add('d-none');
        inp.classList.remove('d-none');
        inp.focus(); inp.select();
    });
    document.addEventListener('keydown', function (e) {
        if (!e.target.classList.contains('edit-input')) return;
        const cell = e.target.closest('.editable-etikett');
        if (!cell) return;
        if (e.key === 'Enter') { e.preventDefault(); commitEtikett(cell); }
        else if (e.key === 'Escape') { e.target.value = e.target.dataset.original; deactivate(cell); }
    });
    document.addEventListener('focusout', function (e) {
        if (!e.target.classList.contains('edit-input')) return;
        const cell = e.target.closest('.editable-etikett');
        if (cell) commitEtikett(cell);
    });
}());
</script>
{% endif %}
