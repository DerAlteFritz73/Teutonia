{% extends 'base.html.twig' %}

{% block title %}Kalender - {{ parent() }}{% endblock %}

{% block body %}
<!-- template: templates/member/kalender.html.twig -->
<div class="container py-5">
    <h1>Kalender</h1>
    <p class="lead">Alle kommenden Termine auf einen Blick.</p>

    {% if events|length > 0 %}
        <div class="list-group mt-4">
            {% for event in events %}
                <div class="list-group-item">
                    <div class="d-flex w-100 justify-content-between align-items-start">
                        <div>
                            <h5 class="mb-1">{{ event.title }}</h5>
                            {% if event.description %}
                                <p class="mb-1 text-muted">{{ event.description }}</p>
                            {% endif %}
                            {% if event.location %}
                                <small class="text-muted">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-geo-alt me-1" viewBox="0 0 16 16">
                                        <path d="M12.166 8.94c-.524 1.062-1.234 2.12-1.96 3.07A32 32 0 0 1 8 14.58a32 32 0 0 1-2.206-2.57c-.726-.95-1.436-2.008-1.96-3.07C3.304 7.867 3 6.862 3 6a5 5 0 0 1 10 0c0 .862-.305 1.867-.834 2.94M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10"/>
                                        <path d="M8 8a2 2 0 1 1 0-4 2 2 0 0 1 0 4m0 1a3 3 0 1 0 0-6 3 3 0 0 0 0 6"/>
                                    </svg>
                                    {{ event.location }}
                                </small>
                            {% endif %}
                        </div>
                        <div class="text-end">
                            <span class="badge bg-primary fs-6">
                                {{ event.date|date('d.m.Y') }}
                            </span>
                            <br>
                            <small class="text-muted">{{ event.date|date('H:i') }} Uhr</small>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="alert alert-info mt-4">
            Aktuell sind keine kommenden Termine eingetragen.
        </div>
    {% endif %}
</div>
{% endblock %}
