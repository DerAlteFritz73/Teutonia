{% extends 'base.html.twig' %}

{% block title %}{{ isNew ? 'Neuer Vorschlag' : 'Vorschlag bearbeiten' }} - {{ parent() }}{% endblock %}

{% block body %}
<!-- template: templates/member/ideenkiste_form.html.twig -->
<main id="main-content">
    <div class="container py-5">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
            <h1 class="mb-0">
                <i class="bi bi-lightbulb"></i>
                {{ isNew ? 'Neuer Song-Vorschlag' : 'Vorschlag bearbeiten' }}
            </h1>
            <div class="d-flex gap-2">
                <a href="{{ path('member_ideenkiste') }}" class="btn btn-secondary" data-unsaved-cancel>
                    <i class="bi bi-x-lg me-1"></i>Abbrechen
                </a>
                <button type="submit" form="suggestion-form" class="btn btn-primary">
                    <i class="bi bi-save me-1"></i>{{ isNew ? 'Vorschlag einreichen' : 'Änderungen speichern' }}
                </button>
            </div>
        </div>

        {# Flash Messages #}
        {% for message in app.flashes('success') %}
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}

        {{ form_start(form, {'attr': {'class': 'mt-4', 'id': 'suggestion-form', 'data-unsaved-check': ''}}) }}
            <div class="row">
                <div class="col-md-6 mb-3">
                    {{ form_row(form.title) }}
                </div>
                <div class="col-md-6 mb-3">
                    {{ form_row(form.artist) }}
                </div>
            </div>

            <div class="mb-3">
                {{ form_row(form.description) }}
            </div>

            <div class="mb-3">
                {{ form_row(form.pdfFile) }}
                {% if not isNew and suggestion.pdfPath %}
                    <small class="text-muted">
                        Aktuelle Datei: <a href="{{ asset(suggestion.pdfPath) }}" target="_blank">Noten ansehen</a>
                    </small>
                {% endif %}
            </div>

        {{ form_end(form) }}
    </div>
</main>
{% endblock %}
