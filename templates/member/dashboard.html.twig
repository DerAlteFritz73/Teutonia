{% extends 'base.html.twig' %}

{% block title %}Mitgliederbereich - {{ parent() }}{% endblock %}

{% block body %}
<!-- template: templates/member/dashboard.html.twig -->
<div class="container py-5">
    <h1>Willkommen im Mitgliederbereich</h1>
    <p class="lead">Hallo {% if app.user.username == 'teutonia' %}liebe Sängerin, lieber Sänger{% else %}{{ app.user.firstName }}{% endif %}!</p>

    <div class="row mt-4">
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-music-note-list me-2" viewBox="0 0 16 16">
                            <path d="M12 13c0 1.105-1.12 2-2.5 2S7 14.105 7 13s1.12-2 2.5-2 2.5.895 2.5 2"/>
                            <path fill-rule="evenodd" d="M12 3v10h-1V3z"/>
                            <path d="M11 2.82a1 1 0 0 1 .804-.98l3-.6A1 1 0 0 1 16 2.22V4l-5 1z"/>
                            <path fill-rule="evenodd" d="M0 11.5a.5.5 0 0 1 .5-.5H4a.5.5 0 0 1 0 1H.5a.5.5 0 0 1-.5-.5m0-4A.5.5 0 0 1 .5 7H8a.5.5 0 0 1 0 1H.5a.5.5 0 0 1-.5-.5m0-4A.5.5 0 0 1 .5 3H8a.5.5 0 0 1 0 1H.5a.5.5 0 0 1-.5-.5"/>
                        </svg>
                        Aktuelle Proben
                    </h5>
                    <p class="card-text">Hier findest du die aktuellen Noten und Übungsdateien für unsere Proben.</p>
                    <a href="{{ path('member_proben') }}" class="btn btn-primary">Zu den Proben</a>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-music-note-beamed me-2"></i>
                        Konzerte
                    </h5>
                    <p class="card-text">Alle Konzerte mit ihren Programmen – Lieder, Komponisten und Videos.</p>
                    <a href="{{ path('member_konzerte') }}" class="btn btn-primary">Zu den Konzerten</a>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-lightbulb me-2"></i>
                        Ideenkiste
                    </h5>
                    <p class="card-text">Schlage neue Songs für unser Repertoire vor und stimme über Vorschläge ab.</p>
                    <a href="{{ path('member_ideenkiste') }}" class="btn btn-primary">Zur Ideenkiste</a>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-archive me-2"></i>
                        Archiv
                    </h5>
                    <p class="card-text">Vergangene Veranstaltungen und Erinnerungen aus der Geschichte des Chors.</p>
                    <a href="{{ path('member_archiv') }}" class="btn btn-primary">Zum Archiv</a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
