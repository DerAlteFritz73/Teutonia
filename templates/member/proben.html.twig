{% extends 'base.html.twig' %}

{% macro etikett_badge(etikett) %}
    {% if etikett %}
        {% set prefix = etikett|split(' ')|first|lower %}
        {% set class = {
            'blau':     'bg-primary text-white',
            'gelb':     'bg-warning text-dark',
            'rosa':     'bg-danger-subtle text-danger-emphasis border border-danger-subtle',
            'extrabox': 'bg-secondary text-white'
        }[prefix] ?? 'bg-light text-dark border' %}
        <span class="badge {{ class }} fw-normal">{{ etikett }}</span>
    {% endif %}
{% endmacro %}

{% block title %}Aktuelle Proben - {{ parent() }}{% endblock %}

{% block body %}
<!-- template: templates/member/proben.html.twig -->
<main id="main-content" data-turbo-cache="false">
    <div class="container py-5" id="page-container">
        <h1 id="page-title">Aktuelle Proben</h1>
        <p class="lead" id="page-lead">Hier findest du alle Noten und Übungsdateien für die aktuellen Proben.</p>

        {# Aktuelle Proben Section #}
        {% if aktuelleProben is not empty %}
        <section class="mb-5">
            <div class="accordion" id="probenAccordion">
                {% for song in aktuelleProben %}
                    {% set folderId = 'proben-' ~ loop.index %}
                    {% set hasMovements = song.children|length > 0 %}
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed accordion-btn-files"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#{{ folderId }}"
                                    aria-expanded="false"
                                    {% set probenPath = song.aktuelleDropboxlink ?? song.dropboxlink %}
                    {% if probenPath %}data-dropbox-path="{{ probenPath }}"{% endif %}>
                                <i class="bi bi-folder2-open me-2"></i>
                                <span class="d-flex flex-column lh-sm flex-grow-1">
                                    {{ song.songName }}
                                    {% if song.composer %}
                                        <small class="text-muted fw-normal">{{ song.composer }}</small>
                                    {% endif %}
                                </span>
                                <span class="ps-3 me-3 d-flex align-items-center gap-2 flex-shrink-0">
                                    {% for style in song.styles %}
                                        {% if style.image %}
                                            <img src="{{ asset('images/styles/' ~ style.image) }}" alt="{{ style.name }}" title="{{ style.name }}" class="d-sm-none rounded" style="height:2.2rem;width:2.2rem;object-fit:contain;">
                                        {% endif %}
                                        <span class="badge rounded-pill fw-normal text-white {% if style.image %}d-none d-sm-inline{% endif %}" style="background:{{ style.color ?? 'rgba(0,0,0,.25)' }};font-size:.75rem">{{ style.name }}</span>
                                    {% endfor %}
                                    {% if hasMovements %}
                                        <span class="badge bg-secondary fw-normal">{{ song.children|length }} Sätze</span>
                                    {% endif %}
                                    <span class="d-flex gap-1 file-count-badges"></span>
                                </span>
                            </button>
                        </h2>
                        <div id="{{ folderId }}" class="accordion-collapse collapse"
                             data-bs-parent="#probenAccordion">
                            <div class="accordion-body">
                                {% if song.links|length > 0 %}
                                    <div class="d-flex flex-wrap gap-2 mb-3">
                                        {% for link in song.links %}
                                            {% set isYoutube = 'youtube.com' in link.url or 'youtu.be' in link.url %}
                                            <a href="{{ link.url }}" target="_blank" rel="noopener noreferrer"
                                               class="btn btn-sm btn-outline-secondary">
                                                {% if isYoutube %}
                                                    <i class="bi bi-youtube text-danger me-1"></i>
                                                {% else %}
                                                    <i class="bi bi-link-45deg me-1"></i>
                                                {% endif %}
                                                {{ link.label ?? link.url }}
                                            </a>
                                        {% endfor %}
                                        {% if is_granted('ROLE_ADMIN') %}
                                            <a href="{{ path('admin_songs_links_edit', {id: song.id}) }}"
                                               class="btn btn-sm btn-outline-warning" title="Links bearbeiten">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        {% endif %}
                                    </div>
                                {% endif %}
                                {% if probenPath %}
                                    <div class="list-group song-files-container mb-3" data-dropbox-path="{{ probenPath }}"{% if hasMovements %} data-has-movements="true"{% endif %}>
                                        <div class="text-center text-muted py-3 file-loading-spinner">
                                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                            Lade Dateien…
                                        </div>
                                    </div>
                                {% endif %}
                                {% if hasMovements %}
                                    <div class="accordion" id="{{ folderId }}-movements">
                                        {% for movement in song.children %}
                                            {% set movId = folderId ~ '-mov-' ~ loop.index %}
                                            <div class="accordion-item border-start border-3 border-primary">
                                                <h2 class="accordion-header">
                                                    <button class="accordion-button collapsed accordion-btn-files py-2"
                                                            type="button"
                                                            data-bs-toggle="collapse"
                                                            data-bs-target="#{{ movId }}"
                                                            {% if movement.dropboxlink %}data-dropbox-path="{{ movement.dropboxlink }}"{% endif %}>
                                                        <i class="bi bi-music-note me-2 text-primary"></i>
                                                        {{ movement.songName }}
                                                        <span class="ps-3 me-3 d-flex align-items-center gap-2 flex-shrink-0">
                                                            <span class="d-flex gap-1 file-count-badges"></span>
                                                        </span>
                                                    </button>
                                                </h2>
                                                <div id="{{ movId }}" class="accordion-collapse collapse">
                                                    <div class="accordion-body py-2">
                                                        {% if movement.dropboxlink %}
                                                            <div class="list-group song-files-container" data-dropbox-path="{{ movement.dropboxlink }}">
                                                                <div class="text-center text-muted py-3 file-loading-spinner">
                                                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                                                    Lade Dateien…
                                                                </div>
                                                            </div>
                                                        {% else %}
                                                            <p class="text-muted mb-0 small"><i class="bi bi-info-circle me-1"></i>Keine Dateien verfügbar.</p>
                                                        {% endif %}
                                                    </div>
                                                </div>
                                            </div>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </section>
        {% else %}
        <div class="alert alert-info mt-4">
            <i class="bi bi-info-circle me-2"></i>
            Aktuell sind keine Übungsmaterialien verfügbar.
        </div>
        {% endif %}

        {# All Scores Section #}
        {% if notenSongs is not empty %}
        <section class="mt-5">
            <h2 class="mb-4">
                <i class="bi bi-folder-fill me-2"></i>
                Noten und Aufnahmen
            </h2>
            <p class="text-muted mb-4">
                <i class="bi bi-info-circle me-1"></i>
                Hier findet Ihr unsere Noten (PDF) und Aufnahmen (MP3).
            </p>

            <input type="search" id="notenSearch" class="form-control form-control-sm mb-3"
                   placeholder="Lied suchen…" autocomplete="off" style="max-width:500px;">
            <div id="notenNoResults" class="text-muted d-none">Kein Lied gefunden.</div>

            <div class="accordion" id="allFilesAccordion">
                {% for song in notenSongs %}
                    {% set allFolderId = 'noten-' ~ loop.index %}
                    {% set notenPath = song.dropboxlink ?? song.aktuelleDropboxlink %}
                    {% set hasDropbox = notenPath is not null and notenPath != '' %}
                    {% set hasMovements = song.children|length > 0 %}
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed accordion-btn-files"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#{{ allFolderId }}"
                                    aria-expanded="false"
                                    {% if hasDropbox %}data-dropbox-path="{{ notenPath }}"{% endif %}>
                                {% if hasDropbox or hasMovements %}
                                    <i class="bi bi-folder2-open me-2 text-warning"></i>
                                {% else %}
                                    <i class="bi bi-music-note me-2 text-secondary"></i>
                                {% endif %}
                                <span class="d-flex flex-column lh-sm flex-grow-1">
                                    {{ song.songName }}
                                    {% if song.composer %}
                                        <small class="text-muted fw-normal">{{ song.composer }}</small>
                                    {% endif %}
                                </span>
                                <span class="ps-3 me-3 d-flex align-items-center gap-2 flex-shrink-0">
                                    {% for style in song.styles %}
                                        {% if style.image %}
                                            <img src="{{ asset('images/styles/' ~ style.image) }}" alt="{{ style.name }}" title="{{ style.name }}" class="d-sm-none rounded" style="height:2.2rem;width:2.2rem;object-fit:contain;">
                                        {% endif %}
                                        <span class="badge rounded-pill fw-normal text-white {% if style.image %}d-none d-sm-inline{% endif %}" style="background:{{ style.color ?? 'rgba(0,0,0,.25)' }};font-size:.75rem">{{ style.name }}</span>
                                    {% endfor %}
                                    {{ _self.etikett_badge(song.etikett) }}
                                    {% if hasMovements %}
                                        <span class="badge bg-secondary fw-normal">{{ song.children|length }} Sätze</span>
                                    {% endif %}
                                    <span class="d-flex gap-1 file-count-badges"></span>
                                </span>
                            </button>
                        </h2>
                        <div id="{{ allFolderId }}" class="accordion-collapse collapse"
                             data-bs-parent="#allFilesAccordion">
                            <div class="accordion-body">
                                {# Song metadata row #}
                                <div class="d-flex flex-wrap gap-3 mb-3 text-muted small">
                                    {% if song.composer %}
                                        <span><i class="bi bi-person me-1"></i>{{ song.composer }}</span>
                                    {% endif %}
                                    {% if song.etikett %}
                                        <span><i class="bi bi-hash me-1"></i>{{ song.etikett }}</span>
                                    {% endif %}
                                    {% if song.latestKonzertDate %}
                                        <span><i class="bi bi-calendar-event me-1"></i>Letzte Aufführung: {{ song.latestKonzertDate|date('M Y') }}</span>
                                    {% endif %}
                                </div>
                                {% if song.links|length > 0 %}
                                    <div class="d-flex flex-wrap gap-2 mb-3">
                                        {% for link in song.links %}
                                            {% set isYoutube = 'youtube.com' in link.url or 'youtu.be' in link.url %}
                                            <a href="{{ link.url }}" target="_blank" rel="noopener noreferrer"
                                               class="btn btn-sm btn-outline-secondary">
                                                {% if isYoutube %}
                                                    <i class="bi bi-youtube text-danger me-1"></i>
                                                {% else %}
                                                    <i class="bi bi-link-45deg me-1"></i>
                                                {% endif %}
                                                {{ link.label ?? link.url }}
                                            </a>
                                        {% endfor %}
                                        {% if is_granted('ROLE_ADMIN') %}
                                            <a href="{{ path('admin_songs_links_edit', {id: song.id}) }}"
                                               class="btn btn-sm btn-outline-warning" title="Links bearbeiten">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        {% endif %}
                                    </div>
                                {% endif %}
                                {# Parent-level files (if any) #}
                                {% if hasDropbox %}
                                    <div class="list-group song-files-container {% if hasMovements %}mb-3{% endif %}" data-dropbox-path="{{ notenPath }}"{% if hasMovements %} data-has-movements="true"{% endif %}>
                                        <div class="text-center text-muted py-3 file-loading-spinner">
                                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                            Lade Dateien…
                                        </div>
                                    </div>
                                {% elseif not hasMovements %}
                                    <p class="text-muted mb-0">
                                        <i class="bi bi-info-circle me-1"></i>Keine Dateien in Dropbox verfügbar.
                                    </p>
                                {% endif %}
                                {# Movements (Sätze) #}
                                {% if hasMovements %}
                                    <div class="accordion" id="{{ allFolderId }}-movements">
                                        {% for movement in song.children %}
                                            {% set movId = allFolderId ~ '-mov-' ~ loop.index %}
                                            {% set movHasDropbox = movement.dropboxlink is not null and movement.dropboxlink != '' %}
                                            <div class="accordion-item border-start border-3 border-primary">
                                                <h2 class="accordion-header">
                                                    <button class="accordion-button collapsed accordion-btn-files py-2"
                                                            type="button"
                                                            data-bs-toggle="collapse"
                                                            data-bs-target="#{{ movId }}"
                                                            {% if movHasDropbox %}data-dropbox-path="{{ movement.dropboxlink }}"{% endif %}>
                                                        <i class="bi bi-music-note me-2 text-primary"></i>
                                                        {{ movement.songName }}
                                                        <span class="ps-3 me-3 d-flex align-items-center gap-2 flex-shrink-0">
                                                            <span class="d-flex gap-1 file-count-badges"></span>
                                                        </span>
                                                    </button>
                                                </h2>
                                                <div id="{{ movId }}" class="accordion-collapse collapse">
                                                    <div class="accordion-body py-2">
                                                        {% if movHasDropbox %}
                                                            <div class="list-group song-files-container" data-dropbox-path="{{ movement.dropboxlink }}">
                                                                <div class="text-center text-muted py-3 file-loading-spinner">
                                                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                                                    Lade Dateien…
                                                                </div>
                                                            </div>
                                                        {% else %}
                                                            <p class="text-muted mb-0 small"><i class="bi bi-info-circle me-1"></i>Keine Dateien verfügbar.</p>
                                                        {% endif %}
                                                    </div>
                                                </div>
                                            </div>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </section>
        {% endif %}
    </div>
</main>

<!-- PDF Viewer Modal -->
<div class="modal fade" id="pdfViewerModal" tabindex="-1" aria-labelledby="pdfViewerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-fullscreen-lg-down">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="pdfViewerModalLabel">
                    <i class="bi bi-file-pdf-fill text-danger me-2"></i>
                    <span id="pdfFileName"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0" style="height: 80vh;">
                <iframe id="pdfViewerFrame" style="width: 100%; height: 100%; border: none;"></iframe>
            </div>
            <div class="modal-footer">
                <a id="pdfDownloadLink" href="#" download class="btn btn-primary">
                    <i class="bi bi-download me-2"></i>Herunterladen
                </a>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Schließen</button>
            </div>
        </div>
    </div>
</div>

<!-- Audio Player Modal -->
<div class="modal fade" id="audioPlayerModal" tabindex="-1" aria-labelledby="audioPlayerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="audioPlayerModalLabel">
                    <i class="bi bi-music-note-beamed text-primary me-2"></i>
                    <span id="audioFileName"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <audio id="audioPlayer" controls class="w-100 mb-4" style="outline: none;">
                    Ihr Browser unterstützt das Audio-Element nicht.
                </audio>

                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title mb-3">
                            <i class="bi bi-speedometer2 me-2"></i>Wiedergabegeschwindigkeit
                        </h6>
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <label for="speedSlider" class="form-label mb-0" style="min-width: 60px;">
                                <span id="speedValue">1.0</span>x
                            </label>
                            <input type="range" class="form-range flex-grow-1" id="speedSlider"
                                   min="0.25" max="2.0" step="0.05" value="1.0">
                        </div>
                        <div class="d-flex gap-2 flex-wrap">
                            <button class="btn btn-sm btn-outline-secondary speed-preset" data-speed="0.5">0.5x</button>
                            <button class="btn btn-sm btn-outline-secondary speed-preset" data-speed="0.75">0.75x</button>
                            <button class="btn btn-sm btn-outline-primary speed-preset" data-speed="1">1.0x</button>
                            <button class="btn btn-sm btn-outline-secondary speed-preset" data-speed="1.25">1.25x</button>
                            <button class="btn btn-sm btn-outline-secondary speed-preset" data-speed="1.5">1.5x</button>
                            <button class="btn btn-sm btn-outline-secondary speed-preset" data-speed="2">2.0x</button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success" id="audioPlayBtn">
                    <i class="bi bi-play-fill me-1"></i>Abspielen
                </button>
                <a id="audioDownloadLink" href="#" download class="btn btn-primary">
                    <i class="bi bi-download me-2"></i>Herunterladen
                </a>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Schließen</button>
            </div>
        </div>
    </div>
</div>

<script>
window.PROBEN_CONFIG = {
    filesUrl: '{{ path('api_dropbox_song_files') }}',
    linkUrl:  '{{ path('api_dropbox_link') }}',
    viewUrl:  '{{ path('api_dropbox_view') }}'
};
</script>
<script src="{{ asset('js/member-proben.js') }}"></script>
{% endblock %}
