{% extends 'base.html.twig' %}

{% block title %}Aktuelle Proben - {{ parent() }}{% endblock %}

{% block body %}
<div class="container py-5">
    <h1>Aktuelle Proben</h1>
    <p class="lead">Hier findest du alle Noten und Übungsdateien für die aktuellen Proben.</p>

    {% if songGroups|length > 0 %}
        <div class="accordion mt-4" id="songsAccordion">
            {% for song, links in songGroups %}
                {% set songId = 'song-' ~ loop.index %}
                {% set pdfLinks = links|filter(link => link.isPdf) %}
                {% set mp3Links = links|filter(link => link.isMp3) %}
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button {% if not loop.first %}collapsed{% endif %}" type="button" data-bs-toggle="collapse" data-bs-target="#{{ songId }}">
                            <strong>{{ song }}</strong>
                            <span class="badge bg-secondary ms-2">{{ links|length }} Dateien</span>
                        </button>
                    </h2>
                    <div id="{{ songId }}" class="accordion-collapse collapse {% if loop.first %}show{% endif %}" data-bs-parent="#songsAccordion">
                        <div class="accordion-body">
                            <div class="row">
                                {% if pdfLinks|length > 0 %}
                                <div class="col-md-4 mb-3">
                                    <h6 class="text-muted">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-file-earmark-pdf me-1" viewBox="0 0 16 16">
                                            <path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2M9.5 3A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h5.5z"/>
                                            <path d="M4.603 14.087a.8.8 0 0 1-.438-.42c-.195-.388-.13-.776.08-1.102.198-.307.526-.568.897-.787a7.7 7.7 0 0 1 1.482-.645 20 20 0 0 0 1.062-2.227 7.3 7.3 0 0 1-.43-1.295c-.086-.4-.119-.796-.046-1.136.075-.354.274-.672.65-.823.192-.077.4-.12.602-.077a.7.7 0 0 1 .477.365c.088.164.12.356.127.538.007.188-.012.396-.047.614-.084.51-.27 1.134-.52 1.794a11 11 0 0 0 .98 1.686 5.8 5.8 0 0 1 1.334.05c.364.066.734.195.96.465.12.144.193.32.2.518.007.192-.047.382-.138.563a1.04 1.04 0 0 1-.354.416.86.86 0 0 1-.51.138c-.331-.014-.654-.196-.933-.417a5.7 5.7 0 0 1-.911-.95 11.7 11.7 0 0 0-1.997.406 11.3 11.3 0 0 1-1.02 1.51c-.292.35-.609.656-.927.787a.8.8 0 0 1-.58.029z"/>
                                        </svg>
                                        Noten
                                    </h6>
                                    {% for link in pdfLinks %}
                                        <a href="{{ link.url }}" target="_blank" class="btn btn-outline-danger btn-sm mb-1 w-100">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-file-pdf me-1" viewBox="0 0 16 16">
                                                <path d="M4 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2zm0 1h8a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1"/>
                                            </svg>
                                            PDF öffnen
                                        </a>
                                    {% endfor %}
                                </div>
                                {% endif %}
                                {% if mp3Links|length > 0 %}
                                <div class="col-md-8">
                                    <h6 class="text-muted">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-music-note-list me-1" viewBox="0 0 16 16">
                                            <path d="M12 13c0 1.105-1.12 2-2.5 2S7 14.105 7 13s1.12-2 2.5-2 2.5.895 2.5 2"/>
                                            <path fill-rule="evenodd" d="M12 3v10h-1V3z"/>
                                            <path d="M11 2.82a1 1 0 0 1 .804-.98l3-.6A1 1 0 0 1 16 2.22V4l-5 1z"/>
                                            <path fill-rule="evenodd" d="M0 11.5a.5.5 0 0 1 .5-.5H4a.5.5 0 0 1 0 1H.5a.5.5 0 0 1-.5-.5m0-4A.5.5 0 0 1 .5 7H8a.5.5 0 0 1 0 1H.5a.5.5 0 0 1-.5-.5m0-4A.5.5 0 0 1 .5 3H8a.5.5 0 0 1 0 1H.5a.5.5 0 0 1-.5-.5"/>
                                        </svg>
                                        Übungsdateien
                                    </h6>
                                    <div class="d-flex flex-wrap gap-2">
                                        {% for link in mp3Links %}
                                            {% set voiceClass = 'secondary' %}
                                            {% set voiceLabel = link.title %}
                                            {% if link.voicePart == 'sopran' %}
                                                {% set voiceClass = 'primary' %}
                                                {% set voiceLabel = 'Sopran' %}
                                            {% elseif link.voicePart == 'alt' %}
                                                {% set voiceClass = 'success' %}
                                                {% set voiceLabel = 'Alt' %}
                                            {% elseif link.voicePart == 'tenor' %}
                                                {% set voiceClass = 'warning' %}
                                                {% set voiceLabel = 'Tenor' %}
                                            {% elseif link.voicePart == 'bass' %}
                                                {% set voiceClass = 'dark' %}
                                                {% set voiceLabel = 'Bass' %}
                                            {% endif %}
                                            <a href="{{ link.url }}" target="_blank" class="btn btn-{{ voiceClass }} btn-sm">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-play-fill me-1" viewBox="0 0 16 16">
                                                    <path d="m11.596 8.697-6.363 3.692c-.54.313-1.233-.066-1.233-.697V4.308c0-.63.692-1.01 1.233-.696l6.363 3.692a.802.802 0 0 1 0 1.393"/>
                                                </svg>
                                                {{ voiceLabel }}
                                            </a>
                                        {% endfor %}
                                    </div>
                                </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="alert alert-info mt-4">
            Aktuell sind keine Übungsmaterialien verfügbar.
        </div>
    {% endif %}
</div>
{% endblock %}
