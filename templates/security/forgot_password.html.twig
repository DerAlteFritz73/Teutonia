{% extends 'base.html.twig' %}

{% block title %}Passwort vergessen - {{ parent() }}{% endblock %}

{% block body %}
<!-- template: templates/security/forgot_password.html.twig -->
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow">
                <div class="card-header bg-dark text-white">
                    <h4 class="mb-0">Passwort vergessen</h4>
                </div>
                <div class="card-body">
                    {% if no_email %}
                        <div class="alert alert-warning">
                            Für dieses Konto ist keine E-Mail-Adresse hinterlegt. Ein Passwort-Reset ist daher nicht möglich. Bitte wende dich an einen Administrator.
                        </div>
                        <a href="{{ path('app_login') }}" class="btn btn-primary w-100">Zurück zum Login</a>
                    {% elseif success %}
                        <div class="alert alert-success">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-envelope-check me-2" viewBox="0 0 16 16">
                                <path d="M2 2a2 2 0 0 0-2 2v8.01A2 2 0 0 0 2 14h5.5a.5.5 0 0 0 0-1H2a1 1 0 0 1-.966-.741l5.64-3.471L8 9.583l7-4.2V8.5a.5.5 0 0 0 1 0V4a2 2 0 0 0-2-2zm3.708 6.208L1 11.105V5.383zM1 4.217V4a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v.217l-7 4.2z"/>
                                <path d="M16 12.5a3.5 3.5 0 1 1-7 0 3.5 3.5 0 0 1 7 0m-1.993-1.679a.5.5 0 0 0-.686.172l-1.17 1.95-.547-.547a.5.5 0 0 0-.708.708l.774.773a.75.75 0 0 0 1.174-.144l1.335-2.226a.5.5 0 0 0-.172-.686"/>
                            </svg>
                            <strong>E-Mail versendet!</strong>
                        </div>
                        <p class="text-muted">
                            Falls ein Konto mit diesen Daten existiert und eine E-Mail-Adresse hinterlegt ist,
                            haben wir Ihnen einen Link zum Zurücksetzen des Passworts gesendet.
                        </p>
                        <p class="text-muted small">
                            Bitte prüfen Sie auch Ihren Spam-Ordner. Der Link ist 1 Stunde gültig.
                        </p>

                        <a href="{{ path('app_login') }}" class="btn btn-primary w-100">Zurück zum Login</a>
                    {% else %}
                        {% if error %}
                            <div class="alert alert-danger">{{ error }}</div>
                        {% endif %}

                        <p class="text-muted mb-4">
                            Geben Sie Ihren Benutzernamen oder Ihre E-Mail-Adresse ein, um einen Link zum Zurücksetzen des Passworts zu erhalten.
                        </p>

                        <form method="post">
                            <div class="mb-3">
                                <label for="identifier" class="form-label">Benutzername oder E-Mail</label>
                                <input type="text" name="identifier" id="identifier"
                                       class="form-control" required autofocus
                                       placeholder="Benutzername oder E-Mail">
                            </div>

                            <button type="submit" class="btn btn-primary w-100 mb-3">
                                Link anfordern
                            </button>

                            <div class="text-center">
                                <a href="{{ path('app_login') }}" class="text-muted">Zurück zum Login</a>
                            </div>
                        </form>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
