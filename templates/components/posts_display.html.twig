{# This template displays posts with proper layout handling #}
<div id="posts-container">
{% if posts is defined and posts is not empty %}
    {% set currentLayout = null %}
    {% set sideCount = 0 %}

    {% for post in posts %}
        {% if post.layout == 'side_by_side' %}
            {# Handle side by side layout #}
            {% if currentLayout != 'side_by_side' or sideCount == 0 %}
                {% if currentLayout == 'side_by_side' and sideCount == 1 %}
                    </div> {# Close the previous unclosed col-md-6 #}
                {% endif %}
                {% if sideCount > 0 %}
                    </div> {# Close previous row #}
                {% endif %}
                <div class="row mt-2" id="post-row-{{ loop.index }}">
                {% set sideCount = 0 %}
            {% endif %}

            <div class="col-md-6 mb-2" id="post-{{ post.id }}-container">
                <h3{% if post.fontTitle or post.fontTitleSize or post.fontTitleBold or post.fontTitleItalic or post.fontTitleUnderline %} style="{% if post.fontTitle and post.fontTitle != 'default' %}font-family: {{ post.fontTitle }};{% endif %}{% if post.fontTitleSize %} font-size: {{ post.fontTitleSize }}px;{% endif %}{% if post.fontTitleBold %} font-weight: bold;{% endif %}{% if post.fontTitleItalic %} font-style: italic;{% endif %}{% if post.fontTitleUnderline %} text-decoration: underline;{% endif %}"{% endif %}>{{ post.title }}</h3>
                {% if post.subtitle %}
                    <h5 class="text-muted"{% if post.fontSubtitle or post.fontSubtitleSize or post.fontSubtitleBold or post.fontSubtitleItalic or post.fontSubtitleUnderline %} style="{% if post.fontSubtitle and post.fontSubtitle != 'default' %}font-family: {{ post.fontSubtitle }};{% endif %}{% if post.fontSubtitleSize %} font-size: {{ post.fontSubtitleSize }}px;{% endif %}{% if post.fontSubtitleBold %} font-weight: bold;{% endif %}{% if post.fontSubtitleItalic %} font-style: italic;{% endif %}{% if post.fontSubtitleUnderline %} text-decoration: underline;{% endif %}"{% endif %}>{{ post.subtitle }}</h5>
                {% endif %}
                {% if post.imagePath %}
                    <div class="mt-3">
                        <img src="{{ asset(post.imagePath) }}" alt="{{ post.title }}" class="img-fluid rounded" style="max-width: 100%; height: auto; object-fit: contain;{% if post.imageRotation %} transform: rotate({{ post.imageRotation }}deg);{% endif %}">
                    </div>
                {% endif %}
                {% if post.paragraph %}
                    <div class="mt-3"{% if post.fontParagraph or post.fontParagraphSize or post.fontParagraphBold or post.fontParagraphItalic or post.fontParagraphUnderline %} style="{% if post.fontParagraph and post.fontParagraph != 'default' %}font-family: {{ post.fontParagraph }};{% endif %}{% if post.fontParagraphSize %} font-size: {{ post.fontParagraphSize }}px;{% endif %}{% if post.fontParagraphBold %} font-weight: bold;{% endif %}{% if post.fontParagraphItalic %} font-style: italic;{% endif %}{% if post.fontParagraphUnderline %} text-decoration: underline;{% endif %}"{% endif %}>{{ post.paragraph|raw }}</div>
                {% endif %}
            </div>

            {% set currentLayout = 'side_by_side' %}
            {% set sideCount = sideCount + 1 %}

            {% if sideCount == 2 %}
                </div> {# Close row after 2 items #}
                {% set sideCount = 0 %}
            {% endif %}

        {% else %}
            {# Handle single row layout #}
            {% if currentLayout == 'side_by_side' %}
                {% if sideCount == 1 %}
                    </div> {# Close unclosed col-md-6 #}
                {% endif %}
                </div> {# Close row #}
                {% set sideCount = 0 %}
            {% endif %}

            <div class="row mt-2" id="post-row-{{ loop.index }}">
                <div class="col-12 mb-2" id="post-{{ post.id }}-container">
                    <h3{% if post.fontTitle or post.fontTitleSize or post.fontTitleBold or post.fontTitleItalic or post.fontTitleUnderline %} style="{% if post.fontTitle and post.fontTitle != 'default' %}font-family: {{ post.fontTitle }};{% endif %}{% if post.fontTitleSize %} font-size: {{ post.fontTitleSize }}px;{% endif %}{% if post.fontTitleBold %} font-weight: bold;{% endif %}{% if post.fontTitleItalic %} font-style: italic;{% endif %}{% if post.fontTitleUnderline %} text-decoration: underline;{% endif %}"{% endif %}>{{ post.title }}</h3>
                    {% if post.subtitle %}
                        <h5 class="text-muted"{% if post.fontSubtitle or post.fontSubtitleSize or post.fontSubtitleBold or post.fontSubtitleItalic or post.fontSubtitleUnderline %} style="{% if post.fontSubtitle and post.fontSubtitle != 'default' %}font-family: {{ post.fontSubtitle }};{% endif %}{% if post.fontSubtitleSize %} font-size: {{ post.fontSubtitleSize }}px;{% endif %}{% if post.fontSubtitleBold %} font-weight: bold;{% endif %}{% if post.fontSubtitleItalic %} font-style: italic;{% endif %}{% if post.fontSubtitleUnderline %} text-decoration: underline;{% endif %}"{% endif %}>{{ post.subtitle }}</h5>
                    {% endif %}
                    {% if post.imagePath %}
                        <div class="mt-3">
                            <img src="{{ asset(post.imagePath) }}" alt="{{ post.title }}" class="img-fluid rounded" style="max-width: 100%; height: auto; object-fit: contain;{% if post.imageRotation %} transform: rotate({{ post.imageRotation }}deg);{% endif %}">
                        </div>
                    {% endif %}
                    {% if post.paragraph %}
                        <div class="mt-3"{% if post.fontParagraph or post.fontParagraphSize or post.fontParagraphBold or post.fontParagraphItalic or post.fontParagraphUnderline %} style="{% if post.fontParagraph and post.fontParagraph != 'default' %}font-family: {{ post.fontParagraph }};{% endif %}{% if post.fontParagraphSize %} font-size: {{ post.fontParagraphSize }}px;{% endif %}{% if post.fontParagraphBold %} font-weight: bold;{% endif %}{% if post.fontParagraphItalic %} font-style: italic;{% endif %}{% if post.fontParagraphUnderline %} text-decoration: underline;{% endif %}"{% endif %}>{{ post.paragraph|raw }}</div>
                    {% endif %}
                </div>
            </div>

            {% set currentLayout = 'single_row' %}
        {% endif %}
    {% endfor %}

    {# Close any open row at the end #}
    {% if currentLayout == 'side_by_side' %}
        {% if sideCount == 1 %}
            </div> {# Close unclosed col-md-6 #}
        {% endif %}
        </div> {# Close row #}
    {% endif %}
{% endif %}
</div> {# Close posts-container #}
