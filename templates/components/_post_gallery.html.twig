{# Renders a post's gallery photos (PostImage collection) as a Swiper carousel
   with the active slide highlighted. Usage:
   {% include 'components/_post_gallery.html.twig' with {'images': post.images} %}

   Nav buttons are siblings of .post-gallery-swiper (not children rendered
   inside it, as Swiper's default markup does) so they occupy their own space
   in the surrounding flex row instead of being absolutely positioned over the
   slide content -- see post-gallery.js and the .post-gallery-wrap CSS in
   base.html.twig. #}
{% if images is defined and images|length > 0 %}
    <div class="post-gallery-wrap mt-3">
        {% if images|length > 1 %}
            <button type="button" class="post-gallery-nav post-gallery-prev" aria-label="Vorheriges Foto"><i class="bi bi-chevron-left"></i></button>
        {% endif %}
        <div class="swiper post-gallery-swiper">
            <div class="swiper-wrapper">
                {% for galleryImage in images %}
                    <div class="swiper-slide">
                        <img src="{{ asset(galleryImage.imagePath) }}" alt=""{% if galleryImage.rotation %} style="transform: rotate({{ galleryImage.rotation }}deg);"{% endif %}>
                    </div>
                {% endfor %}
            </div>
            {% if images|length > 1 %}
                <div class="swiper-pagination"></div>
            {% endif %}
        </div>
        {% if images|length > 1 %}
            <button type="button" class="post-gallery-nav post-gallery-next" aria-label="Nächstes Foto"><i class="bi bi-chevron-right"></i></button>
        {% endif %}
    </div>
{% endif %}
