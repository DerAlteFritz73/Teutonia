{% extends 'base.html.twig' %}

{% block title %}Startseite - Chorgemeinschaft Teutonia Willstätt{% endblock %}

{% block body %}
<!-- template: templates/home/index.html.twig -->
<main>
    <div class="container">
        <div class="site-hero mt-3 text-center">
            <h1 class="display-5 mb-2">Chorgemeinschaft Teutonia Willstätt e.&nbsp;V.</h1>
            <p class="lead mb-0">Gemeinsam singen, seit Generationen &ndash; herzlich willkommen!</p>
        </div>

        <div class="row mt-4">
            <div class="col-md-8">
                <img src="{{ asset('images/chor Joël.jpeg') }}" alt="Chor" class="img-fluid rounded mb-4">
                <p>Die Chorgemeinschaft Teutonia Willstätt e.V. ist ein traditionsreicher Chor mit einer langen Geschichte. Wir sind stolz, eine vielfältige Gemeinschaft von Sängerinnen und Sängern zu sein.</p>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Schnelllinks</h5>
                        <ul class="list-unstyled">
                            <li><a href="{{ path('page_chor') }}">Unser Chor</a></li>
                            <li><a href="{{ path('page_concerts') }}">Konzerte und Aktivitäten</a></li>
                            <li><a href="{{ path('page_events') }}">Unsere nächsten Termine</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>
{% endblock %}
