{% extends 'base.html.twig' %}

{% block title %}{{ isNew ? 'Neuer Link' : 'Link bearbeiten' }} - {{ parent() }}{% endblock %}

{% block body %}
<div class="container py-5">
    <h1>{{ isNew ? 'Neuer Link' : 'Link bearbeiten' }}</h1>

    {{ form_start(form) }}
        <div class="mb-3">
            {{ form_row(form.title) }}
        </div>
        <div class="mb-3">
            {{ form_row(form.url) }}
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                {{ form_row(form.type) }}
            </div>
            <div class="col-md-6 mb-3">
                {{ form_row(form.sortOrder) }}
            </div>
        </div>
        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Speichern</button>
            <a href="{{ path('admin_links') }}" class="btn btn-secondary">Abbrechen</a>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
