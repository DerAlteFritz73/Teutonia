{% extends 'base.html.twig' %}

{% block title %}Konzerte verwalten - {{ parent() }}{% endblock %}

{% block body %}
<!-- template: templates/admin/konzerte/index.html.twig -->
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Konzerte <span class="badge bg-secondary fs-6">{{ konzerte|length }}</span></h1>
        <div class="d-flex gap-2">
            {% if showAdminActions is defined and showAdminActions %}
            <a href="{{ path('admin_konzerte_new') }}" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i>Neues Konzert
            </a>
            <a href="{{ path('admin_dashboard') }}" class="btn btn-secondary">
                <i class="bi bi-arrow-left me-1"></i>Zurück
            </a>
            {% endif %}
        </div>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show">{{ message }}<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show">{{ message }}<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    {% endfor %}

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th style="width:60px"></th>
                    <th>Datum</th>
                    <th>Name</th>
                    <th>Ort</th>
                    <th style="width:80px">Lieder</th>
                    <th style="width:60px" title="Programm aussen">Progr. A</th>
                    <th style="width:60px" title="Programm innen">Progr. I</th>
                    <th style="width:60px" title="Kritik / Pressespiegel">Kritik</th>
                    {% if showAdminActions is defined and showAdminActions %}<th class="text-end" style="width:120px">Aktionen</th>{% endif %}
                </tr>
            </thead>
            <tbody>
                {% for konzert in konzerte %}

                <tr class="konzert-row{% if loop.index is even %} krow-even{% endif %}"
                    data-bs-toggle="collapse"
                    data-bs-target="#songs-{{ konzert.id }}"
                    aria-expanded="false"
                    aria-controls="songs-{{ konzert.id }}">
                    <td class="p-1" style="width:60px" onclick="event.stopPropagation()">
                        {% if konzert.plakatPath %}
                            <img src="{{ asset(konzert.plakatPath) }}"
                                 alt="Plakat"
                                 data-plakat-src="{{ asset(konzert.plakatPath) }}"
                                 data-plakat-title="{{ konzert.name }}"
                                 class="plakat-thumb-sm"
                                 style="width:52px;height:52px;object-fit:cover;border-radius:4px;display:block;cursor:zoom-in;">
                        {% else %}
                            <div style="width:52px;height:52px;background:#e9ecef;border-radius:4px;display:flex;align-items:center;justify-content:center;">
                                <i class="bi bi-image text-muted" style="font-size:1.2rem"></i>
                            </div>
                        {% endif %}
                    </td>
                    <td class="text-nowrap fw-semibold">{{ konzert.date|date('d.m.Y') }}</td>
                    <td>
                        {{ konzert.name }}
                    </td>
                    <td class="text-muted">{{ konzert.location ?? '—' }}</td>
                    <td>
                        <span class="badge bg-secondary">{{ konzert.songs|length + konzert.customSongs|length }}</span>
                    </td>
                    <td class="p-1" style="width:60px" onclick="event.stopPropagation()">
                        {% if konzert.programmVorderseite %}
                            <img src="{{ asset(konzert.programmVorderseite) }}"
                                 alt="Programm aussen"
                                 data-plakat-src="{{ asset(konzert.programmVorderseite) }}"
                                 data-plakat-title="{{ konzert.name }} – Programm aussen"
                                 class="plakat-thumb-sm"
                                 style="width:52px;height:52px;object-fit:cover;border-radius:4px;display:block;cursor:zoom-in;">
                        {% else %}
                            <div style="width:52px;height:52px;background:#e9ecef;border-radius:4px;display:flex;align-items:center;justify-content:center;">
                                <i class="bi bi-file-earmark text-muted" style="font-size:1.2rem"></i>
                            </div>
                        {% endif %}
                    </td>
                    <td class="p-1" style="width:60px" onclick="event.stopPropagation()">
                        {% if konzert.programmRueckseite %}
                            <img src="{{ asset(konzert.programmRueckseite) }}"
                                 alt="Programm innen"
                                 data-plakat-src="{{ asset(konzert.programmRueckseite) }}"
                                 data-plakat-title="{{ konzert.name }} – Programm innen"
                                 class="plakat-thumb-sm"
                                 style="width:52px;height:52px;object-fit:cover;border-radius:4px;display:block;cursor:zoom-in;">
                        {% else %}
                            <div style="width:52px;height:52px;background:#e9ecef;border-radius:4px;display:flex;align-items:center;justify-content:center;">
                                <i class="bi bi-file-earmark text-muted" style="font-size:1.2rem"></i>
                            </div>
                        {% endif %}
                    </td>
                    <td class="p-1" style="width:60px" onclick="event.stopPropagation()">
                        {% if konzert.kritikPath %}
                            <img src="{{ asset(konzert.kritikPath) }}"
                                 alt="Kritik"
                                 data-plakat-src="{{ asset(konzert.kritikPath) }}"
                                 data-plakat-title="{{ konzert.name }} – Kritik"
                                 class="plakat-thumb-sm"
                                 style="width:52px;height:52px;object-fit:cover;border-radius:4px;display:block;cursor:zoom-in;">
                        {% else %}
                            <div style="width:52px;height:52px;background:#e9ecef;border-radius:4px;display:flex;align-items:center;justify-content:center;">
                                <i class="bi bi-newspaper text-muted" style="font-size:1.2rem"></i>
                            </div>
                        {% endif %}
                    </td>
                    {% if showAdminActions is defined and showAdminActions %}
                    <td class="text-end" onclick="event.stopPropagation()">
                        <a href="{{ path('admin_konzerte_edit', {id: konzert.id}) }}"
                           class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                        <form action="{{ path('admin_konzerte_delete', {id: konzert.id}) }}" method="post"
                              class="d-inline" onsubmit="return confirm('Konzert wirklich löschen?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_konzert' ~ konzert.id) }}">
                            <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                    {% endif %}
                </tr>

                <tr class="konzert-detail">
                    <td colspan="{{ showAdminActions is defined and showAdminActions ? 9 : 8 }}" class="p-0 border-0">
                        <div id="songs-{{ konzert.id }}" class="collapse">
                            {% if konzert.introduction %}
                            <div class="px-4 py-3 border-bottom bg-light">
                                <div class="text-muted" style="font-size: 0.95rem; line-height: 1.5;">{{ konzert.introduction }}</div>
                            </div>
                            {% endif %}
                            <div class="px-4 py-2 border-bottom bg-light">
                                {% set items = konzert.orderedSongList %}
                                {% if items is empty %}
                                    <em class="text-muted small">Keine Lieder verknüpft.</em>
                                {% else %}
                                    <div class="ksl-wrap">
                                        <div class="ksl-header">
                                            <span class="ksl-num">#</span>
                                            <span class="ksl-composer">Komponist</span>
                                            <span class="ksl-title">Liedtitel</span>
                                            <span class="ksl-video"></span>
                                        </div>
                                        {% for item in items %}
                                        <div class="ksl-row{% if item.type == 'custom' %} ksl-custom{% endif %}">
                                            <span class="ksl-num text-muted">{{ loop.index }}</span>
                                            <span class="ksl-composer">{{ item.composer ?: '—' }}</span>
                                            <span class="ksl-title{% if item.type == 'custom' %} fst-italic{% endif %}">
                                                {{ item.title }}{% if item.note is defined and item.note %}<span class="text-muted fst-italic ms-1" style="font-size:.8em">({{ item.note }})</span>{% endif %}
                                            </span>
                                            <span class="ksl-video">
                                                {% if item.videoLink %}
                                                    <a href="{{ item.videoLink }}" target="_blank" rel="noopener"
                                                       class="btn btn-xs btn-outline-danger py-0 px-1" title="Video ansehen"
                                                       onclick="event.stopPropagation()">
                                                        <i class="bi bi-play-fill"></i>
                                                    </a>
                                                {% endif %}
                                            </span>
                                        </div>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </td>
                </tr>

                {% else %}
                <tr>
                    <td colspan="{{ showAdminActions is defined and showAdminActions ? 9 : 8 }}" class="text-center text-muted py-4">Noch keine Konzerte erfasst.</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="plakatModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-transparent border-0 shadow-none">
            <div class="modal-body p-0 text-center position-relative">
                <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-2" data-bs-dismiss="modal"></button>
                <img id="plakatModalImg" src="" alt="" class="img-fluid rounded zoomable-img" style="max-height:90vh">
                <div id="plakatModalTitle" class="text-white mt-2 fw-semibold"></div>
            </div>
        </div>
    </div>
</div>

<style>
#plakatModal .modal-dialog { max-width: min(90vw, 900px); }
.konzert-row td            { background-color: #fff; }
.konzert-row.krow-even td { background-color: #f8f9fa; }
.konzert-row { cursor: pointer; }
.konzert-chevron { transition: transform .2s ease; font-size: .75rem; }
.konzert-row[aria-expanded="true"] .konzert-chevron { transform: rotate(90deg); }
.konzert-detail:hover td { background-color: inherit !important; }

/* Song list inside accordion — mirrors the edit-page right-list */
.ksl-wrap { font-size: .8125rem; }
.ksl-header {
    display: flex; align-items: center;
    background: #f8f9fa; border-bottom: 1px solid #dee2e6;
    padding: 3px 8px;
    font-size: .7rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: .06em; color: #6c757d;
}
.ksl-row {
    display: flex; align-items: center;
    padding: 4px 8px; border-bottom: 1px solid #f2f2f2;
}
.ksl-row:last-child { border-bottom: none; }
.ksl-row:hover { background: #eef2ff; }
.ksl-custom { background: #fffbf0; }
.ksl-custom:hover { background: #fff3cd; }
.ksl-num     { width: 24px; min-width: 24px; color: #adb5bd; text-align: right; padding-right: 8px; }
.ksl-composer { width: 35%; min-width: 35%; max-width: 35%; color: #6c757d; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding-right: 10px; }
.ksl-title   { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ksl-video   { width: 32px; min-width: 32px; text-align: center; }
</style>

<script>
(function () {
    const modal    = new bootstrap.Modal(document.getElementById('plakatModal'));
    const modalImg = document.getElementById('plakatModalImg');
    const modalTtl = document.getElementById('plakatModalTitle');

    document.querySelectorAll('.plakat-thumb-sm').forEach(img => {
        img.addEventListener('click', () => {
            modalImg.src         = img.dataset.plakatSrc;
            modalImg.alt         = img.dataset.plakatTitle;
            modalTtl.textContent = img.dataset.plakatTitle;
            modal.show();
        });
    });
}());
</script>
{% endblock %}
