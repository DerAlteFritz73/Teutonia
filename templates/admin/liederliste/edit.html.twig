{% extends 'base.html.twig' %}

{% block title %}{{ isNew ? 'Neue Liederliste' : liste.name }} - {{ parent() }}{% endblock %}

{% block body %}
<!-- template: templates/admin/liederliste/edit.html.twig -->
{% set canEdit = is_granted('ROLE_ADMIN') %}
<div class="container-fluid py-4" style="max-width:1200px">

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show">{{ message }}<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show">{{ message }}<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    {% endfor %}

    <form id="liste-form" method="post" action="{{ isNew ? path('admin_liederlisten_new') : path('admin_liederlisten_edit', {id: liste.id}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('liederliste') }}">
        <input type="hidden" name="items_json" id="items-json-input" value="">

        <div class="d-flex justify-content-between align-items-start mb-4">
            <div class="d-flex flex-column gap-2 flex-grow-1">
                <input type="text" name="liste_name" id="liste-name"
                       class="form-control form-control-lg fw-semibold"
                       style="max-width:420px"
                       placeholder="Name der Liederliste"
                       value="{{ liste.name }}"
                       {{ canEdit ? 'required' : 'readonly' }}>
                <input type="text" name="liste_title" id="liste-title"
                       class="form-control"
                       style="max-width:420px"
                       placeholder="Titel (erscheint im Word-Dokument)"
                       value="{{ liste.title ?? '' }}"
                       {{ canEdit ? '' : 'readonly' }}>
                <div class="form-check">
                    <input type="checkbox" name="show_etikett" id="show-etikett"
                           class="form-check-input"
                           {{ liste.isShowEtikett() ? 'checked' : '' }}
                           {{ canEdit ? '' : 'disabled' }}>
                    <label class="form-check-label small" for="show-etikett">Etikett-Spalte in Export anzeigen</label>
                </div>
            </div>
            <div class="d-flex gap-2 ms-3 mt-1">
                <a href="{{ path('admin_liederlisten') }}" class="btn btn-secondary">
                    <i class="bi bi-x-lg me-1"></i>Abbrechen
                </a>
                {% if not isNew %}
                <a href="{{ path('admin_liederlisten_download', {id: liste.id}) }}"
                   class="btn btn-outline-success" title="Word herunterladen (.docx)">
                    <i class="bi bi-file-earmark-word me-1"></i>Word
                </a>
                <a href="{{ path('admin_liederlisten_download_odt', {id: liste.id}) }}"
                   class="btn btn-outline-success" title="LibreOffice herunterladen (.odt)">
                    <i class="bi bi-file-earmark-text me-1"></i>ODT
                </a>
                <a href="{{ path('admin_liederlisten_download_pdf', {id: liste.id}) }}"
                   class="btn btn-outline-danger" target="_blank" title="PDF öffnen (.pdf)">
                    <i class="bi bi-file-earmark-pdf me-1"></i>PDF
                </a>
                {% endif %}
                {% if canEdit and not isNew %}
                <button type="submit" form="add-proben-form" class="btn btn-info"
                        title="Alle Lieder dieser Liste zu „Aktuelle Proben" hinzufügen"
                        onclick="return confirm('Alle Lieder dieser Liste zu „Aktuelle Proben“ hinzufügen?')">
                    <i class="bi bi-collection-play me-1"></i>Zu aktuellen Proben hinzufügen
                </button>
                {% endif %}
                {% if canEdit %}
                <button type="submit" class="btn btn-primary" id="save-btn">
                    <i class="bi bi-check-lg me-1"></i>{{ isNew ? 'Erstellen' : 'Speichern' }}
                </button>
                {% endif %}
            </div>
        </div>

        {# ── Dual-list song picker ──────────────────────────────────────────── #}
        <div class="d-flex flex-column flex-md-row gap-2 align-items-md-stretch">

            {# Left — available songs (hidden for read-only NOTENWART users) #}
            <div class="flex-grow-1{{ canEdit ? '' : ' d-none' }}" style="min-width:0">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="fw-semibold text-muted">Alle Lieder</span>
                    <span class="badge bg-secondary" id="left-count">0</span>
                </div>
                <input type="search" id="left-search" class="form-control form-control-sm mb-1"
                       placeholder="Filtern…" autocomplete="off">
                <div class="ll-list-wrap">
                    <div class="ll-list-header">
                        <span class="llh-title">Titel</span>
                        <span class="llh-composer">Komponist</span>
                    </div>
                    <div class="ll-list" id="left-list"></div>
                </div>
            </div>

            {# Middle — action buttons (hidden for read-only NOTENWART users) #}
            <div class="d-flex flex-row flex-md-column justify-content-center gap-2 px-2 flex-shrink-0{{ canEdit ? '' : ' d-none' }}">
                <button type="button" id="btn-add" class="btn btn-primary btn-sm" title="Zur Liste hinzufügen">
                    <i class="bi bi-chevron-right d-none d-md-inline"></i>
                    <i class="bi bi-chevron-down d-inline d-md-none"></i>
                </button>
                <button type="button" id="btn-remove" class="btn btn-outline-secondary btn-sm" title="Aus Liste entfernen">
                    <i class="bi bi-chevron-left d-none d-md-inline"></i>
                    <i class="bi bi-chevron-up d-inline d-md-none"></i>
                </button>
            </div>

            {# Right — songs in the list (drag-to-reorder) #}
            <div class="flex-grow-1" style="min-width:0">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="fw-semibold text-primary">In der Liste</span>
                    <span class="badge bg-primary" id="right-count">0</span>
                </div>
                <input type="search" id="right-search" class="form-control form-control-sm mb-1"
                       placeholder="Filtern…" autocomplete="off">
                <div class="ll-list-wrap">
                    <div class="ll-list-header">
                        <span class="llh-handle"></span>
                        <span class="llh-title">Titel</span>
                        <span class="llh-composer">Komponist</span>
                        <span class="llh-note">Anmerkung</span>
                        <span class="llh-etikett">Etikett</span>
                        <span class="llh-dur">Dauer</span>
                        <span class="llh-del"></span>
                    </div>
                    <div class="ll-list" id="right-list"></div>
                </div>

                {# Add free entry (hidden for read-only NOTENWART users) #}
                <div id="custom-add-panel" class="custom-add-panel mt-2 p-2 border rounded{{ canEdit ? '' : ' d-none' }}" style="background:#fffbf0">
                    <div class="small fw-semibold text-warning-emphasis mb-1 custom-add-label">
                        <i class="bi bi-plus-circle me-1" id="custom-add-icon"></i>
                        <span id="custom-add-title">Freies Stück hinzufügen</span>
                    </div>
                    <div class="d-flex gap-1">
                        <input type="text" id="custom-title-input" class="form-control form-control-sm"
                               placeholder="Titel *" style="flex:0 0 50%">
                        <input type="text" id="custom-composer" class="form-control form-control-sm"
                               placeholder="Komponist (optional)">
                        <input type="text" id="custom-dur-input" class="form-control form-control-sm"
                               placeholder="Dauer" style="flex:0 0 70px">
                        <button type="button" id="btn-add-custom" class="btn btn-sm btn-warning text-nowrap">
                            <i class="bi bi-plus-lg"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        {% if canEdit %}
        <p class="text-muted small mt-2">
            Klick / <kbd>Strg</kbd>+Klick / <kbd>Shift</kbd>+Klick zum Auswählen &middot;
            Doppelklick zum schnellen Verschieben &middot;
            Rechte Liste: Drag &amp; Drop zum Umsortieren
        </p>
        {% else %}
        <p class="text-muted small mt-2">
            <i class="bi bi-eye me-1"></i>Nur-Lese-Ansicht – die Liste kann nicht verändert werden.
        </p>
        {% endif %}
    </form>

    {% if canEdit and not isNew %}
    {# Standalone form so the toolbar button (associated via form="add-proben-form")
       does not nest inside the main edit form. #}
    <form id="add-proben-form" method="post"
          action="{{ path('admin_liederlisten_add_to_proben', {id: liste.id}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('add_to_proben' ~ liste.id) }}">
    </form>
    {% endif %}
</div>

<style>
.ll-list-wrap {
    border: 1px solid #dee2e6;
    border-radius: .375rem;
    overflow: hidden;
}
.ll-list-header {
    display: flex; align-items: center;
    background: #f8f9fa; border-bottom: 1px solid #dee2e6;
    padding: 4px 8px;
    font-size: .7rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: .06em;
    color: #6c757d; user-select: none;
}
.ll-list { height: 420px; overflow-y: auto; }

.ll-row {
    display: flex; align-items: center;
    padding: 5px 8px; cursor: pointer;
    user-select: none; border-bottom: 1px solid #f2f2f2;
    transition: background .08s;
}
.ll-row:last-child       { border-bottom: none; }
.ll-row:hover            { background: #eef2ff; }
.ll-row.selected         { background: #0d6efd; color: #fff; }
.ll-row.selected .llc-composer { color: rgba(255,255,255,.75); }
.ll-row.selected .llc-handle   { color: rgba(255,255,255,.6); }
.ll-row.selected .llc-dur input { color: #fff; background: rgba(255,255,255,.15); border-color: rgba(255,255,255,.3); }

.ll-row.custom-item           { background: #fffbf0; }
.ll-row.custom-item:hover     { background: #fff3cd; }
.ll-row.custom-item.selected  { background: #e0a800; color: #000; }
.ll-row.movement-item         { background: #f5f7ff; }
.ll-row.movement-item:hover   { background: #e8ecff; }
.ll-row.movement-item.selected { background: #0d6efd; color: #fff; }
.movement-indent              { color: #6c757d; margin-right: 2px; font-size: .85rem; }
.ll-row.selected .movement-indent { color: rgba(255,255,255,.7); }

.ll-row.dragging    { opacity: .35; }
.ll-row.drop-before { box-shadow: 0 -2px 0 0 #0d6efd; }
.ll-row.drop-after  { box-shadow: 0  2px 0 0 #0d6efd; }

.llh-handle  { flex: 0 0 20px; }
.llh-title   { flex: 1; }
.llh-composer { flex: 0 0 15%; text-align: left; }
.ll-list-wrap.show-etikett .llh-composer {
    flex: 0 0 10%;
}
.llh-note    { flex: 0 0 110px; min-width: 0; }
.llh-etikett { flex: 0 0 90px; min-width: 0; }
.llh-dur     { flex: 0 0 80px; min-width: 0; text-align: center; }
.llh-del     { width: 56px; min-width: 56px; }

.llc-handle {
    flex: 0 0 20px;
    text-align: center; color: #adb5bd; font-size: .8rem;
    cursor: grab;
}
.llc-handle:active { cursor: grabbing; }
.llc-title {
    flex: 1; font-size: .8125rem;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.llc-composer {
    flex: 0 0 15%;
    font-size: .8125rem; color: #6c757d;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    padding-right: 8px;
}
.ll-list-wrap.show-etikett .llc-composer {
    flex: 0 0 10%;
}
.llc-note {
    flex: 0 0 110px; min-width: 0;
    margin: 0 4px;
}
.llc-note input {
    font-size: .75rem; padding: 1px 4px; height: 24px; width: 100%;
}
.llc-dur {
    flex: 0 0 80px; min-width: 0;
    display: flex; align-items: center; gap: 3px;
    margin: 0 4px;
}
.llc-dur input {
    font-size: .75rem; padding: 1px 4px; height: 24px;
    flex: 1; min-width: 0;
}
.dur-spinner {
    flex-shrink: 0;
    display: flex; align-items: center;
    color: #6c757d;
}

.llc-etikett {
    flex: 0 0 90px; min-width: 0;
    font-size: .75rem; color: #6c757d;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    padding: 0 4px;
}
.llc-del {
    width: 56px; min-width: 56px;
    text-align: center; display: flex; align-items: center;
    justify-content: center; gap: 4px;
}
.btn-del-item, .btn-edit-item {
    background: none; border: none; padding: 0;
    color: #adb5bd; line-height: 1; cursor: pointer; font-size: .85rem;
}
.btn-del-item:hover  { color: #dc3545; }
.btn-edit-item:hover { color: #0d6efd; }

.custom-add-panel.editing { background: #e8f4ff; border-color: #86b7fe; }
.custom-add-panel.editing .custom-add-label { color: #0d6efd; }
</style>

<script>
window.ALL_SONGS    = {{ songData|json_encode|raw }};
window.SAVED_ITEMS  = {{ liste.items|json_encode|raw }};
window.FETCH_URL    = '{{ path('admin_liederlisten_fetch_duration') }}';
</script>
<script>
(function () {
    // Read-only mode for NOTENWART users: the right list is displayed but no
    // editing affordances (add/remove/reorder/custom/inputs) are wired up.
    const READ_ONLY = {{ canEdit ? 'false' : 'true' }};

    // ── Data ──────────────────────────────────────────────────────────────
    const allSongs = window.ALL_SONGS || [];  // [{id, parentId, composer, title, hasDropbox, hasLinks}]
    const songById = new Map(allSongs.map(s => [s.id, s]));

    // parentId -> [child song, …] (movements), in catalog order
    const childrenById = new Map();
    allSongs.forEach(s => {
        if (s.parentId != null) {
            if (!childrenById.has(s.parentId)) childrenById.set(s.parentId, []);
            childrenById.get(s.parentId).push(s);
        }
    });

    // left list: static catalog — never mutated (enables duplicate adds)
    let leftSongs  = allSongs.slice();

    // right list items: [{type:'song'|'custom', songId?, composer, title, duration, uid}]
    let rightItems = [];
    let uidCounter = 0;

    function freshUid() { return 'u' + (uidCounter++); }

    // Restore saved items (left list stays static — catalog never mutated)
    (window.SAVED_ITEMS || []).forEach(item => {
        if (item.type === 'song' && item.songId) {
            const song = leftSongs.find(s => s.id === item.songId);
            if (song) {
                rightItems.push({ type: 'song', songId: item.songId, composer: item.composer, title: item.title, duration: item.duration || '', note: item.note || '', uid: freshUid() });
            }
        } else if (item.type === 'custom') {
            rightItems.push({ type: 'custom', composer: item.composer || '', title: item.title || '', duration: item.duration || '', note: item.note || '', uid: freshUid() });
        }
    });

    // ── DOM refs ───────────────────────────────────────────────────────────
    const leftListEl    = document.getElementById('left-list');
    const rightListEl   = document.getElementById('right-list');
    const leftSearchEl  = document.getElementById('left-search');
    const rightSearchEl = document.getElementById('right-search');
    const leftCountEl   = document.getElementById('left-count');
    const rightCountEl  = document.getElementById('right-count');

    // ── Helpers ────────────────────────────────────────────────────────────
    function escHtml(s) {
        return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    // ── Row factories ──────────────────────────────────────────────────────
    function makeLeftRow(song, rightCount, isMovement) {
        const row = document.createElement('div');
        row.className = 'll-row' + (isMovement ? ' movement-item' : '');
        row.dataset.id = song.id;

        const t = document.createElement('span');
        t.className = 'llc-title';
        if (isMovement) {
            const indent = document.createElement('span');
            indent.className = 'movement-indent';
            indent.textContent = '↳ ';
            t.appendChild(indent);
        }
        t.appendChild(document.createTextNode(song.title));
        if (rightCount > 0) {
            const badge = document.createElement('span');
            badge.className = 'badge bg-primary rounded-pill ms-1';
            badge.style.fontSize = '.6rem';
            badge.textContent = rightCount + '×';
            t.appendChild(badge);
        }

        const c = document.createElement('span');
        c.className = 'llc-composer';
        c.textContent = song.composer || '—';

        row.appendChild(t);
        row.appendChild(c);
        return row;
    }

    function makeRightRow(item) {
        const isCustom = item.type === 'custom';
        const row = document.createElement('div');
        row.className = 'll-row' + (isCustom ? ' custom-item' : '');
        row.dataset.uid = item.uid;
        if (!READ_ONLY) row.setAttribute('draggable', 'true');

        // Handle
        const h = document.createElement('span');
        h.className = 'llc-handle';
        h.innerHTML = '<i class="bi bi-grip-vertical"></i>';
        row.appendChild(h);

        // Title
        const t = document.createElement('span');
        t.className = 'llc-title';
        if (isCustom) {
            t.innerHTML = '<em>' + escHtml(item.title) + '</em>';
        } else {
            t.textContent = item.title;
        }
        row.appendChild(t);

        // Composer
        const c = document.createElement('span');
        c.className = 'llc-composer';
        c.textContent = item.composer || '—';
        row.appendChild(c);

        // Note
        const nWrap = document.createElement('span');
        nWrap.className = 'llc-note';
        const nInput = document.createElement('input');
        nInput.type = 'text';
        nInput.className = 'form-control form-control-sm';
        nInput.placeholder = 'Anmerkung…';
        nInput.value = item.note || '';
        nInput.readOnly = READ_ONLY;
        nInput.addEventListener('click', e => e.stopPropagation());
        nInput.addEventListener('mousedown', e => e.stopPropagation());
        nInput.addEventListener('input', () => { item.note = nInput.value; });
        nWrap.appendChild(nInput);
        row.appendChild(nWrap);

        // Etikett
        const etWrap = document.createElement('span');
        etWrap.className = 'llc-etikett';
        if (!isCustom && item.songId != null) {
            const song = songById.get(item.songId);
            etWrap.textContent = song?.etikett || '';
        }
        row.appendChild(etWrap);

        // Duration
        const durWrap = document.createElement('span');
        durWrap.className = 'llc-dur';
        const durInput = document.createElement('input');
        durInput.type = 'text';
        durInput.className = 'form-control form-control-sm';
        durInput.placeholder = '0:00';
        durInput.value = item.duration || '';
        durInput.readOnly = READ_ONLY;
        durInput.addEventListener('click', e => e.stopPropagation());
        durInput.addEventListener('mousedown', e => e.stopPropagation());
        durInput.addEventListener('input', () => { item.duration = durInput.value.trim(); });
        durWrap.appendChild(durInput);

        const spinner = document.createElement('span');
        spinner.className = 'dur-spinner d-none';
        spinner.innerHTML = '<span class="spinner-border" style="width:.65rem;height:.65rem;border-width:2px"></span>';
        durWrap.appendChild(spinner);

        row.appendChild(durWrap);

        // Delete (and edit for custom) — omitted entirely in read-only mode.
        const del = document.createElement('span');
        del.className = 'llc-del';

        if (!READ_ONLY) {
            if (isCustom) {
                const editBtn = document.createElement('button');
                editBtn.type = 'button';
                editBtn.className = 'btn-edit-item';
                editBtn.title = 'Bearbeiten';
                editBtn.innerHTML = '<i class="bi bi-pencil"></i>';
                editBtn.addEventListener('click', e => { e.stopPropagation(); enterEditMode(item); });
                del.appendChild(editBtn);
            }

            const delBtn = document.createElement('button');
            delBtn.type = 'button';
            delBtn.className = 'btn-del-item';
            delBtn.title = 'Entfernen';
            delBtn.innerHTML = '<i class="bi bi-x-lg"></i>';
            delBtn.addEventListener('click', e => {
                e.stopPropagation();
                const idx = rightItems.findIndex(x => x.uid === item.uid);
                if (idx !== -1) rightItems.splice(idx, 1);
                if (editingUid === item.uid) exitEditMode();
                render();
            });
            del.appendChild(delBtn);
        }

        row.appendChild(del);
        return row;
    }

    // ── Render ─────────────────────────────────────────────────────────────
    function render() {
        const lTerms = leftSearchEl.value.toLowerCase().split(/\s+/).filter(Boolean);
        const rTerms = rightSearchEl.value.toLowerCase().split(/\s+/).filter(Boolean);
        const matchL = s => lTerms.every(t => (s.title + ' ' + s.composer).toLowerCase().includes(t));
        const matchR = s => rTerms.every(t => (s.title + ' ' + s.composer).toLowerCase().includes(t));

        const lSel = new Set(Array.from(leftListEl.querySelectorAll('.ll-row.selected')).map(r => +r.dataset.id));
        const rSel = new Set(Array.from(rightListEl.querySelectorAll('.ll-row.selected')).map(r => r.dataset.uid));

        // Count how many times each song appears in the right list
        const rightCounts = new Map();
        rightItems.forEach(item => {
            if (item.type === 'song' && item.songId != null) {
                rightCounts.set(item.songId, (rightCounts.get(item.songId) || 0) + 1);
            }
        });
        const hasDuplicates = [...rightCounts.values()].some(n => n > 1);

        leftListEl.innerHTML  = '';
        rightListEl.innerHTML = '';

        // Grouped left list: top-level songs first, movements indented under their parent.
        const childrenOf = new Map();   // parentId -> [song]
        leftSongs.forEach(s => {
            if (s.parentId != null) {
                if (!childrenOf.has(s.parentId)) childrenOf.set(s.parentId, []);
                childrenOf.get(s.parentId).push(s);
            }
        });
        const rendered = new Set();

        const appendLeftRow = (s, isMovement) => {
            const row = makeLeftRow(s, rightCounts.get(s.id) || 0, isMovement);
            if (lSel.has(s.id)) row.classList.add('selected');
            leftListEl.appendChild(row);
            rendered.add(s.id);
        };

        // Pass 1: top-level songs (no parent), each followed by its movements.
        leftSongs.forEach(s => {
            if (s.parentId != null) return;          // movement — handled under its parent
            const kids     = childrenOf.get(s.id) || [];
            const ownMatch = !lTerms.length || matchL(s);
            const kidMatch = kids.some(c => !lTerms.length || matchL(c));
            if (!ownMatch && !kidMatch) return;
            appendLeftRow(s, false);
            kids.forEach(c => {
                // When the parent itself matches, show ALL its movements (they
                // belong to it even if their own title/composer doesn't match).
                // Only filter movements when the parent matched via a child.
                if (lTerms.length && !ownMatch && !matchL(c)) return;
                appendLeftRow(c, true);
            });
        });

        // Pass 2: orphaned movements whose parent isn't in the catalog.
        leftSongs.forEach(s => {
            if (rendered.has(s.id) || s.parentId == null) return;
            if (lTerms.length && !matchL(s)) return;
            appendLeftRow(s, true);
        });

        rightItems.forEach(item => {
            if (rTerms.length && !matchR(item)) return;
            const row = makeRightRow(item);
            if (rSel.has(item.uid)) row.classList.add('selected');
            rightListEl.appendChild(row);
        });

        // Show/hide Etikett column based on checkbox
        const showEtikett = document.getElementById('show-etikett')?.checked;
        document.querySelector('.llh-etikett').style.display = showEtikett ? '' : 'none';
        rightListEl.querySelectorAll('.llc-etikett').forEach(c => c.style.display = showEtikett ? '' : 'none');

        // Adjust composer width when etikett is visible
        const listWrap = rightListEl.closest('.ll-list-wrap');
        if (listWrap) {
            listWrap.classList.toggle('show-etikett', showEtikett);
        }

        // Show note column only when at least one song is duplicated
        const noteHeader = document.querySelector('.llh-note');
        if (noteHeader) noteHeader.style.display = hasDuplicates ? '' : 'none';
        rightListEl.querySelectorAll('[data-uid]').forEach(row => {
            const uid  = row.dataset.uid;
            const item = rightItems.find(x => x.uid === uid);
            const cell = row.querySelector('.llc-note');
            if (cell && item) {
                const isDup = item.type === 'song' && (rightCounts.get(item.songId) || 0) > 1;
                cell.style.visibility = isDup ? '' : 'hidden';
                const inp = cell.querySelector('input');
                if (inp) inp.tabIndex = isDup ? 0 : -1;
            }
        });

        leftCountEl.textContent  = leftSongs.length;
        rightCountEl.textContent = rightItems.length;
    }

    // ── Selection ──────────────────────────────────────────────────────────
    let lastLeft = null, lastRight = null;

    function handleClick(listEl, e) {
        const row = e.target.closest('.ll-row');
        if (!row || e.target.closest('.btn-del-item, .btn-edit-item')) return;

        const rows    = Array.from(listEl.querySelectorAll('.ll-row'));
        const lastSel = listEl === leftListEl ? lastLeft : lastRight;

        if (e.ctrlKey || e.metaKey) {
            row.classList.toggle('selected');
        } else if (e.shiftKey && lastSel && listEl.contains(lastSel)) {
            const a = rows.indexOf(lastSel), b = rows.indexOf(row);
            const [lo, hi] = [Math.min(a, b), Math.max(a, b)];
            rows.forEach((r, i) => r.classList.toggle('selected', i >= lo && i <= hi));
        } else {
            rows.forEach(r => r.classList.remove('selected'));
            row.classList.add('selected');
        }

        if (listEl === leftListEl) lastLeft = row; else lastRight = row;
    }

    leftListEl.addEventListener('click',  e => handleClick(leftListEl,  e));
    rightListEl.addEventListener('click', e => handleClick(rightListEl, e));

    // ── Auto-fetch duration when a song is added ───────────────────────────
    function fetchDuration(item) {
        const song = item.songId ? songById.get(item.songId) : null;
        if (!song || (!song.hasDropbox && !song.hasLinks)) return;

        function getRow() { return rightListEl.querySelector('[data-uid="' + item.uid + '"]'); }

        const row = getRow();
        if (row) {
            const sp = row.querySelector('.dur-spinner');
            if (sp) sp.classList.remove('d-none');
        }

        fetch(window.FETCH_URL + '?songId=' + song.id)
            .then(r => r.json())
            .then(data => {
                if (!data.duration) return;
                item.duration = data.duration;
                const r = getRow();
                if (r) {
                    const inp = r.querySelector('.llc-dur input');
                    if (inp && !inp.value) inp.value = data.duration;
                }
            })
            .catch(() => {})
            .finally(() => {
                const r = getRow();
                if (r) {
                    const sp = r.querySelector('.dur-spinner');
                    if (sp) sp.classList.add('d-none');
                }
            });
    }

    // ── Move left → right (catalog stays, duplicates allowed) ─────────────
    document.getElementById('btn-add').addEventListener('click', () => {
        if (READ_ONLY) return;
        const sel = new Set(Array.from(leftListEl.querySelectorAll('.ll-row.selected')).map(r => +r.dataset.id));
        if (!sel.size) return;
        const added = [];
        const pushSong = (s) => {
            const item = { type: 'song', songId: s.id, composer: s.composer, title: s.title, duration: '', note: '', uid: freshUid() };
            rightItems.push(item);
            added.push(item);
        };
        leftSongs.forEach(s => {
            if (!sel.has(s.id)) return;
            // A selected movement whose parent is also selected is added via the parent below.
            if (s.parentId != null && sel.has(s.parentId)) return;
            pushSong(s);
            // Adding a parent also adds all its movements, right after it.
            (childrenById.get(s.id) || []).forEach(pushSong);
        });
        render();
        added.forEach(fetchDuration);
    });

    // ── Remove from right list ─────────────────────────────────────────────
    document.getElementById('btn-remove').addEventListener('click', () => {
        if (READ_ONLY) return;
        const sel = new Set(Array.from(rightListEl.querySelectorAll('.ll-row.selected')).map(r => r.dataset.uid));
        if (!sel.size) return;
        // Removing a parent song also removes all its movements.
        const childSongIds = new Set();
        rightItems.forEach(it => {
            if (sel.has(it.uid) && it.type === 'song' && it.songId != null) {
                (childrenById.get(it.songId) || []).forEach(c => childSongIds.add(c.id));
            }
        });
        for (let i = rightItems.length - 1; i >= 0; i--) {
            const it = rightItems[i];
            if (sel.has(it.uid) || (it.type === 'song' && it.songId != null && childSongIds.has(it.songId))) {
                rightItems.splice(i, 1);
            }
        }
        render();
    });

    // ── Double-click shortcut ──────────────────────────────────────────────
    leftListEl.addEventListener('dblclick', e => {
        if (READ_ONLY) return;
        const row = e.target.closest('.ll-row');
        if (!row) return;
        leftListEl.querySelectorAll('.ll-row').forEach(r => r.classList.remove('selected'));
        row.classList.add('selected');
        document.getElementById('btn-add').click(); // btn-add handler calls fetchDuration
    });
    rightListEl.addEventListener('dblclick', e => {
        if (READ_ONLY) return;
        const row = e.target.closest('.ll-row');
        if (!row || e.target.closest('.btn-del-item, .btn-edit-item, input')) return;
        rightListEl.querySelectorAll('.ll-row').forEach(r => r.classList.remove('selected'));
        row.classList.add('selected');
        document.getElementById('btn-remove').click();
    });

    // ── Custom item ────────────────────────────────────────────────────────
    const customComposerEl = document.getElementById('custom-composer');
    const customTitleEl    = document.getElementById('custom-title-input');
    const customDurEl      = document.getElementById('custom-dur-input');
    const customAddPanel   = document.getElementById('custom-add-panel');
    const customAddTitle   = document.getElementById('custom-add-title');
    const customAddIcon    = document.getElementById('custom-add-icon');
    const btnAddCustom     = document.getElementById('btn-add-custom');
    let editingUid         = null;

    function enterEditMode(item) {
        customComposerEl.value = item.composer;
        customTitleEl.value    = item.title;
        customDurEl.value      = item.duration;
        editingUid = item.uid;
        customAddPanel.classList.add('editing');
        customAddTitle.textContent = 'Freies Stück bearbeiten';
        customAddIcon.className    = 'bi bi-pencil me-1';
        btnAddCustom.innerHTML     = '<i class="bi bi-check-lg"></i>';
        btnAddCustom.classList.replace('btn-warning', 'btn-success');
        customAddPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        customComposerEl.focus();
    }

    function exitEditMode() {
        editingUid = null;
        customAddPanel.classList.remove('editing');
        customAddTitle.textContent = 'Freies Stück hinzufügen';
        customAddIcon.className    = 'bi bi-plus-circle me-1';
        btnAddCustom.innerHTML     = '<i class="bi bi-plus-lg"></i>';
        btnAddCustom.classList.replace('btn-success', 'btn-warning');
    }

    function addCustomItem() {
        if (READ_ONLY) return;
        const title = customTitleEl.value.trim();
        if (!title) { customTitleEl.focus(); customTitleEl.classList.add('is-invalid'); return; }
        customTitleEl.classList.remove('is-invalid');

        if (editingUid !== null) {
            const item = rightItems.find(x => x.uid === editingUid);
            if (item) {
                item.composer = customComposerEl.value.trim();
                item.title    = title;
                item.duration = customDurEl.value.trim();
            }
            exitEditMode();
        } else {
            rightItems.push({
                type:     'custom',
                composer: customComposerEl.value.trim(),
                title,
                duration: customDurEl.value.trim(),
                note:     '',
                uid:      freshUid(),
            });
            rightListEl.scrollTop = rightListEl.scrollHeight;
        }

        customComposerEl.value = '';
        customTitleEl.value    = '';
        customDurEl.value      = '';
        customComposerEl.focus();
        render();
    }

    btnAddCustom.addEventListener('click', addCustomItem);
    customTitleEl.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); addCustomItem(); } });
    customAddPanel.addEventListener('keydown', e => {
        if (e.key === 'Escape' && editingUid !== null) {
            exitEditMode();
            customComposerEl.value = '';
            customTitleEl.value    = '';
            customDurEl.value      = '';
        }
    });

    // ── Etikett toggle ────────────────────────────────────────────────────
    document.getElementById('show-etikett')?.addEventListener('change', render);

    // ── Filter ────────────────────────────────────────────────────────────
    leftSearchEl.addEventListener('input',  render);
    rightSearchEl.addEventListener('input', render);

    // ── Drag & drop ────────────────────────────────────────────────────────
    let dragUid = null;

    rightListEl.addEventListener('dragstart', e => {
        if (READ_ONLY) { e.preventDefault(); return; }
        const row = e.target.closest('.ll-row');
        if (!row) { e.preventDefault(); return; }
        dragUid = row.dataset.uid;
        e.dataTransfer.effectAllowed = 'move';
        setTimeout(() => row.classList.add('dragging'), 0);
    });

    rightListEl.addEventListener('dragend', () => {
        rightListEl.querySelectorAll('.dragging').forEach(r => r.classList.remove('dragging'));
        clearIndicators();
        dragUid = null;
    });

    rightListEl.addEventListener('dragover', e => {
        e.preventDefault();
        e.dataTransfer.dropEffect = 'move';
        clearIndicators();
        const row = e.target.closest('.ll-row');
        if (!row || row.dataset.uid === dragUid) return;
        const mid = row.getBoundingClientRect().top + row.getBoundingClientRect().height / 2;
        row.classList.add(e.clientY < mid ? 'drop-before' : 'drop-after');
    });

    rightListEl.addEventListener('dragleave', e => {
        if (!rightListEl.contains(e.relatedTarget)) clearIndicators();
    });

    rightListEl.addEventListener('drop', e => {
        e.preventDefault();
        const targetRow = e.target.closest('.ll-row');
        clearIndicators();
        if (!dragUid || !targetRow || targetRow.dataset.uid === dragUid) { render(); return; }

        const fromIdx = rightItems.findIndex(x => x.uid === dragUid);
        const [moved] = rightItems.splice(fromIdx, 1);
        const toIdx   = rightItems.findIndex(x => x.uid === targetRow.dataset.uid);
        const mid     = targetRow.getBoundingClientRect().top + targetRow.getBoundingClientRect().height / 2;
        rightItems.splice(e.clientY < mid ? toIdx : toIdx + 1, 0, moved);
        render();
    });

    function clearIndicators() {
        rightListEl.querySelectorAll('.drop-before, .drop-after')
            .forEach(r => r.classList.remove('drop-before', 'drop-after'));
    }

    // ── Sync to hidden input before submit ─────────────────────────────────
    document.getElementById('liste-form').addEventListener('submit', () => {
        const payload = rightItems.map(item => ({
            type:     item.type,
            songId:   item.songId ?? null,
            composer: item.composer,
            title:    item.title,
            duration: item.duration || '',
            note:     item.note    || '',
        }));
        document.getElementById('items-json-input').value = JSON.stringify(payload);
    });

    // ── Initial render ─────────────────────────────────────────────────────
    render();
}());
</script>
{% endblock %}
