{% extends 'base.html.twig' %}

{% block title %}Logs - Admin - {{ parent() }}{% endblock %}

{% block body %}
<!-- template: templates/admin/logs.html.twig -->
<meta name="csrf-token" content="{{ csrf_token('blacklist_ip') }}">
<div class="container-fluid py-4">
    <div class="d-flex align-items-center gap-3 mb-3">
        <a href="{{ path('admin_dashboard') }}" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Dashboard
        </a>
        <h1 class="h3 mb-0"><i class="bi bi-file-text me-2"></i>Logs <small class="text-muted fs-6">{{ logFile }}</small></h1>
    </div>

    <form class="d-flex align-items-center gap-2 mb-3" method="get">
        <label class="form-label mb-0 fw-semibold">Mindest-Level:</label>
        <select name="level" class="form-select form-select-sm w-auto" onchange="this.form.submit()">
            {% for lvl in levels %}
            <option value="{{ lvl }}" {% if lvl == minLevel %}selected{% endif %}>{{ lvl }}</option>
            {% endfor %}
        </select>
        <span class="text-muted small">({{ entries|length }} Einträge)</span>
    </form>

    {% if entries is empty %}
    <div class="alert alert-success">
        <i class="bi bi-check-circle me-1"></i>Keine Einträge auf diesem Level gefunden.
    </div>
    {% else %}
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle" style="font-size:0.82rem">
            <thead class="table-dark sticky-top">
                <tr>
                    <th style="width:140px">Zeitstempel</th>
                    <th style="width:80px">Kanal</th>
                    <th style="width:80px">Level</th>
                    <th>Meldung</th>
                    <th style="width:120px">Aktion</th>
                </tr>
            </thead>
            <tbody>
                {% for entry in entries %}
                {% set rowClass = '' %}
                {% set badgeClass = 'bg-secondary' %}
                {% if entry.level in ['CRITICAL','ALERT','EMERGENCY'] %}
                    {% set rowClass = 'table-danger' %}
                    {% set badgeClass = 'bg-danger' %}
                {% elseif entry.level == 'ERROR' %}
                    {% set rowClass = 'table-danger' %}
                    {% set badgeClass = 'bg-danger' %}
                {% elseif entry.level == 'WARNING' %}
                    {% set rowClass = 'table-warning' %}
                    {% set badgeClass = 'bg-warning text-dark' %}
                {% elseif entry.level == 'NOTICE' %}
                    {% set badgeClass = 'bg-info text-dark' %}
                {% elseif entry.level == 'INFO' %}
                    {% set badgeClass = 'bg-primary' %}
                {% endif %}
                <tr class="{{ rowClass }}" data-log-message="{{ entry.message }} {{ entry.context|default('') }}">
                    <td class="text-nowrap font-monospace small">{{ entry.timestamp|date('d.m.Y H:i:s') }}</td>
                    <td><span class="badge bg-secondary">{{ entry.channel }}</span></td>
                    <td><span class="badge {{ badgeClass }}">{{ entry.level }}</span></td>
                    <td>
                        <div class="font-monospace">{{ entry.message }}</div>
                        {% if entry.context %}
                        <div class="text-muted small mt-1" style="white-space:pre-wrap;word-break:break-all">{{ entry.context }}</div>
                        {% endif %}
                    </td>
                    <td class="text-nowrap">
                        {% if entry.level in ['WARNING', 'ERROR', 'CRITICAL'] and entry.channel == 'security' %}
                            <button class="btn btn-sm btn-outline-danger blacklist-btn"
                                    data-log-row-index="{{ loop.index }}"
                                    title="IP aus Logs blacklisten">
                                <i class="bi bi-ban me-1"></i>Blacklist
                            </button>
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}
</div>

<script>
document.addEventListener('click', async (e) => {
    const btn = e.target.closest('.blacklist-btn');
    if (!btn) return;

    // Extract IP address from log message using regex
    const row = btn.closest('tr');
    const message = row.getAttribute('data-log-message') || '';
    const ipMatch = message.match(/\b(?:\d{1,3}\.){3}\d{1,3}\b/);

    if (!ipMatch) {
        alert('Keine IP-Adresse gefunden');
        return;
    }

    const ip = ipMatch[0];
    const reason = message.substring(0, 100);

    if (!confirm(`IP ${ip} blacklisten? Grund: ${reason}`)) return;

    btn.disabled = true;
    btn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>...';

    try {
        const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
        if (!csrfToken) {
            alert('CSRF-Token nicht gefunden');
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-ban me-1"></i>Blacklist';
            return;
        }

        const form = new FormData();
        form.append('_token', csrfToken);
        form.append('ip', ip);
        form.append('reason', reason);

        const res = await fetch('{{ path("admin_blacklist_ip") }}', {
            method: 'POST',
            body: form
        });
        const data = await res.json();

        if (res.ok && data.success) {
            btn.innerHTML = '<i class="bi bi-check-circle me-1"></i>Blockiert';
            btn.classList.remove('btn-outline-danger');
            btn.classList.add('btn-danger');
            setTimeout(() => {
                alert(`✅ IP ${ip} wurde blockiert`);
            }, 300);
        } else {
            alert('❌ Fehler: ' + (data.error || 'Unbekannter Fehler'));
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-ban me-1"></i>Blacklist';
        }
    } catch (err) {
        alert('❌ Fehler beim Blacklisten: ' + err.message);
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-ban me-1"></i>Blacklist';
    }
});
</script>
{% endblock %}
