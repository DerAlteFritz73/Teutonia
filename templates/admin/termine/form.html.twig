{% extends 'base.html.twig' %}

{% block title %}{{ isNew ? 'Neuer Termin' : 'Termin bearbeiten' }} - {{ parent() }}{% endblock %}

{% block body %}
<div class="container py-5">
    <h1>{{ isNew ? 'Neuer Termin' : 'Termin bearbeiten' }}</h1>

    {{ form_start(form) }}
        <div class="row">
            <div class="col-md-6 mb-3">
                {{ form_row(form.title) }}
            </div>
            <div class="col-md-6 mb-3">
                {{ form_row(form.date) }}
            </div>
        </div>
        <div class="mb-3">
            {{ form_row(form.location) }}
        </div>
        <div class="mb-3">
            {{ form_row(form.description) }}
        </div>
        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Speichern</button>
            <a href="{{ path('admin_events') }}" class="btn btn-secondary">Abbrechen</a>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
