{% extends 'base.html.twig' %}

{% block title %}Termine verwalten - {{ parent() }}{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Termine</h1>
        <a href="{{ path('admin_events_new') }}" class="btn btn-primary">
            Neuer Termin
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Datum</th>
                    <th>Titel</th>
                    <th>Ort</th>
                    <th>Aktionen</th>
                </tr>
            </thead>
            <tbody>
                {% for event in events %}
                    <tr>
                        <td>{{ event.date|date('d.m.Y H:i') }}</td>
                        <td>{{ event.title }}</td>
                        <td>{{ event.location ?? '-' }}</td>
                        <td>
                            <a href="{{ path('admin_events_edit', {id: event.id}) }}" class="btn btn-sm btn-outline-primary">
                                Bearbeiten
                            </a>
                            <form action="{{ path('admin_events_delete', {id: event.id}) }}" method="post" class="d-inline"
                                  onsubmit="return confirm('Wirklich löschen?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ event.id) }}">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Löschen</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="text-muted">Keine Termine vorhanden.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <a href="{{ path('admin_dashboard') }}" class="btn btn-secondary">Zurück</a>
</div>
{% endblock %}
