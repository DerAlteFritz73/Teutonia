{% extends 'base.html.twig' %}

{% block title %}{{ isNew ? 'Neuer Benutzer' : 'Benutzer bearbeiten' }} - {{ parent() }}{% endblock %}

{% block body %}
<!-- template: templates/admin/users/form.html.twig -->
<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">{{ isNew ? 'Neuer Benutzer' : 'Benutzer bearbeiten' }}</h1>
        <div class="d-flex gap-2">
            <a href="{{ path('admin_users') }}" class="btn btn-secondary">Abbrechen</a>
            <button type="submit" form="user-form" class="btn btn-primary">Speichern</button>
        </div>
    </div>

    {{ form_start(form, {attr: {id: 'user-form', 'data-unsaved-check': ''}}) }}
        <div class="row">
            <div class="col-md-6 mb-3">
                {{ form_row(form.firstName) }}
            </div>
            <div class="col-md-6 mb-3">
                {{ form_row(form.lastName) }}
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                {{ form_row(form.username) }}
            </div>
            <div class="col-md-6 mb-3">
                {{ form_row(form.email) }}
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label">Passwort</label>
            {% if isNew %}
                <div class="input-group">
                    {{ form_widget(form.plainPassword, {'id': 'plainPassword', 'attr': {'class': 'form-control'}}) }}
                    <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('plainPassword', this)">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye" viewBox="0 0 16 16">
                            <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/>
                            <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/>
                        </svg>
                    </button>
                </div>
            {% else %}
                <div id="passwordDisplay">
                    <div class="input-group">
                        <input type="text" class="form-control" value="••••••••" disabled>
                        <button class="btn btn-outline-warning" type="button" onclick="showPasswordReset()">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-key me-1" viewBox="0 0 16 16">
                                <path d="M0 8a4 4 0 0 1 7.465-2H14a.5.5 0 0 1 .354.146l1.5 1.5a.5.5 0 0 1 0 .708l-1.5 1.5a.5.5 0 0 1-.708 0L13 9.207l-.646.647a.5.5 0 0 1-.708 0L11 9.207l-.646.647a.5.5 0 0 1-.708 0L9 9.207l-.646.647A.5.5 0 0 1 8 10h-.535A4 4 0 0 1 0 8m4-3a3 3 0 1 0 2.712 4.285A.5.5 0 0 1 7.163 9h.63l.853-.854a.5.5 0 0 1 .708 0l.646.647.646-.647a.5.5 0 0 1 .708 0l.646.647.646-.647a.5.5 0 0 1 .708 0l.646.647.793-.793-1-1h-6.63a.5.5 0 0 1-.451-.285A3 3 0 0 0 4 5"/>
                                <path d="M4 8a1 1 0 1 1-2 0 1 1 0 0 1 2 0"/>
                            </svg>
                            Passwort zurücksetzen
                        </button>
                    </div>
                </div>
                <div id="passwordInput" style="display: none;">
                    <div class="input-group">
                        {{ form_widget(form.plainPassword, {'id': 'plainPassword', 'attr': {'class': 'form-control', 'placeholder': 'Neues Passwort eingeben'}}) }}
                        <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('plainPassword', this)">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye" viewBox="0 0 16 16">
                                <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/>
                                <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/>
                            </svg>
                        </button>
                        <button class="btn btn-outline-danger" type="button" onclick="hidePasswordReset()">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-x-lg" viewBox="0 0 16 16">
                                <path d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8z"/>
                            </svg>
                        </button>
                    </div>
                    <div class="form-text text-warning">Neues Passwort eingeben und speichern, um es zu ändern.</div>
                </div>
                <script>
                    function showPasswordReset() {
                        document.getElementById('passwordDisplay').style.display = 'none';
                        document.getElementById('passwordInput').style.display = 'block';
                        document.getElementById('plainPassword').focus();
                    }
                    function hidePasswordReset() {
                        document.getElementById('passwordDisplay').style.display = 'block';
                        document.getElementById('passwordInput').style.display = 'none';
                        document.getElementById('plainPassword').value = '';
                    }
                </script>
            {% endif %}
        </div>
        <div class="mb-4 mt-4">
            <label class="form-label fw-bold">Rollen</label>
            <div class="d-flex gap-4 mt-2">
                {% for child in form.roles %}
                    <div class="form-check">
                        {{ form_widget(child, {'attr': {'class': 'form-check-input'}}) }}
                        {{ form_label(child, null, {'label_attr': {'class': 'form-check-label'}}) }}
                    </div>
                {% endfor %}
            </div>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
