{% extends 'base.html.twig' %}

{% block title %}Benutzer verwalten - {{ parent() }}{% endblock %}

{% block body %}
<!-- template: templates/admin/users/index.html.twig -->
<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Benutzer</h1>
        <a href="{{ path('admin_users_new') }}" class="btn btn-primary">
            Neuer Benutzer
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>E-Mail</th>
                    <th>Rollen</th>
                    <th>Aktionen</th>
                </tr>
            </thead>
            <tbody>
                {% for user in users %}
                    <tr>
                        <td>{{ user.fullName }}</td>
                        <td>{{ user.email }}</td>
                        <td>
                            {% for role in user.roles|sort %}
                                {% if role == 'ROLE_ADMIN' %}
                                    <span class="badge bg-danger">Admin</span>
                                {% elseif role == 'ROLE_USER' %}
                                    <span class="badge bg-secondary">Mitglied</span>
                                {% endif %}
                            {% endfor %}
                        </td>
                        <td>
                            <a href="{{ path('admin_users_edit', {id: user.id}) }}" class="btn btn-sm btn-outline-primary">
                                Bearbeiten
                            </a>
                            <form action="{{ path('admin_users_reset_password', {id: user.id}) }}" method="post" class="d-inline"
                                  onsubmit="return confirm('Passwort von {{ user.fullName }} auf &quot;teutonia&quot; zurücksetzen?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('reset-password' ~ user.id) }}">
                                <button type="submit" class="btn btn-sm btn-outline-warning">Passwort zurücksetzen</button>
                            </form>
                            <form action="{{ path('admin_users_delete', {id: user.id}) }}" method="post" class="d-inline"
                                  onsubmit="return confirm('Wirklich löschen?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Löschen</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="text-muted">Keine Benutzer vorhanden.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <a href="{{ path('admin_dashboard') }}" class="btn btn-secondary">Zurück</a>
</div>
{% endblock %}
