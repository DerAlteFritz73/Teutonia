{% extends 'base.html.twig' %}

{% block title %}{{ isNew ? 'Neues Lied' : 'Lied bearbeiten' }} - {{ parent() }}{% endblock %}

{% block body %}
<!-- template: templates/admin/songs/form.html.twig -->
<div class="container py-5" style="max-width: 860px;">
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show">{{ message }}<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show">{{ message }}<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    {% endfor %}

    {{ form_start(form, {attr: {novalidate: 'novalidate', 'data-unsaved-check': ''}}) }}

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <h1 class="mb-0 minw-0 text-break">{{ isNew ? 'Neues Lied' : song.songName }}</h1>
        <div class="d-flex gap-2 align-items-center flex-wrap">
            {% if not isNew %}
            <button type="button" class="btn btn-outline-danger"
                    data-tooltip="Lied unwiderruflich löschen"
                    onclick="if(confirm('Lied wirklich löschen?')) document.getElementById('song-delete-form').submit()">
                <i class="bi bi-trash me-1"></i>Löschen
            </button>
            {% endif %}
            <a href="{{ path('admin_songs') }}" class="btn btn-secondary"
               data-tooltip="Zurück zur Liederliste, Änderungen verwerfen"
               data-unsaved-cancel>
                <i class="bi bi-x-lg me-1"></i>Abbrechen
            </a>
            <button type="submit" class="btn btn-primary"
                    data-tooltip="Änderungen speichern">
                <i class="bi bi-floppy me-1"></i>Speichern
            </button>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header fw-semibold">Grunddaten</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-8">
                    {{ form_row(form.songName) }}
                </div>
                <div class="col-md-2">
                    {{ form_row(form.etikettColor) }}
                </div>
                <div class="col-md-2">
                    {{ form_row(form.etikettNumber) }}
                </div>
                <datalist id="etikett-colors">
                    <option value="Rosa"></option>
                    <option value="Blau"></option>
                    <option value="Gelb"></option>
                    <option value="Extrabox"></option>
                    <option value="Büchel"></option>
                </datalist>
                <div class="col-md-6">
                    {{ form_row(form.composer) }}
                </div>
                <div class="col-md-6">
                    {{ form_row(form.arrangeur) }}
                </div>
                <div class="col-md-3">
                    {{ form_row(form.compositionYear) }}
                </div>
                <div class="col-md-3">
                    {{ form_label(form.duration) }}
                    <div class="input-group">
                        {{ form_widget(form.duration) }}
                        {% if not isNew and (song.dropboxlink or song.aktuelleDropboxlink or song.links|length > 0) %}
                        <button type="button" id="btn-recalc-duration" class="btn btn-outline-secondary"
                                data-song-id="{{ song.id }}"
                                data-tooltip="Dauer aus Dropbox/YouTube neu berechnen">
                            <i class="bi bi-arrow-clockwise"></i>
                        </button>
                        {% endif %}
                    </div>
                    {{ form_errors(form.duration) }}
                </div>
                <div class="col-12">
                    {{ form_row(form.background) }}
                </div>
                <div class="col-md-6">
                    {{ form_label(form.parent) }}
                    <input type="search" id="parent-search" class="form-control form-control-sm mb-1"
                           placeholder="Filtern…" autocomplete="off">
                    <div class="d-flex gap-2 align-items-start">
                        <div class="flex-grow-1">
                            {{ form_widget(form.parent) }}
                            {{ form_errors(form.parent) }}
                        </div>
                        {% if not isNew and song.parent %}
                        <button type="button" id="clear-parent-btn" class="btn btn-sm btn-outline-danger mt-2"
                                title="Übergeordnetes Stück entfernen"
                                data-tooltip="Übergeordnetes Stück entfernen">
                            <i class="bi bi-x"></i>
                        </button>
                        {% endif %}
                    </div>
                    {% if not isNew and song.children|length > 0 %}
                        <div class="mt-1 small text-muted">
                            <i class="bi bi-diagram-3 me-1"></i>
                            Übergeordnetes Stück mit {{ song.children|length }} Satz/Sätzen —
                            ein Satz kann kein eigenes übergeordnetes Stück haben.
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header fw-semibold">Links auf Youtube</div>
        <div class="card-body">
            <div id="song-links-container" data-index="{{ form.links|length }}"
                 data-search-url="{{ path('admin_songs_youtube_search') }}"
                 data-links-name="{{ form.links.vars.full_name }}"
                 data-query-title-sel="#song_keyword_songName"
                 data-query-composer-sel="#song_keyword_composer"
                 data-duration-input="#song_keyword_duration"
                 data-default-query="{{ ((song.songName ?? '') ~ ' ' ~ (song.composer ?? ''))|trim }}">
                {% for linkForm in form.links %}
                    {% set lurl   = linkForm.url.vars.value %}
                    {% set llabel = linkForm.label.vars.value %}
                    <div class="link-row d-flex align-items-center gap-2 mb-2">
                        <i class="bi bi-youtube text-danger fs-5 flex-shrink-0"></i>
                        <a href="{{ lurl }}" target="_blank" rel="noopener"
                           class="flex-grow-1 text-truncate" style="min-width:0">{{ llabel ?: lurl }}</a>
                        <input type="hidden" name="{{ form.links.vars.full_name }}[{{ loop.index0 }}][url]"   value="{{ lurl }}">
                        <input type="hidden" name="{{ form.links.vars.full_name }}[{{ loop.index0 }}][label]" value="{{ llabel }}">
                        <button type="button" class="btn btn-outline-danger btn-sm remove-link flex-shrink-0"
                                data-tooltip="Link entfernen">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                {% endfor %}
            </div>
            {# Rows are rendered manually above (hidden inputs); tell the form not to re-render the collection in form_end(). #}
            {% do form.links.setRendered %}
            <button type="button" class="btn btn-outline-secondary btn-sm mt-1" id="add-link-btn"
                    data-tooltip="Auf YouTube suchen und Link hinzufügen">
                <i class="bi bi-youtube me-1 text-danger"></i>Link auf YouTube suchen
            </button>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header fw-semibold">Stile</div>
        <div class="card-body">
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-2">
                {% for child in form.styles %}
                    <div class="col">
                        <div class="form-check">
                            {{ form_widget(child, {attr: {class: 'form-check-input'}}) }}
                            {{ form_label(child, null, {label_attr: {class: 'form-check-label'}}) }}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header fw-semibold">Aktuelle Proben</div>
        <div class="card-body">
            <div class="form-check">
                {{ form_widget(form.isAktuelleProben, {attr: {class: 'form-check-input'}}) }}
                {{ form_label(form.isAktuelleProben, null, {label_attr: {class: 'form-check-label fw-semibold'}}) }}
                <div class="form-text">Dieses Lied erscheint im Bereich „Aktuelle Proben" für Mitglieder.</div>
            </div>
        </div>
    </div>

    {% if not isNew and (song.dropboxlink or song.aktuelleDropboxlink or song.children|length > 0) %}
    <div class="card mb-4">
        <div class="card-header fw-semibold"><i class="bi bi-folder2-open me-2"></i>Dateien (Dropbox)</div>
        <div class="card-body p-0">
            {% set mainPath = song.dropboxlink ?? song.aktuelleDropboxlink %}
            {% if mainPath %}
            <div class="accordion" id="editFilesAccordion">
                <div class="accordion-item border-0">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed accordion-btn-files"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#editFilesMain"
                                data-dropbox-path="{{ mainPath }}"
                                data-tooltip="Notenmaterial aus Dropbox laden">
                            <i class="bi bi-folder2-open me-2 text-warning"></i>
                            Notenmaterial
                            <span class="ps-3 d-flex gap-1 file-count-badges"></span>
                        </button>
                    </h2>
                    <div id="editFilesMain" class="accordion-collapse collapse">
                        <div class="accordion-body pt-2 pb-3">
                            <div class="list-group song-files-container" data-dropbox-path="{{ mainPath }}">
                                <div class="text-center text-muted py-3 file-loading-spinner">
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    Lade Dateien…
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            {% endif %}
            {% if song.children|length > 0 %}
            <div class="accordion {% if mainPath %}border-top{% endif %}" id="editMovementsAccordion">
                {% for movement in song.children %}
                    {% set movHasDropbox = movement.dropboxlink is not null and movement.dropboxlink != '' %}
                    <div class="accordion-item border-0">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed {% if movHasDropbox %}accordion-btn-files{% endif %} py-2"
                                    type="button"
                                    {% if movHasDropbox %}
                                    data-bs-toggle="collapse"
                                    data-bs-target="#editMov{{ movement.id }}"
                                    data-dropbox-path="{{ movement.dropboxlink }}"
                                    data-tooltip="Dateien für diesen Satz laden"
                                    {% endif %}>
                                <i class="bi bi-music-note me-2 text-primary"></i>
                                <span class="flex-grow-1">{{ movement.songName }}</span>
                                {% if movHasDropbox %}
                                    <span class="ps-3 d-flex gap-1 file-count-badges"></span>
                                {% else %}
                                    <span class="badge bg-secondary ms-2 fw-normal">kein Dropbox-Pfad</span>
                                {% endif %}
                            </button>
                        </h2>
                        {% if movHasDropbox %}
                        <div id="editMov{{ movement.id }}" class="accordion-collapse collapse">
                            <div class="accordion-body py-2">
                                <div class="list-group song-files-container" data-dropbox-path="{{ movement.dropboxlink }}">
                                    <div class="text-center text-muted py-3 file-loading-spinner">
                                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                        Lade Dateien…
                                    </div>
                                </div>
                            </div>
                        </div>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
            {% endif %}
            {% if not mainPath and song.children|length == 0 %}
                <p class="text-muted p-3 mb-0"><i class="bi bi-info-circle me-1"></i>Kein Dropbox-Pfad hinterlegt.</p>
            {% endif %}
        </div>
    </div>
    {% endif %}

    {{ form_end(form) }}

    {% if not isNew %}
    <form id="song-delete-form" action="{{ path('admin_songs_delete', {id: song.id}) }}" method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ song.id) }}">
    </form>
    {% endif %}

</div>

{% include 'admin/songs/_yt_link_search_modal.html.twig' %}

<!-- PDF Viewer Modal -->
<div class="modal fade" id="pdfViewerModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-fullscreen-lg-down">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-file-pdf-fill text-danger me-2"></i><span id="pdfFileName"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        data-tooltip="Vorschau schließen"></button>
            </div>
            <div class="modal-body p-0" style="height:80vh;">
                <iframe id="pdfViewerFrame" style="width:100%;height:100%;border:none;"></iframe>
            </div>
            <div class="modal-footer">
                <a id="pdfDownloadLink" href="#" download class="btn btn-primary"
                   data-tooltip="PDF-Datei herunterladen"><i class="bi bi-download me-2"></i>Herunterladen</a>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"
                        data-tooltip="Vorschau schließen">Schließen</button>
            </div>
        </div>
    </div>
</div>

<!-- Audio Player Modal -->
<div class="modal fade" id="audioPlayerModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-music-note-beamed text-primary me-2"></i><span id="audioFileName"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        data-tooltip="Player schließen"></button>
            </div>
            <div class="modal-body">
                <audio id="audioPlayer" controls class="w-100 mb-4">Ihr Browser unterstützt das Audio-Element nicht.</audio>
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title mb-3"><i class="bi bi-speedometer2 me-2"></i>Wiedergabegeschwindigkeit</h6>
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <label class="form-label mb-0" style="min-width:60px;"><span id="speedValue">1.0</span>x</label>
                            <input type="range" class="form-range flex-grow-1" id="speedSlider" min="0.25" max="2.0" step="0.05" value="1.0">
                        </div>
                        <div class="d-flex gap-2 flex-wrap">
                            <button class="btn btn-sm btn-outline-secondary speed-preset" data-speed="0.5">0.5x</button>
                            <button class="btn btn-sm btn-outline-secondary speed-preset" data-speed="0.75">0.75x</button>
                            <button class="btn btn-sm btn-outline-primary speed-preset" data-speed="1">1.0x</button>
                            <button class="btn btn-sm btn-outline-secondary speed-preset" data-speed="1.25">1.25x</button>
                            <button class="btn btn-sm btn-outline-secondary speed-preset" data-speed="1.5">1.5x</button>
                            <button class="btn btn-sm btn-outline-secondary speed-preset" data-speed="2">2.0x</button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success" id="audioPlayBtn"
                        data-tooltip="Wiedergabe starten"><i class="bi bi-play-fill me-1"></i>Abspielen</button>
                <a id="audioDownloadLink" href="#" download class="btn btn-primary"
                   data-tooltip="Audio-Datei herunterladen"><i class="bi bi-download me-2"></i>Herunterladen</a>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"
                        data-tooltip="Player schließen">Schließen</button>
            </div>
        </div>
    </div>
</div>

<script>
window.PROBEN_CONFIG = {
    filesUrl: '{{ path('api_dropbox_song_files') }}',
    linkUrl:  '{{ path('api_dropbox_link') }}',
    viewUrl:  '{{ path('api_dropbox_view') }}'
};
</script>
<script src="{{ asset('js/member-proben.js') }}"></script>
<script src="{{ asset('js/yt-link-picker.js') }}"></script>

<script>
/* ── Parent search + auto-fill ── */
(function () {
    const search = document.getElementById('parent-search');
    const select = document.getElementById('song_keyword_parent');
    if (!search || !select) return;

    const allOptions = Array.from(select.options).map(o => ({ el: o, text: o.text.toLowerCase() }));

    search.addEventListener('input', function () {
        const terms = this.value.toLowerCase().split(/\s+/).filter(Boolean);
        const matches = o => terms.every(t => o.text.includes(t));
        allOptions.forEach(opt => { opt.el.hidden = terms.length > 0 && !matches(opt); });
        const visible = terms.length === 0 ? allOptions.length : allOptions.filter(matches).length;
        select.size = terms.length > 0 ? Math.max(2, Math.min(visible + 1, 10)) : 1;
    });

    search.addEventListener('keydown', e => { if (e.key === 'Enter') e.preventDefault(); });

    // Collapse select after picking a value
    select.addEventListener('change', function () {
        if (search.value.trim() === '') return;
        search.value = '';
        allOptions.forEach(opt => { opt.el.hidden = false; });
        select.size = 1;
    });

    // Auto-fill composer from selected parent
    const composerInput = document.getElementById('song_keyword_composer');
    if (composerInput) {
        select.addEventListener('change', function () {
            const opt = this.options[this.selectedIndex];
            if (!opt || !opt.value) return;

            const composer = opt.dataset.composer;
            if (composer) composerInput.value = composer;

            const styleIds = JSON.parse(opt.dataset.styles || '[]');
            document.querySelectorAll('[id^="song_keyword_styles_"]').forEach(cb => {
                cb.checked = styleIds.includes(parseInt(cb.value));
            });
        });
    }
}());

/* ── Clear parent assignment ── */
(function () {
    const clearBtn = document.getElementById('clear-parent-btn');
    const select = document.getElementById('song_keyword_parent');
    if (!clearBtn || !select) return;

    clearBtn.addEventListener('click', function (e) {
        e.preventDefault();
        select.value = '';
        const event = new Event('change', { bubbles: true });
        select.dispatchEvent(event);
        if (window.markFormDirty) window.markFormDirty();
        // Hide the clear button after clearing
        clearBtn.style.display = 'none';
    });
}());

/* ── Tooltips ── */
document.querySelectorAll('[data-tooltip]').forEach(function (el) {
    new bootstrap.Tooltip(el, { title: el.dataset.tooltip, trigger: 'hover' });
});

/* ── Suggest the next free Etikett number for the chosen colour ── */
(function () {
    const colorInput  = document.getElementById('song_keyword_etikettColor');
    const numberInput = document.getElementById('song_keyword_etikettNumber');
    if (!colorInput || !numberInput) return;

    colorInput.addEventListener('change', function () {
        const color = colorInput.value.trim();
        if (!color || numberInput.value.trim() !== '') return;   // only when number is empty
        fetch('{{ path('admin_songs_etikett_next_number') }}?color=' + encodeURIComponent(color), { cache: 'no-store' })
            .then(function (r) { return r.json(); })
            .then(function (d) {
                // Fill the actual value (not just the placeholder) so the suggested
                // number is submitted and persisted — otherwise consecutive new songs
                // keep getting suggested the same number.
                if (d && d.next) {
                    numberInput.value = String(d.next);
                    if (window.markFormDirty) window.markFormDirty();
                }
            })
            .catch(function () {});
    });
}());

/* ── Recalculate duration ("neu berechnen") ── */
(function () {
    const btn   = document.getElementById('btn-recalc-duration');
    const input = document.getElementById('song_keyword_duration');
    if (!btn || !input) return;

    btn.addEventListener('click', function () {
        const original = btn.innerHTML;
        btn.disabled  = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span>';
        fetch('{{ path('admin_liederlisten_fetch_duration') }}?songId=' + btn.dataset.songId + '&force=1')
            .then(function (r) { return r.json(); })
            .then(function (d) {
                if (d.duration) {
                    input.value = d.duration;
                    if (window.markFormDirty) window.markFormDirty();
                } else {
                    alert(d.error || 'Dauer nicht ermittelbar');
                }
            })
            .catch(function () { alert('Fehler beim Berechnen der Dauer'); })
            .finally(function () {
                btn.disabled  = false;
                btn.innerHTML = original;
            });
    });
}());
</script>
{% endblock %}
