{% extends 'base.html.twig' %}

{% block title %}{{ isNew ? 'Neues Lied' : 'Lied bearbeiten' }} - {{ parent() }}{% endblock %}

{% block body %}
<!-- template: templates/admin/songs/form.html.twig -->
<div class="container py-5" style="max-width: 860px;">
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show">{{ message }}<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show">{{ message }}<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    {% endfor %}

    {{ form_start(form, {attr: {novalidate: 'novalidate', 'data-unsaved-check': ''}}) }}

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">{{ isNew ? 'Neues Lied' : song.songName }}</h1>
        <div class="d-flex gap-2">
            <a href="{{ path('admin_songs') }}" class="btn btn-secondary">Abbrechen</a>
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-floppy me-1"></i>Speichern
            </button>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header fw-semibold">Grunddaten</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-8">
                    {{ form_row(form.songName) }}
                </div>
                <div class="col-md-4">
                    {{ form_row(form.etikett) }}
                </div>
                <div class="col-md-6">
                    {{ form_row(form.composer) }}
                </div>
                <div class="col-md-6">
                    {{ form_label(form.parent) }}
                    <input type="search" id="parent-search" class="form-control form-control-sm mb-1"
                           placeholder="Filtern…" autocomplete="off">
                    {{ form_widget(form.parent) }}
                    {{ form_errors(form.parent) }}
                    {% if not isNew and song.children|length > 0 %}
                        <div class="mt-1 small text-muted">
                            <i class="bi bi-diagram-3 me-1"></i>
                            Übergeordnetes Stück mit {{ song.children|length }} Satz/Sätzen —
                            ein Satz kann kein eigenes übergeordnetes Stück haben.
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header fw-semibold">Dropbox &amp; Proben</div>
        <div class="card-body">
            <div class="form-check mb-3">
                {{ form_widget(form.isAktuelleProben, {attr: {class: 'form-check-input'}}) }}
                {{ form_label(form.isAktuelleProben, null, {label_attr: {class: 'form-check-label fw-semibold'}}) }}
                <div class="form-text">Dieses Lied erscheint im Bereich „Aktuelle Proben" für Mitglieder.</div>
            </div>
            <hr>
            {{ form_row(form.dropboxlink) }}
            {{ form_row(form.aktuelleDropboxlink) }}
            <small class="text-muted">
                Vollständiger Pfad zum Ordner in Dropbox, z.B.
                <code>/Chorgemeinschaft Teutonia/Noten/Cohen - Hallelujah</code>
            </small>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header fw-semibold">Links</div>
        <div class="card-body">
            <div id="song-links-container"
                 data-prototype="{{ form_widget(form.links.vars.prototype)|e('html_attr') }}"
                 data-index="{{ form.links|length }}">
                {% for linkForm in form.links %}
                    <div class="link-row input-group mb-2">
                        {{ form_widget(linkForm.url,   {attr: {class: 'form-control', placeholder: 'https://…'}}) }}
                        {{ form_widget(linkForm.label, {attr: {class: 'form-control', placeholder: 'Bezeichnung (optional)'}}) }}
                        <button type="button" class="btn btn-outline-danger remove-link" title="Entfernen">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                    {% for error in linkForm.url.vars.errors %}
                        <div class="text-danger small mb-1">{{ error.message }}</div>
                    {% endfor %}
                {% endfor %}
            </div>
            <button type="button" class="btn btn-outline-secondary btn-sm mt-1" id="add-link-btn">
                <i class="bi bi-plus-lg me-1"></i>Link hinzufügen
            </button>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header fw-semibold">Stile</div>
        <div class="card-body">
            <div class="row row-cols-2 row-cols-md-3 g-2">
                {% for child in form.styles %}
                    <div class="col">
                        <div class="form-check">
                            {{ form_widget(child, {attr: {class: 'form-check-input'}}) }}
                            {{ form_label(child, null, {label_attr: {class: 'form-check-label'}}) }}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>

    {{ form_end(form) }}

    {% if not isNew %}
    <div class="d-flex gap-2 mt-2">
        <form action="{{ path('admin_songs_delete', {id: song.id}) }}" method="post"
              class="ms-auto" onsubmit="return confirm('Lied wirklich löschen?')">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ song.id) }}">
            <button class="btn btn-outline-danger">
                <i class="bi bi-trash me-1"></i>Löschen
            </button>
        </form>
    </div>
    {% endif %}
</div>

<script>
/* ── Song links collection ── */
(function () {
    const container = document.getElementById('song-links-container');
    const addBtn    = document.getElementById('add-link-btn');
    if (!container || !addBtn) return;

    function attachRemove(row) {
        row.querySelector('.remove-link').addEventListener('click', function () {
            row.remove();
        });
    }

    container.querySelectorAll('.link-row').forEach(attachRemove);

    addBtn.addEventListener('click', function () {
        const index     = parseInt(container.dataset.index, 10);
        const prototype = container.dataset.prototype;
        const html      = prototype.replace(/__name__/g, index);
        const div       = document.createElement('div');
        div.innerHTML   = `<div class="link-row input-group mb-2">${html}<button type="button" class="btn btn-outline-danger remove-link" title="Entfernen"><i class="bi bi-trash"></i></button></div>`;
        const row       = div.firstElementChild;
        attachRemove(row);
        container.appendChild(row);
        container.dataset.index = index + 1;
        row.querySelector('input[type="text"], input[type="url"]').focus();
    });
}());

/* ── Parent search + auto-fill ── */
(function () {
    const search = document.getElementById('parent-search');
    const select = document.getElementById('song_keyword_parent');
    if (!search || !select) return;

    const allOptions = Array.from(select.options).map(o => ({ el: o, text: o.text.toLowerCase() }));

    search.addEventListener('input', function () {
        const q = this.value.toLowerCase().trim();
        allOptions.forEach(opt => { opt.el.hidden = q !== '' && !opt.text.includes(q); });
        const visible = q === '' ? allOptions.length : allOptions.filter(o => o.text.includes(q)).length;
        select.size = q !== '' ? Math.max(2, Math.min(visible + 1, 10)) : 1;
    });

    search.addEventListener('keydown', e => { if (e.key === 'Enter') e.preventDefault(); });

    // Collapse select after picking a value
    select.addEventListener('change', function () {
        if (search.value.trim() === '') return;
        search.value = '';
        allOptions.forEach(opt => { opt.el.hidden = false; });
        select.size = 1;
    });

    // Auto-fill composer from selected parent
    const composerInput = document.getElementById('song_keyword_composer');
    if (composerInput) {
        select.addEventListener('change', function () {
            const opt = this.options[this.selectedIndex];
            if (!opt || !opt.value) return;

            const composer = opt.dataset.composer;
            if (composer) composerInput.value = composer;

            const styleIds = JSON.parse(opt.dataset.styles || '[]');
            document.querySelectorAll('[id^="song_keyword_styles_"]').forEach(cb => {
                cb.checked = styleIds.includes(parseInt(cb.value));
            });
        });
    }
}());
</script>
{% endblock %}
