{% extends 'base.html.twig' %}

{% block title %}Lieder verwalten - {{ parent() }}{% endblock %}

{% macro sort_th(label, field, sort, dir, search, cssStyle, extraAttrs) %}
    {% set nextDir = (sort == field and dir == 'ASC') ? 'DESC' : 'ASC' %}
    <th{% if cssStyle %} style="{{ cssStyle }}"{% endif %}{% if extraAttrs %} {{ extraAttrs|raw }}{% endif %}>
        <a href="{{ path('admin_songs', {sort: field, dir: nextDir, q: search, page: 1}) }}"
           class="text-white text-decoration-none d-flex align-items-center gap-1 user-select-none">
            {{- label -}}
            {% if sort == field %}
                <i class="bi bi-chevron-{{ dir == 'ASC' ? 'up' : 'down' }} ms-1"></i>
            {% else %}
                <i class="bi bi-chevron-expand ms-1 opacity-50"></i>
            {% endif %}
        </a>
    </th>
{% endmacro %}

{% block body %}
<!-- template: templates/admin/songs/index.html.twig -->
<meta name="turbo-cache-control" content="no-cache">
{% set months_de = ['Jan.','Feb.','Mär.','Apr.','Mai','Jun.','Jul.','Aug.','Sep.','Okt.','Nov.','Dez.'] %}
<link rel="stylesheet" href="{{ asset('css/admin-songs.css') }}">

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Lieder <span class="badge bg-secondary fs-6">{{ totalAll }}</span></h1>
        <div class="d-flex gap-2">
            <button id="btn-sync-dropbox" class="btn btn-outline-primary" title="Dropbox-Ordner abgleichen und fehlende Verknüpfungen automatisch setzen">
                <i class="bi bi-cloud-arrow-down me-1"></i>Dropbox synchronisieren
            </button>
            <a href="{{ path('admin_songs_new') }}" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i>Neues Lied
            </a>
        </div>
    </div>

    {# Sync result modal #}
    <div class="modal fade" id="syncResultModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-cloud-arrow-down me-2"></i>Dropbox-Synchronisation</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" id="syncResultBody">
                    <div class="text-center py-3">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="mt-2 mb-0">Verbindung zu Dropbox…</p>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Schließen</button>
                    <button type="button" class="btn btn-primary d-none" id="btnReloadAfterSync"
                            onclick="location.reload()">Seite neu laden</button>
                </div>
            </div>
        </div>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show">{{ message }}<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    {% endfor %}

    {# Search filter #}
    <div class="mb-3" style="max-width:500px;">
        <input type="search" id="songsSearch" class="form-control"
               placeholder="Lied suchen…"
               autocomplete="off"
               value="{{ search|e('html_attr') }}">
    </div>
    <div id="songsNoResults" class="text-muted d-none">Kein Lied gefunden.</div>

    <p class="text-muted small mb-2">
        <i class="bi bi-pencil-square me-1"></i>Auf eine Zelle klicken zum direkten Bearbeiten.
        <kbd>Enter</kbd> speichern &middot; <kbd>Esc</kbd> abbrechen.
        Stile nur über <i class="bi bi-pencil"></i>.
    </p>

    <div class="table-responsive">
        <table class="table table-striped table-hover table-sm align-middle" id="songs-table">
            <thead class="table-dark">
                <tr>
                    {{ _self.sort_th('Etikett',           'etikett',       sort, dir, search, 'width:115px', 'class="d-none d-md-table-cell"') }}
                    {{ _self.sort_th('Liedtitel',          'songName',      sort, dir, search, null,         '') }}
                    {{ _self.sort_th('Komponist',          'composer',      sort, dir, search, 'width:190px', 'class="d-none d-md-table-cell"') }}
                    <th class="d-none d-md-table-cell">Stile</th>
                    {{ _self.sort_th('Letzte Aufführung',  'latestKonzert', sort, dir, search, 'width:130px', 'class="d-none d-md-table-cell"') }}
                    {{ _self.sort_th('Dropbox',            'dropboxlink',   sort, dir, search, 'width:40px',  'class="d-none d-md-table-cell"') }}
                    <th class="text-end" style="width:80px">Aktionen</th>
                </tr>
            </thead>
            <tbody>
                {% for song in songs %}
                    {% set prefix = song.etikett ? song.etikett|split(' ')|first|lower : '' %}
                    {% set badgeClass = {
                        'blau':     'bg-primary text-white',
                        'gelb':     'bg-warning text-dark',
                        'rosa':     'bg-danger-subtle text-danger-emphasis border border-danger-subtle',
                        'extrabox': 'bg-secondary text-white'
                    }[prefix] ?? 'bg-light text-dark border' %}
                    {# ── macro: render one song row (reused for parent + children) ── #}
                    {% macro song_row(song, months_de, isChild) %}
                        {% set prefix = song.etikett ? song.etikett|split(' ')|first|lower : '' %}
                        {% set badgeClass = {
                            'blau':     'bg-primary text-white',
                            'gelb':     'bg-warning text-dark',
                            'rosa':     'bg-danger-subtle text-danger-emphasis border border-danger-subtle',
                            'extrabox': 'bg-secondary text-white'
                        }[prefix] ?? 'bg-light text-dark border' %}
                        <tr data-id="{{ song.id }}"
                            {% if isChild %}class="movement-row" style="background:#f5f7ff; display:none"{% endif %}>

                            {# Etikett #}
                            <td class="editable-cell" data-field="etikett">
                                {% if isChild %}<span class="text-muted ps-2" title="Satz">↳</span>{% endif %}
                                <span class="display-val">
                                    {% if song.etikett %}
                                        <span class="badge {{ badgeClass }} fw-normal">{{ song.etikett }}</span>
                                    {% elseif not isChild %}
                                        <span class="text-muted">—</span>
                                    {% endif %}
                                </span>
                                <input class="edit-input form-control form-control-sm d-none"
                                       type="text" maxlength="20"
                                       value="{{ song.etikett ?? '' }}"
                                       placeholder="z.B. Blau 29">
                            </td>

                            {# Liedtitel #}
                            <td class="editable-cell {% if not isChild %}fw-semibold{% endif %}" data-field="songName">
                                <span class="display-val {% if isChild %}fst-italic text-secondary{% endif %}">{{ song.songName }}</span>
                                <input class="edit-input form-control form-control-sm d-none"
                                       type="text"
                                       value="{{ song.songName|e('html_attr') }}">
                            </td>

                            {# Komponist #}
                            <td class="editable-cell" data-field="composer">
                                <span class="display-val text-muted">{{ song.composer ?? '—' }}</span>
                                <input class="edit-input form-control form-control-sm d-none"
                                       type="text"
                                       value="{{ song.composer ?? '' }}"
                                       placeholder="Komponist">
                            </td>

                            {# Stile #}
                            <td>
                                {% for style in song.styles %}
                                    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle fw-normal">{{ style.name }}</span>
                                {% endfor %}
                            </td>

                            {# Letztes Konzert #}
                            <td>
                                {% set latestDate = song.latestKonzertDate %}
                                <span class="text-muted">
                                    {{ latestDate ? latestDate|date('d.m.Y') : '—' }}
                                </span>
                            </td>

                            {# Dropbox #}
                            <td class="editable-cell" data-field="dropboxlink">
                                <span class="display-val">
                                    {% if song.dropboxlink %}
                                        <i class="bi bi-folder-check text-success" title="{{ song.dropboxlink }}"></i>
                                    {% else %}
                                        <i class="bi bi-folder-x text-danger"></i>
                                    {% endif %}
                                </span>
                                <input class="edit-input form-control form-control-sm d-none"
                                       type="text"
                                       value="{{ song.dropboxlink ?? '' }}"
                                       placeholder="/Chorgemeinschaft Teutonia/Noten/…"
                                       style="min-width:220px">
                            </td>

                            {# Aktionen #}
                            <td class="text-end">
                                <a href="{{ path('admin_songs_edit', {id: song.id}) }}"
                                   class="btn btn-sm btn-outline-primary" title="Bearbeiten">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form action="{{ path('admin_songs_delete', {id: song.id}) }}" method="post"
                                      class="d-inline" onsubmit="return confirm('Lied wirklich löschen?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ song.id) }}">
                                    <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    {% endmacro %}

                    {# ── Parent row ──────────────────────────────────── #}
                    {% set prefix = song.etikett ? song.etikett|split(' ')|first|lower : '' %}
                    {% set badgeClass = {
                        'blau':     'bg-primary text-white',
                        'gelb':     'bg-warning text-dark',
                        'rosa':     'bg-danger-subtle text-danger-emphasis border border-danger-subtle',
                        'extrabox': 'bg-secondary text-white'
                    }[prefix] ?? 'bg-light text-dark border' %}
                    <tr data-id="{{ song.id }}">
                        {# Etikett #}
                        <td class="editable-cell d-none d-md-table-cell" data-field="etikett">
                            <span class="display-val">
                                {% if song.etikett %}
                                    <span class="badge {{ badgeClass }} fw-normal">{{ song.etikett }}</span>
                                {% else %}
                                    <span class="text-muted">—</span>
                                {% endif %}
                            </span>
                            <input class="edit-input form-control form-control-sm d-none"
                                   type="text" maxlength="20"
                                   value="{{ song.etikett ?? '' }}"
                                   placeholder="z.B. Blau 29">
                        </td>

                        {# Liedtitel — expand triggers + editable name #}
                        <td class="fw-semibold">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="btn-expand-detail text-muted" data-song="{{ song.id }}"
                                      role="button" title="Dateien &amp; Links ein-/ausblenden" style="cursor:pointer; line-height:1">
                                    <i class="bi bi-chevron-right" id="detail-chev-{{ song.id }}"></i>
                                </span>
                                {% if song.children|length > 0 %}
                                    <div class="btn-expand-movements d-flex align-items-center gap-1"
                                         data-parent="{{ song.id }}" role="button"
                                         title="{{ song.children|length }} Satz/Sätze ein-/ausblenden">
                                        <i class="bi bi-chevron-right text-muted" id="chev-{{ song.id }}"></i>
                                        <span class="badge bg-secondary rounded-pill" style="font-size:.6rem">{{ song.children|length }}</span>
                                    </div>
                                {% endif %}
                            </div>
                            <div class="editable-cell" data-field="songName">
                                <span class="display-val">{{ song.songName }}</span>
                                <input class="edit-input form-control form-control-sm d-none"
                                       type="text"
                                       value="{{ song.songName|e('html_attr') }}">
                            </div>
                        </td>

                        {# Komponist #}
                        <td class="editable-cell d-none d-md-table-cell" data-field="composer">
                            <span class="display-val text-muted">{{ song.composer ?? '—' }}</span>
                            <input class="edit-input form-control form-control-sm d-none"
                                   type="text"
                                   value="{{ song.composer ?? '' }}"
                                   placeholder="Komponist">
                        </td>

                        {# Stile #}
                        <td class="d-none d-md-table-cell">
                            {% for style in song.styles %}
                                <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle fw-normal">{{ style.name }}</span>
                            {% endfor %}
                        </td>

                        {# Letztes Konzert #}
                        <td class="d-none d-md-table-cell">
                            {% set latestDate = song.latestKonzertDate %}
                            <span class="text-muted">
                                {{ latestDate ? latestDate|date('d.m.Y') : '—' }}
                            </span>
                        </td>

                        {# Dropbox #}
                        <td class="editable-cell d-none d-md-table-cell" data-field="dropboxlink">
                            <span class="display-val">
                                {% if song.dropboxlink %}
                                    <i class="bi bi-folder-check text-success" title="{{ song.dropboxlink }}"></i>
                                {% else %}
                                    <i class="bi bi-folder-x text-danger"></i>
                                {% endif %}
                            </span>
                            <input class="edit-input form-control form-control-sm d-none"
                                   type="text"
                                   value="{{ song.dropboxlink ?? '' }}"
                                   placeholder="/Chorgemeinschaft Teutonia/Noten/…"
                                   style="min-width:220px">
                        </td>

                        {# Aktionen #}
                        <td class="text-end">
                            <a href="{{ path('admin_songs_edit', {id: song.id}) }}"
                               class="btn btn-sm btn-outline-primary" title="Vollständig bearbeiten (inkl. Stile)">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form action="{{ path('admin_songs_delete', {id: song.id}) }}" method="post"
                                  class="d-inline" onsubmit="return confirm('Lied wirklich löschen?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ song.id) }}">
                                <button class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>

                    {# ── Detail row (hidden by default) ────────────── #}
                    <tr class="song-detail-row" data-song-id="{{ song.id }}" style="display:none">
                        <td colspan="7" class="p-0">
                            <div class="p-3 bg-light border-bottom">
                                {% if song.links|length > 0 %}
                                    <div class="d-flex flex-wrap gap-2 mb-3">
                                        {% for link in song.links %}
                                            {% set isYoutube = 'youtube.com' in link.url or 'youtu.be' in link.url %}
                                            <a href="{{ link.url }}" target="_blank" rel="noopener noreferrer"
                                               class="btn btn-sm btn-outline-secondary">
                                                {% if isYoutube %}
                                                    <i class="bi bi-youtube text-danger me-1"></i>
                                                {% else %}
                                                    <i class="bi bi-link-45deg me-1"></i>
                                                {% endif %}
                                                {{ link.label ?? link.url }}
                                            </a>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                                {% if song.dropboxlink %}
                                    <div class="list-group song-files-container" data-dropbox-path="{{ song.dropboxlink }}">
                                        <div class="text-center text-muted py-3 file-loading-spinner">
                                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                            Lade Dateien…
                                        </div>
                                    </div>
                                {% elseif song.links|length == 0 %}
                                    <p class="text-muted mb-0 small">
                                        <i class="bi bi-info-circle me-1"></i>Keine Dateien oder Links hinterlegt.
                                    </p>
                                {% endif %}
                            </div>
                        </td>
                    </tr>

                    {# ── Movement rows (hidden by default) ─────────── #}
                    {% for child in song.children %}
                        {% set prefix = child.etikett ? child.etikett|split(' ')|first|lower : '' %}
                        {% set badgeClass = {
                            'blau':     'bg-primary text-white',
                            'gelb':     'bg-warning text-dark',
                            'rosa':     'bg-danger-subtle text-danger-emphasis border border-danger-subtle',
                            'extrabox': 'bg-secondary text-white'
                        }[prefix] ?? 'bg-light text-dark border' %}
                        <tr data-id="{{ child.id }}"
                            class="movement-row movement-parent-{{ song.id }}"
                            data-parent-id="{{ song.id }}"
                            style="background:#f0f3ff; display:none;"
                            draggable="true">

                            <td class="editable-cell d-none d-md-table-cell" data-field="etikett">
                                <span class="drag-handle" title="Verschieben"><i class="bi bi-grip-vertical"></i></span>
                                <span class="text-primary opacity-50 ps-1">↳</span>
                                <span class="display-val">
                                    {% if child.etikett %}
                                        <span class="badge {{ badgeClass }} fw-normal">{{ child.etikett }}</span>
                                    {% endif %}
                                </span>
                                <input class="edit-input form-control form-control-sm d-none"
                                       type="text" maxlength="20"
                                       value="{{ child.etikett ?? '' }}"
                                       placeholder="z.B. Blau 29">
                            </td>

                            <td class="editable-cell" data-field="songName">
                                <span class="text-primary opacity-50 d-md-none me-1">↳</span>
                                <span class="display-val fst-italic text-secondary">{{ child.songName }}</span>
                                <input class="edit-input form-control form-control-sm d-none"
                                       type="text"
                                       value="{{ child.songName|e('html_attr') }}">
                            </td>

                            <td class="editable-cell d-none d-md-table-cell" data-field="composer">
                                <span class="display-val text-muted">{{ child.composer ?? '—' }}</span>
                                <input class="edit-input form-control form-control-sm d-none"
                                       type="text"
                                       value="{{ child.composer ?? '' }}"
                                       placeholder="Komponist">
                            </td>

                            <td class="d-none d-md-table-cell">
                                {% for style in child.styles %}
                                    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle fw-normal">{{ style.name }}</span>
                                {% endfor %}
                            </td>

                            <td class="d-none d-md-table-cell">
                                {% set latestDate = child.latestKonzertDate %}
                                <span class="text-muted">
                                    {{ latestDate ? latestDate|date('d.m.Y') : '—' }}
                                </span>
                            </td>

                            <td class="editable-cell d-none d-md-table-cell" data-field="dropboxlink">
                                <span class="display-val">
                                    {% if child.dropboxlink %}
                                        <i class="bi bi-folder-check text-success" title="{{ child.dropboxlink }}"></i>
                                    {% else %}
                                        <i class="bi bi-folder-x text-danger"></i>
                                    {% endif %}
                                </span>
                                <input class="edit-input form-control form-control-sm d-none"
                                       type="text"
                                       value="{{ child.dropboxlink ?? '' }}"
                                       placeholder="/Chorgemeinschaft Teutonia/Noten/…"
                                       style="min-width:220px">
                            </td>

                            <td class="text-end">
                                <a href="{{ path('admin_songs_edit', {id: child.id}) }}"
                                   class="btn btn-sm btn-outline-primary" title="Bearbeiten">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form action="{{ path('admin_songs_delete', {id: child.id}) }}" method="post"
                                      class="d-inline" onsubmit="return confirm('Satz wirklich löschen?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ child.id) }}">
                                    <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                {% else %}
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            Keine Lieder gefunden{% if search %} für „{{ search }}"{% endif %}.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% if totalPages > 1 %}
        <nav aria-label="Seitennavigation" class="mt-3">
            <ul class="pagination justify-content-center flex-wrap mb-2">
                <li class="page-item{{ currentPage == 1 ? ' disabled' : '' }}">
                    <a class="page-link" href="{{ path('admin_songs', {page: currentPage - 1, q: search, sort: sort, dir: dir}) }}">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>
                {% for p in 1..totalPages %}
                    {% if p == 1 or p == totalPages or (p >= currentPage - 2 and p <= currentPage + 2) %}
                        <li class="page-item{{ p == currentPage ? ' active' : '' }}">
                            <a class="page-link" href="{{ path('admin_songs', {page: p, q: search, sort: sort, dir: dir}) }}">{{ p }}</a>
                        </li>
                    {% elseif p == currentPage - 3 or p == currentPage + 3 %}
                        <li class="page-item disabled"><span class="page-link">…</span></li>
                    {% endif %}
                {% endfor %}
                <li class="page-item{{ currentPage == totalPages ? ' disabled' : '' }}">
                    <a class="page-link" href="{{ path('admin_songs', {page: currentPage + 1, q: search, sort: sort, dir: dir}) }}">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
            <div class="d-flex justify-content-center align-items-center gap-2 text-muted small">
                <span>Seite</span>
                <input type="number" id="page-jump" class="form-control form-control-sm text-center"
                       min="1" max="{{ totalPages }}" value="{{ currentPage }}"
                       style="width:4rem">
                <span>von {{ totalPages }}</span>
            </div>
        </nav>
        <script>
        document.getElementById('page-jump').addEventListener('keydown', function (e) {
            if (e.key !== 'Enter') return;
            const p = Math.min({{ totalPages }}, Math.max(1, parseInt(this.value) || 1));
            const url = new URL(window.location.href);
            url.searchParams.set('page', p);
            window.location.href = url.toString();
        });
        </script>
    {% endif %}

    <a href="{{ path('admin_dashboard') }}" class="btn btn-secondary mt-2">
        <i class="bi bi-arrow-left me-1"></i>Zurück
    </a>
</div>

<script>
window.SONGS_CONFIG = {
    csrfPatch: '{{ csrf_token('song_patch') }}',
    csrfSync:  '{{ csrf_token('sync_dropbox') }}',
    syncUrl:   '{{ path('admin_songs_sync_dropbox') }}',
    filesUrl:  '{{ path('api_dropbox_song_files') }}',
    linkUrl:   '{{ path('api_dropbox_link') }}',
    viewUrl:   '{{ path('api_dropbox_view') }}'
};
</script>
<script>
(function () {
    'use strict';
    var input    = document.getElementById('songsSearch');
    var noResult = document.getElementById('songsNoResults');
    if (!input) return;

    // Focus and place cursor at end (autofocus resets to position 0 after Turbo navigation)
    input.focus();
    var end = input.value.length;
    input.setSelectionRange(end, end);

    input.addEventListener('input', function () {
        var q    = input.value.trim().toLowerCase();
        var rows = document.querySelectorAll('#songs-table tbody tr:not(.movement-row):not(.song-detail-row)');
        var visible = 0;

        rows.forEach(function (row) {
            var nameEl     = row.querySelector('[data-field="songName"] .display-val');
            var composerEl = row.querySelector('[data-field="composer"] .display-val');
            var text       = (nameEl ? nameEl.textContent : '') + ' ' + (composerEl ? composerEl.textContent : '');
            var show       = !q || text.toLowerCase().includes(q);
            row.style.display = show ? '' : 'none';
            if (show) visible++;

            var parentId = row.getAttribute('data-id');
            if (parentId) {
                // Hide movement rows for hidden parents
                document.querySelectorAll('.movement-parent-' + parentId).forEach(function (child) {
                    if (!show) child.style.display = 'none';
                });
                // Hide detail row for hidden parents
                var detailRow = document.querySelector('.song-detail-row[data-song-id="' + parentId + '"]');
                if (detailRow && !show) detailRow.style.display = 'none';
            }
        });

        noResult.classList.toggle('d-none', visible > 0 || !q);
    });
}());
</script>
<script src="{{ asset('js/admin-songs.js') }}"></script>

<!-- PDF Viewer Modal -->
<div class="modal fade" id="pdfViewerModal" tabindex="-1" aria-labelledby="pdfViewerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-fullscreen-lg-down">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="pdfViewerModalLabel">
                    <i class="bi bi-file-pdf-fill text-danger me-2"></i>
                    <span id="pdfFileName"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0" style="height: 80vh;">
                <iframe id="pdfViewerFrame" style="width: 100%; height: 100%; border: none;"></iframe>
            </div>
            <div class="modal-footer">
                <a id="pdfDownloadLink" href="#" download class="btn btn-primary">
                    <i class="bi bi-download me-2"></i>Herunterladen
                </a>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Schließen</button>
            </div>
        </div>
    </div>
</div>

<!-- Audio Player Modal -->
<div class="modal fade" id="audioPlayerModal" tabindex="-1" aria-labelledby="audioPlayerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="audioPlayerModalLabel">
                    <i class="bi bi-music-note-beamed text-primary me-2"></i>
                    <span id="audioFileName"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <audio id="audioPlayer" controls class="w-100 mb-4" style="outline: none;">
                    Ihr Browser unterstützt das Audio-Element nicht.
                </audio>
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title mb-3">
                            <i class="bi bi-speedometer2 me-2"></i>Wiedergabegeschwindigkeit
                        </h6>
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <label for="speedSlider" class="form-label mb-0" style="min-width: 60px;">
                                <span id="speedValue">1.0</span>x
                            </label>
                            <input type="range" class="form-range flex-grow-1" id="speedSlider"
                                   min="0.25" max="2.0" step="0.05" value="1.0">
                        </div>
                        <div class="d-flex gap-2 flex-wrap">
                            <button class="btn btn-sm btn-outline-secondary speed-preset" data-speed="0.5">0.5x</button>
                            <button class="btn btn-sm btn-outline-secondary speed-preset" data-speed="0.75">0.75x</button>
                            <button class="btn btn-sm btn-outline-primary speed-preset" data-speed="1">1.0x</button>
                            <button class="btn btn-sm btn-outline-secondary speed-preset" data-speed="1.25">1.25x</button>
                            <button class="btn btn-sm btn-outline-secondary speed-preset" data-speed="1.5">1.5x</button>
                            <button class="btn btn-sm btn-outline-secondary speed-preset" data-speed="2">2.0x</button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success" id="audioPlayBtn">
                    <i class="bi bi-play-fill me-1"></i>Abspielen
                </button>
                <a id="audioDownloadLink" href="#" download class="btn btn-primary">
                    <i class="bi bi-download me-2"></i>Herunterladen
                </a>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Schließen</button>
            </div>
        </div>
    </div>
</div>
{% endblock %}
