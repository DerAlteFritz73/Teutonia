{% extends 'base.html.twig' %}

{% block title %}Links bearbeiten – {{ song.songName }} - {{ parent() }}{% endblock %}

{% block body %}
<!-- template: templates/admin/songs/links_edit.html.twig -->
<div class="container py-5" style="max-width:620px;">
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show">{{ message }}<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    {% endfor %}

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-0 fs-4">{{ song.songName }}</h1>
            {% if song.composer %}<div class="text-muted small">{{ song.composer }}</div>{% endif %}
        </div>
        <div class="d-flex gap-2">
            <a href="{{ path('member_proben') }}" class="btn btn-secondary" data-unsaved-cancel>
                <i class="bi bi-x-lg me-1"></i>Abbrechen
            </a>
            <button type="submit" form="links-form" class="btn btn-primary">
                <i class="bi bi-floppy me-1"></i>Speichern
            </button>
        </div>
    </div>

    {{ form_start(form, {attr: {id: 'links-form', 'data-unsaved-check': ''}}) }}

    <div class="card">
        <div class="card-header fw-semibold">
            <i class="bi bi-youtube text-danger me-2"></i>Links auf Youtube
        </div>
        <div class="card-body">
            <div id="song-links-container"
                 data-prototype="{{ form_widget(form.links.vars.prototype)|e('html_attr') }}"
                 data-index="{{ form.links|length }}">
                {% for linkForm in form.links %}
                    <div class="link-row input-group mb-2">
                        {{ form_widget(linkForm.url,   {attr: {class: 'form-control', placeholder: 'https://…'}}) }}
                        {{ form_widget(linkForm.label, {attr: {class: 'form-control', placeholder: 'Bezeichnung (optional)'}}) }}
                        <button type="button" class="btn btn-outline-danger remove-link" title="Entfernen">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                    {% for error in linkForm.url.vars.errors %}
                        <div class="text-danger small mb-1">{{ error.message }}</div>
                    {% endfor %}
                {% endfor %}
            </div>
            <button type="button" class="btn btn-outline-secondary btn-sm mt-1" id="add-link-btn">
                <i class="bi bi-plus-lg me-1"></i>Link hinzufügen
            </button>
        </div>
    </div>

    {{ form_end(form) }}
</div>

<script>
(function () {
    const container = document.getElementById('song-links-container');
    const addBtn    = document.getElementById('add-link-btn');
    if (!container || !addBtn) return;

    function attachRemove(row) {
        row.querySelector('.remove-link').addEventListener('click', function () {
            row.remove();
            if (window.markFormDirty) window.markFormDirty();
        });
    }

    container.querySelectorAll('.link-row').forEach(attachRemove);

    addBtn.addEventListener('click', function () {
        const index     = parseInt(container.dataset.index, 10);
        const html      = container.dataset.prototype.replace(/__name__/g, index);
        const div       = document.createElement('div');
        div.innerHTML   = `<div class="link-row input-group mb-2">${html}<button type="button" class="btn btn-outline-danger remove-link" title="Entfernen"><i class="bi bi-trash"></i></button></div>`;
        const row       = div.firstElementChild;
        attachRemove(row);
        container.appendChild(row);
        container.dataset.index = index + 1;
        row.querySelector('input').focus();
    });
}());
</script>
{% endblock %}
