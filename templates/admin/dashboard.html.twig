{% extends 'base.html.twig' %}

{% block title %}Admin - {{ parent() }}{% endblock %}

{% block body %}
<!-- template: templates/admin/dashboard.html.twig -->
<div class="container py-5">
    <h1>Administration</h1>
    <p class="lead">Verwaltung von Benutzern, Links und Terminen.</p>

    <div class="row mt-4">
        <div class="col-md-4 mb-4">
            <div class="card text-white bg-primary h-100 position-relative" style="cursor:pointer">
                <div class="card-body">
                    <h5 class="card-title">Mitglieder</h5>
                    <p class="display-4">{{ userCount }}</p>
                    <a href="{{ path('admin_users') }}" class="btn btn-light stretched-link"><i class="bi bi-pencil-square me-1"></i>Verwalten</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card text-white bg-warning h-100 position-relative" style="cursor:pointer">
                <div class="card-body">
                    <h5 class="card-title">Beiträge</h5>
                    <p class="display-4">{{ postCount }}</p>
                    <a href="{{ path('admin_posts') }}" class="btn btn-light stretched-link"><i class="bi bi-pencil-square me-1"></i>Verwalten</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card text-white bg-success h-100 position-relative" style="cursor:pointer">
                <div class="card-body">
                    <h5 class="card-title">Lieder</h5>
                    <p class="display-4">{{ songCount }}</p>
                    <a href="{{ path('admin_songs') }}" class="btn btn-light stretched-link"><i class="bi bi-pencil-square me-1"></i>Verwalten</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card text-white h-100 position-relative" style="background:linear-gradient(135deg,#6f42c1,#d63384);cursor:pointer">
                <div class="card-body">
                    <h5 class="card-title">Stile</h5>
                    <p class="card-text">Musikstile verwalten &amp; Ellipsen für Répertoire konfigurieren</p>
                    <a href="{{ path('admin_styles') }}" class="btn btn-light stretched-link"><i class="bi bi-pencil-square me-1"></i>Verwalten</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card text-white h-100 position-relative" style="background:linear-gradient(135deg,#b8860b,#e67e22);cursor:pointer">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-music-note-beamed me-1"></i>Konzerte</h5>
                    <p class="display-4">{{ konzertCount }}</p>
                    <a href="{{ path('admin_konzerte') }}" class="btn btn-light stretched-link"><i class="bi bi-pencil-square me-1"></i>Verwalten</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card text-white h-100 position-relative" style="background:linear-gradient(135deg,#0f5132,#198754);cursor:pointer">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-music-note-list me-1"></i>Liederlisten</h5>
                    <p class="display-4">{{ liederlistenCount }}</p>
                    <a href="{{ path('admin_liederlisten') }}" class="btn btn-light stretched-link"><i class="bi bi-pencil-square me-1"></i>Verwalten</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card text-white h-100" style="background:linear-gradient(135deg,#198754,#20c997)">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-box-arrow-in-right me-1"></i>Logins der Mitglieder</h5>
                    <p class="display-4">{{ memberLoginSum }} <span class="fs-5 opacity-75">({{ memberUniqueLoginCount }} Mitglieder)</span></p>
                    <p class="card-text small mb-0">Gesamtanzahl Anmeldungen aller Mitglieder</p>
                    {% if memberLastSeenAt %}
                    <p class="card-text small mt-1 mb-0 opacity-75">Zuletzt aktiv: {{ memberLastSeenAt|date('d.m.Y H:i') }}</p>
                    {% endif %}
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card text-white h-100 position-relative" style="background:linear-gradient(135deg,#6c1d1d,#c0392b);cursor:pointer">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-exclamation-triangle me-1"></i>Logs</h5>
                    {% if logErrorCount > 0 %}
                    <p class="display-4">{{ logErrorCount }}</p>
                    <p class="card-text small mb-0">Warnungen / Fehler (letzte 500 Einträge)</p>
                    {% if logLastErrorAt %}
                    <p class="card-text small mt-1 mb-0 opacity-75">Letzter Fehler: {{ logLastErrorAt|date('d.m.Y H:i') }}</p>
                    {% endif %}
                    {% else %}
                    <p class="card-text mt-2">Keine Fehler in den letzten 500 Einträgen.</p>
                    {% endif %}
                    <div class="d-flex gap-2 mt-2">
                        <a href="{{ path('admin_logs') }}" class="btn btn-light btn-sm stretched-link position-relative"><i class="bi bi-file-text me-1"></i>Logs anzeigen</a>
                        <a href="{{ path('admin_logs', {env: 'dev'}) }}" class="btn btn-outline-light btn-sm position-relative" style="z-index:2"><i class="bi bi-bug me-1"></i>Dev Logs</a>
                        <button type="button" class="btn btn-outline-light btn-sm position-relative" id="btn-hetzner-terminal" style="z-index:2"><i class="bi bi-terminal me-1"></i>Prod Terminal</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card text-white bg-dark h-100 position-relative" style="cursor:pointer">
                <div class="card-body">
                    <h5 class="card-title">Datenbank</h5>
                    <p class="card-text">MariaDB verwalten</p>
                    <div class="d-flex flex-wrap gap-2">
                        <a href="/phpmyadmin" target="_blank" class="btn btn-light stretched-link"><i class="bi bi-database me-1"></i>PHPMyAdmin öffnen</a>
                        <button type="button" id="btn-prod-sync" class="btn btn-outline-light position-relative" style="z-index:2"><i class="bi bi-cloud-download me-1"></i>Von Prod kopieren</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card text-white h-100 position-relative" style="background:linear-gradient(135deg,#0d6efd,#0dcaf0);cursor:pointer">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-play-circle me-1"></i>Tests</h5>
                    <p class="card-text">E2E-Tests starten und Ergebnisse einsehen</p>
                    <a href="{{ path('admin_tests') }}" class="btn btn-light stretched-link"><i class="bi bi-play-circle me-1"></i>Zu den Tests</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card text-white h-100 position-relative" style="background:linear-gradient(135deg,#17a2b8,#20c997);cursor:pointer" id="card-cache-clear">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-trash2 me-1"></i>Cache leeren</h5>
                    <p class="card-text small">Symfony-Cache, OPcache und Browser-Cache zurücksetzen – damit neue Änderungen sofort sichtbar sind.</p>
                    <button id="btn-cache-clear" class="btn btn-light btn-sm">
                        <i class="bi bi-trash2 me-1"></i>Jetzt leeren
                    </button>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card h-100 position-relative" style="border-color:#0061ff;cursor:pointer" id="card-dropbox-dash">
                <div class="card-body">
                    <h5 class="card-title" style="color:#0061ff"><i class="bi bi-cloud-arrow-down me-1"></i>Dropbox</h5>
                    <p class="card-text text-muted small">Dropbox-Ordner mit Lied-Einträgen abgleichen und fehlende Verknüpfungen automatisch setzen.</p>
                    <button id="btn-sync-dropbox-dash" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-cloud-arrow-down me-1"></i>Jetzt synchronisieren
                    </button>
                    <div id="sync-dash-result" class="mt-2 small"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="syncModalDash" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-cloud-arrow-down me-2"></i>Dropbox-Synchronisation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="syncModalDashBody">
                <div class="text-center py-3">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2 mb-0">Verbindung zu Dropbox…</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Schließen</button>
            </div>
        </div>
    </div>
</div>

<script>
document.getElementById('card-dropbox-dash').addEventListener('click', function(e) {
    if (!e.target.closest('button')) {
        document.getElementById('btn-sync-dropbox-dash').click();
    }
});
document.getElementById('card-cache-clear').addEventListener('click', function(e) {
    if (!e.target.closest('button')) {
        document.getElementById('btn-cache-clear').click();
    }
});
</script>

<!-- Hetzner SSH Terminal Modal -->
<div class="modal fade" id="hetznerTerminalModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-0">
            <div class="modal-header border-secondary py-2">
                <span class="modal-title small"><i class="bi bi-terminal me-2"></i>root@teutonia-willstaett.de</span>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0">
                <div id="hetzner-terminal" style="height:500px;background:#0d0d0d"></div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/xterm@5.3.0/css/xterm.min.css">
<script src="https://cdn.jsdelivr.net/npm/xterm@5.3.0/lib/xterm.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/xterm-addon-fit@0.8.0/lib/xterm-addon-fit.min.js"></script>

<script>
(function () {
    const modal   = document.getElementById('hetznerTerminalModal');
    const termEl  = document.getElementById('hetzner-terminal');
    let term      = null;
    let fitAddon  = null;
    let sessionId = null;
    let evtSource = null;

    function initTerminal() {
        if (term) { term.dispose(); }
        termEl.innerHTML = '';
        term = new Terminal({
            cursorBlink:     true,
            fontFamily:      'Menlo, Consolas, "Courier New", monospace',
            fontSize:        13,
            theme:           { background: '#0d0d0d' },
            convertEol:      true,
            scrollback:      2000,
        });
        fitAddon = new FitAddon.FitAddon();
        term.loadAddon(fitAddon);
        term.open(termEl);
        fitAddon.fit();

        term.onData(data => {
            if (!sessionId) return;
            fetch('{{ path('admin_hetzner_terminal_input', {'id': '__ID__'}) }}'.replace('__ID__', sessionId), {
                method:  'POST',
                body:    data,
                headers: { 'Content-Type': 'application/octet-stream' },
            });
        });
    }

    function connect() {
        fetch('{{ path('admin_hetzner_terminal_connect') }}', { method: 'POST' })
            .then(r => r.json())
            .then(({ id }) => {
                sessionId = id;
                evtSource = new EventSource('{{ path('admin_hetzner_terminal_stream', {'id': '__ID__'}) }}'.replace('__ID__', id));
                evtSource.onmessage = e => term.write(Uint8Array.from(atob(e.data), c => c.charCodeAt(0)));
                evtSource.addEventListener('close', () => {
                    term.writeln('\r\n\x1b[33m[Verbindung getrennt]\x1b[0m');
                    evtSource.close();
                });
                evtSource.onerror = () => {
                    term.writeln('\r\n\x1b[31m[Verbindungsfehler]\x1b[0m');
                    evtSource.close();
                };
            })
            .catch(() => term.writeln('\x1b[31m[Fehler beim Verbindungsaufbau]\x1b[0m'));
    }

    function disconnect() {
        if (evtSource) { evtSource.close(); evtSource = null; }
        sessionId = null;
    }

    document.getElementById('btn-hetzner-terminal').addEventListener('click', () => {
        const bsModal = new bootstrap.Modal(modal);
        bsModal.show();
    });

    modal.addEventListener('shown.bs.modal', () => {
        initTerminal();
        connect();
        window.addEventListener('resize', () => fitAddon && fitAddon.fit());
    });

    modal.addEventListener('hidden.bs.modal', disconnect);
})();
</script>

<script>
window.DASHBOARD_CONFIG = {
    csrfToken:      '{{ csrf_token('sync_dropbox') }}',
    syncUrl:        '{{ path('admin_songs_sync_dropbox') }}',
    cacheClearToken: '{{ csrf_token('cache_clear') }}',
    cacheClearUrl:  '{{ path('admin_cache_clear') }}',
    prodSyncToken:  '{{ csrf_token('prod_sync_copy') }}',
    prodSyncUrl:    '{{ path('admin_prod_sync_copy') }}'
};
</script>
<script src="{{ asset('js/admin-dashboard.js') }}"></script>
{% endblock %}
