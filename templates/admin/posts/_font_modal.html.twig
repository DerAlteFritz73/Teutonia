<!-- template: templates/admin/posts/_font_modal.html.twig -->
<div class="modal fade" id="{{ modalId }}" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Schriftart für {{ label }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-7">
                        <div class="mb-3">
                            <label class="form-label">Schriftart suchen</label>
                            <input type="text" class="form-control" id="fontSearch{{ field|capitalize }}" placeholder="Schriftart suchen...">
                        </div>
                        <div style="max-height: 400px; overflow-y: auto; border: 1px solid #dee2e6; border-radius: 4px;">
                            <div id="fontList{{ field|capitalize }}" class="list-group list-group-flush">
                                <!-- Fonts will be loaded here -->
                            </div>
                        </div>
                    </div>
                    <div class="col-md-5">
                        <div class="mb-3">
                            <label class="form-label">Schriftgröße (px)</label>
                            <input type="range" class="form-range" id="fontSizeSlider{{ field|capitalize }}" min="10" max="72" value="16">
                            <div class="d-flex justify-content-between">
                                <small>10px</small>
                                <strong><span id="fontSizeDisplay{{ field|capitalize }}">16</span>px</strong>
                                <small>72px</small>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Stil</label>
                            <div class="btn-group w-100" role="group">
                                <input type="checkbox" class="btn-check" id="fontBold{{ field|capitalize }}" autocomplete="off">
                                <label class="btn btn-outline-secondary" for="fontBold{{ field|capitalize }}"><strong>B</strong></label>

                                <input type="checkbox" class="btn-check" id="fontItalic{{ field|capitalize }}" autocomplete="off">
                                <label class="btn btn-outline-secondary" for="fontItalic{{ field|capitalize }}"><em>I</em></label>

                                <input type="checkbox" class="btn-check" id="fontUnderline{{ field|capitalize }}" autocomplete="off">
                                <label class="btn btn-outline-secondary" for="fontUnderline{{ field|capitalize }}"><u>U</u></label>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Vorschau</label>
                            <div class="p-3 border rounded bg-light" style="min-height: 200px; overflow-wrap: break-word;">
                                <p class="mb-0" id="preview{{ field|capitalize }}" style="font-size: 16px;">Vorschau Text</p>
                            </div>
                        </div>
                        <div class="alert alert-info p-2">
                            <small><strong>Ausgewählt:</strong> <span id="selectedFont{{ field|capitalize }}">Standard</span></small>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Abbrechen</button>
                <button type="button" class="btn btn-primary" onclick="applyFont{{ field|capitalize }}()">Anwenden</button>
            </div>
        </div>
    </div>
</div>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<script>initFontModal('{{ field|capitalize }}', '{{ field }}', '{{ modalId }}');</script>
