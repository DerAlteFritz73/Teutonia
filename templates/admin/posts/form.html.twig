{% extends 'base.html.twig' %}

{% block title %}{{ isNew ? 'Neuer Beitrag' : 'Beitrag bearbeiten' }} - {{ parent() }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/admin-posts-form.css') }}">
    <link href="https://cdn.quilljs.com/1.3.7/quill.snow.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.quilljs.com/1.3.7/quill.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js"></script>
    <script>
    window.POSTS_FORM_CONFIG = {
        imageRotation:   {{ post.imageRotation ?? 0 }},
        previewImageUrl: {% if not isNew and post.imagePath %}'{{ asset(post.imagePath) }}'{% else %}null{% endif %},
        pageMap: {
            'unser-chor':                '{{ path('page_chor') }}',
            'konzerte-und-aktivitaeten': '{{ path('page_concerts') }}',
            'historie':                  '{{ path('page_history') }}',
            'chorproben':                '{{ path('page_rehearsals') }}',
            'unser-repertoire':          '{{ path('page_repertoire') }}',
            'unsere-naechsten-termine':  '{{ path('page_events') }}',
            'geselliges':                '{{ path('page_social') }}',
            'archiv':                    '{{ path('member_archiv') }}',
            'beitraege':                 '{{ path('page_posts') }}'
        },
        postTitle: '{{ (post.title ?? '')|escape('js') }}',
        postId:    '{{ post.id ?? 'new' }}',
        isNew:     {{ isNew ? 'true' : 'false' }}
    };
    </script>
    <script src="{{ asset('js/admin-posts-font-modal.js') }}"></script>
    <script src="{{ asset('js/admin-posts-form.js') }}"></script>
{% endblock %}

{% block body %}
<!-- template: templates/admin/posts/form.html.twig -->
<div class="container-fluid py-5">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <h1 class="mb-0">{{ isNew ? 'Neuer Beitrag' : 'Beitrag bearbeiten' }}</h1>
        <div class="d-flex gap-2">
            <a href="{{ path('admin_posts') }}" class="btn btn-secondary" data-unsaved-cancel>
                <i class="bi bi-x-lg me-1"></i>Abbrechen
            </a>
            <button type="submit" form="post-form" class="btn btn-primary">
                <i class="bi bi-floppy me-1"></i>Speichern
            </button>
        </div>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger">{{ message }}</div>
    {% endfor %}

    {{ form_start(form, {'attr': {'enctype': 'multipart/form-data', 'data-turbo': 'false', 'id': 'post-form', 'data-unsaved-check': ''}}) }}
        <div class="row">
            {# Left Column - Form Fields #}
            <div class="col-md-6">

                <div class="mb-3">
                            <div class="d-flex align-items-center">
                                {{ form_label(form.title, null, {'label_attr': {'class': 'mb-0 me-2'}}) }}
                                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#fontModalTitle" title="Schriftart und Größe">
                                    <i class="bi bi-fonts"></i>
                                </button>
                            </div>
                            {{ form_widget(form.title, {'attr': {'class': 'form-control mt-2', 'id': 'post-title'}}) }}
                            <small class="form-text text-muted">
                                <span id="title-counter">0</span> / 255 Zeichen
                            </small>
                            {{ form_errors(form.title) }}
                        </div>

                        <div class="mb-3">
                            <div class="d-flex align-items-center">
                                {{ form_label(form.subtitle, null, {'label_attr': {'class': 'mb-0 me-2'}}) }}
                                <span class="badge bg-secondary me-2">Optional</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#fontModalSubtitle" title="Schriftart und Größe">
                                    <i class="bi bi-fonts"></i>
                                </button>
                            </div>
                            {{ form_widget(form.subtitle, {'attr': {'class': 'form-control mt-2', 'id': 'post-subtitle'}}) }}
                            <small class="form-text text-muted">
                                <span id="subtitle-counter">0</span> / 255 Zeichen
                            </small>
                            {{ form_errors(form.subtitle) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.date) }}
                            <span class="badge bg-secondary ms-1">Optional</span>
                            <div class="d-flex gap-2 mt-2">
                                <div>
                                    <label class="form-label small">Jahr</label>
                                    {{ form_widget(form.date.year) }}
                                </div>
                                <div>
                                    <label class="form-label small">Monat</label>
                                    {{ form_widget(form.date.month) }}
                                </div>
                                <div>
                                    <label class="form-label small">Tag</label>
                                    {{ form_widget(form.date.day) }}
                                </div>
                            </div>
                            <small class="form-text text-muted">
                                Geben Sie ein vollständiges Datum, nur Jahr und Monat oder nur das Jahr ein
                            </small>
                            {{ form_errors(form.date) }}

                            {# Datalists for year, month, day dropdowns #}
                            <datalist id="year-list">
                                {% for year in range('now'|date('Y') + 10, 1950) %}
                                    <option value="{{ year }}">
                                {% endfor %}
                            </datalist>

                            <datalist id="month-list">
                                <option value="01">Januar</option>
                                <option value="02">Februar</option>
                                <option value="03">März</option>
                                <option value="04">April</option>
                                <option value="05">Mai</option>
                                <option value="06">Juni</option>
                                <option value="07">Juli</option>
                                <option value="08">August</option>
                                <option value="09">September</option>
                                <option value="10">Oktober</option>
                                <option value="11">November</option>
                                <option value="12">Dezember</option>
                            </datalist>

                            <datalist id="day-list">
                                {% for day in 1..31 %}
                                    <option value="{{ '%02d'|format(day) }}">
                                {% endfor %}
                            </datalist>
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.imageFile) }}
                            <span class="badge bg-secondary ms-1">Optional</span>
                            {{ form_widget(form.imageFile, {'attr': {'class': 'form-control', 'id': 'post-image'}}) }}
                            <small class="form-text text-muted">
                                Erlaubte Formate: JPG, PNG, GIF, WebP, PDF. Max: 20 MB.
                            </small>
                            <div id="image-info" class="mt-2" style="display: none;">
                                <span class="badge bg-info">
                                    <span id="image-size"></span> | <span id="image-dimensions"></span>
                                </span>
                            </div>
                            {{ form_errors(form.imageFile) }}
                        </div>

                        <div class="mb-3">
                            <div class="d-flex align-items-center justify-content-between">
                                {{ form_label(form.galleryFiles) }}
                                <span class="badge bg-secondary">Optional</span>
                            </div>
                            <div class="mt-2">
                                <button type="button" class="btn btn-outline-secondary btn-sm" id="add-gallery-photos-btn">
                                    <i class="bi bi-images me-1"></i>Fotos auswählen
                                </button>
                                <input type="file" id="gallery-picker" accept="image/jpeg,image/png,image/gif,image/webp,application/pdf" multiple style="position:absolute;width:1px;height:1px;opacity:0;overflow:hidden;">
                            </div>
                            {# Real field submitted with the form; populated from the cropped files via JS #}
                            {{ form_widget(form.galleryFiles, {'attr': {'style': 'display:none;', 'id': 'post-gallery-files'}}) }}

                            <div id="gallery-thumbs" class="d-flex flex-wrap gap-2 mt-3">
                                {% if not isNew %}
                                    {% for image in post.images %}
                                        <div class="gallery-thumb position-relative" style="width:90px;">
                                            <img src="{{ asset(image.imagePath) }}" alt="" class="rounded border" style="width:90px;height:90px;object-fit:cover;{% if image.rotation %}transform:rotate({{ image.rotation }}deg);{% endif %}">
                                            <label class="position-absolute top-0 end-0 bg-white bg-opacity-75 rounded-circle d-flex align-items-center justify-content-center" style="width:22px;height:22px;margin:3px;cursor:pointer;" title="Foto löschen">
                                                <input type="checkbox" class="form-check-input m-0" name="delete_gallery_image[]" value="{{ image.id }}" style="width:16px;height:16px;">
                                            </label>
                                        </div>
                                    {% endfor %}
                                {% endif %}
                            </div>
                            <small class="form-text text-muted d-block">
                                Mehrere Fotos gleichzeitig wählbar – sie werden unverändert hochgeladen und als Galerie unterhalb des Beitrags angezeigt.
                            </small>
                            {{ form_errors(form.galleryFiles) }}
                        </div>

                        <div class="mb-3">
                            <div class="d-flex align-items-center">
                                {{ form_label(form.paragraph, null, {'label_attr': {'class': 'mb-0 me-2'}}) }}
                                <span class="badge bg-secondary me-2">Optional</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#fontModalParagraph" title="Schriftart und Größe">
                                    <i class="bi bi-fonts"></i>
                                </button>
                            </div>
                            <div id="quill-editor" class="mt-2" style="background-color: white; min-height: 150px;"></div>
                            {{ form_widget(form.paragraph, {'attr': {'class': 'form-control mt-2', 'id': 'post-paragraph', 'rows': 4, 'style': 'display: none;'}}) }}
                            {{ form_errors(form.paragraph) }}
                        </div>

                        {{ form_widget(form.fontTitle) }}
                        {{ form_widget(form.fontTitleSize) }}
                        {{ form_widget(form.fontTitleBold) }}
                        {{ form_widget(form.fontTitleItalic) }}
                        {{ form_widget(form.fontTitleUnderline) }}
                        {{ form_widget(form.fontSubtitle) }}
                        {{ form_widget(form.fontSubtitleSize) }}
                        {{ form_widget(form.fontSubtitleBold) }}
                        {{ form_widget(form.fontSubtitleItalic) }}
                        {{ form_widget(form.fontSubtitleUnderline) }}
                        {{ form_widget(form.fontParagraph) }}
                        {{ form_widget(form.fontParagraphSize) }}
                        {{ form_widget(form.fontParagraphBold) }}
                        {{ form_widget(form.fontParagraphItalic) }}
                        {{ form_widget(form.fontParagraphUnderline) }}
                        {{ form_widget(form.imageRotation) }}

                        <div class="mb-3">
                            {{ form_label(form.layout) }}
                            {{ form_widget(form.layout, {'attr': {'class': 'form-select', 'id': 'post-layout'}}) }}
                            {{ form_errors(form.layout) }}
                        </div>

                        <div class="mb-3 form-check">
                            {{ form_widget(form.isMain, {'attr': {'class': 'form-check-input', 'id': 'post-is-main'}}) }}
                            {{ form_label(form.isMain) }}
                            <small class="form-text text-muted d-block">
                                Wenn aktiviert, bleibt dieser Beitrag immer ganz oben.
                            </small>
                            {{ form_errors(form.isMain) }}
                        </div>

            </div>

            {# Right Column - Page Selection & Full Page Preview #}
            <div class="col-md-6">
                {% if not isNew and post.imagePath %}
                    {# Hidden image for JS rotation tracking #}
                    <img id="current-image" src="{{ asset(post.imagePath) }}" alt=""
                         style="display:none; transform: rotate({{ post.imageRotation ?? 0 }}deg);">
                {% endif %}

                <div class="mb-3">
                    <div class="d-flex align-items-end gap-2">
                        <div class="flex-grow-1">
                            {{ form_label(form.page) }}
                            {{ form_widget(form.page, {'attr': {'class': 'form-select', 'id': 'post-page'}}) }}
                            {{ form_errors(form.page) }}
                        </div>
                        <a href="#" class="btn btn-outline-primary" id="goto-page-btn" style="white-space: nowrap;">
                            <i class="bi bi-box-arrow-up-right"></i> Zur Seite
                        </a>
                    </div>
                </div>

                <div class="card sticky-top" style="top: 20px; max-height: 80vh; overflow-y: auto;" id="right-card">
                    {# Preview header #}
                    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center" id="preview-card-header">
                        <div>
                            <h5 class="mb-0">Seitenvorschau</h5>
                            <small>Die vollständige Seite mit Ihrem Beitrag</small>
                        </div>
                        {% if not isNew and post.imagePath %}
                        <div class="d-flex align-items-center gap-1 ms-2">
                            <button type="button" class="btn btn-sm btn-outline-light" id="rotate-left" title="90° nach links drehen">
                                <i class="bi bi-arrow-counterclockwise"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-light" id="rotate-right" title="90° nach rechts drehen">
                                <i class="bi bi-arrow-clockwise"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-light" id="crop-existing-btn" title="Zuschneiden">
                                <i class="bi bi-crop"></i> Zuschneiden
                            </button>
                        </div>
                        {% endif %}
                    </div>
                    {# Editor header #}
                    <div class="card-header bg-dark text-white" id="editor-card-header" style="display:none;">
                        <h5 class="mb-0"><i class="bi bi-crop me-2"></i>Bild bearbeiten</h5>
                    </div>

                    {# Preview body #}
                    <div class="card-body p-2" id="preview-container" style="background-color: #f8f9fa;">
                        <div id="full-page-preview" style="width: 1200px; transform-origin: top left;">
                            <div class="text-center text-muted py-5">
                                <div class="spinner-border" role="status">
                                    <span class="visually-hidden">Laden...</span>
                                </div>
                                <p class="mt-2">Vorschau wird geladen...</p>
                            </div>
                        </div>
                    </div>

                    {# Editor body #}
                    <div id="image-editor-body" style="display:none;">
                        <div style="height:50vh; background:#1a1a1a;">
                            <img id="crop-image" src="" alt="" style="max-width:100%; display:block;">
                        </div>
                        <div class="p-2 border-top">
                            <div class="d-flex align-items-center gap-1 flex-wrap mb-2">
                                <span class="small fw-bold text-muted me-1">Drehen:</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary" id="editor-rotate-left"><i class="bi bi-arrow-counterclockwise"></i></button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" id="editor-rotate-right"><i class="bi bi-arrow-clockwise"></i></button>
                                <span class="small fw-bold text-muted ms-2 me-1">Verhältnis:</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary active" data-ratio="free">Frei</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" data-ratio="1">1:1</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" data-ratio="1.3333">4:3</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" data-ratio="0.75">3:4</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" data-ratio="1.7778">16:9</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" data-ratio="original">Original</button>
                            </div>
                            <div class="d-flex align-items-center gap-1 flex-wrap mb-2">
                                <span class="small fw-bold text-muted me-1">Ausgabe:</span>
                                <input type="number" id="crop-output-width" class="form-control form-control-sm" style="width:80px;" min="1" placeholder="B">
                                <span class="text-muted small">×</span>
                                <input type="number" id="crop-output-height" class="form-control form-control-sm" style="width:80px;" min="1" placeholder="H">
                                <div class="form-check mb-0 ms-1">
                                    <input type="checkbox" id="crop-keep-ratio" class="form-check-input" checked>
                                    <label for="crop-keep-ratio" class="form-check-label small">Verhältnis</label>
                                </div>
                                <span class="text-muted small ms-2" id="crop-selection-size"></span>
                                <span class="text-muted small" id="crop-original-size"></span>
                            </div>
                            <div id="sibling-image-info" class="d-flex align-items-center gap-1 mb-2" style="display:none !important;">
                                <i class="bi bi-image text-muted"></i>
                                <span class="small text-muted">2. Bild:</span>
                                <span class="small fw-bold" id="sibling-image-dims"></span>
                                <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-1 ms-1" id="use-sibling-size" style="font-size:0.75rem;">Übernehmen</button>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-primary btn-sm flex-grow-1" id="crop-apply-btn"><i class="bi bi-check-lg"></i> Speichern</button>
                                <button type="button" class="btn btn-secondary btn-sm" id="crop-cancel-btn">Abbrechen</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {{ form_end(form) }}

    {# Font Selection Modals #}
    {% include 'admin/posts/_font_modal.html.twig' with {'field': 'title', 'modalId': 'fontModalTitle', 'label': 'Titel'} %}
    {% include 'admin/posts/_font_modal.html.twig' with {'field': 'subtitle', 'modalId': 'fontModalSubtitle', 'label': 'Untertitel'} %}
    {% include 'admin/posts/_font_modal.html.twig' with {'field': 'paragraph', 'modalId': 'fontModalParagraph', 'label': 'Text'} %}
</div>
{% endblock %}
