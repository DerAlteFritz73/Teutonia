{% extends 'base.html.twig' %}

{% block title %}Unser Repertoire - Chorgemeinschaft Teutonia Willstätt{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/repertoire.css') }}">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/wordcloud@1.2.2/src/wordcloud2.min.js"></script>
    <script>window.REPERTOIRE_CONFIG = { wordcloudUrl: '{{ path('api_wordcloud') }}' };</script>
    <script src="{{ asset('js/repertoire.js') }}"></script>
{% endblock %}

{% block body %}
<!-- template: templates/pages/unser-repertoire.html.twig -->
<main id="main-content">
    <div class="container" id="page-container">
        <h1 id="page-title">Unser Repertoire</h1>
        <div class="d-flex align-items-center gap-3 mb-3">
            <button type="button" class="btn btn-primary flex-shrink-0" onclick="loadWordCloud(); randomizeSongs();">Entdecke hier</button>
            <p class="lead mb-0" id="page-lead">die Lieder und Kompositionen, die wir singen</p>
        </div>

        {# Word Cloud Section - Visible to all #}
        <section class="word-cloud-section mb-5">
            <div class="card shadow-sm">
                <div class="card-body p-0">
                    <div id="wordcloud-container" style="height: 500px; position: relative; background: #f8f9fa;">
                        <canvas id="wordcloud" style="width: 100%; height: 100%;"></canvas>
                    </div>
                </div>
            </div>
        </section>

        {# ── Style Ellipses ─────────────────────────────────────────────── #}
        {% set displayStyles = styles|filter(s => s.repertoireSongs|length > 0) %}
        {% if displayStyles|length > 0 %}
        <section class="styles-section mt-2 mb-5" id="styles-section">

            <div class="row g-4 justify-content-center">
                {% for style in displayStyles %}
                    {% set visibleSongs = style.repertoireSongs %}
                    <div class="col-sm-6 col-lg-4 d-flex flex-column align-items-center">
                        <div class="ellipse-wrapper">
                            <div class="style-ellipse"
                                 style="background: linear-gradient(135deg, {{ style.color ?? '#6c757d' }}, {{ style.color2 ?? style.color ?? '#495057' }})">
                                <span>{{ style.name }}</span>
                                {% if style.image %}
                                    <img src="{{ asset('images/styles/' ~ style.image) }}"
                                         class="style-img"
                                         alt="{{ style.name }}">
                                {% endif %}
                            </div>
                        </div>
                        {% set songsData = [] %}
                        {% for song in visibleSongs %}
                            {% if song.parent is null %}
                                {% set movements = [] %}
                                {% for movement in song.sortedChildren %}
                                    {% set movements = movements|merge([movement.songName]) %}
                                {% endfor %}
                                {% set songsData = songsData|merge([{
                                    'composer': song.composer,
                                    'songName': song.songName,
                                    'movements': movements
                                }]) %}
                            {% endif %}
                        {% endfor %}
                        <ul class="style-songs list-unstyled w-100 px-3 mt-1"
                            data-songs="{{ songsData|json_encode|e('html_attr') }}"></ul>
                    </div>
                {% endfor %}
            </div>
        </section>
        {% endif %}

        {% include 'components/posts_display.html.twig' %}

    </div>
</main>

{# Lightbox modal for style images #}
<div class="modal fade" id="style-lightbox" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:min(90vw,900px)">
        <div class="modal-content bg-dark border-0 shadow-lg">
            <div class="modal-header border-0 pb-0 pt-2 px-3">
                <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center p-3">
                <img id="style-lightbox-img" src="" alt="" class="img-fluid zoomable-img" style="max-height:80vh; object-fit:contain;">
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    const modal   = document.getElementById('style-lightbox');
    const lightImg = document.getElementById('style-lightbox-img');
    modal.addEventListener('show.bs.modal', function (e) {
        const trigger = e.relatedTarget;
        if (trigger) {
            lightImg.src = trigger.dataset.full;
            lightImg.alt = trigger.alt;
        }
    });
    modal.addEventListener('hidden.bs.modal', function () {
        lightImg.src = '';
    });
}());
</script>
{% endblock %}
