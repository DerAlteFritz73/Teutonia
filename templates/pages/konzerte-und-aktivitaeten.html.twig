{% extends 'base.html.twig' %}

{% block title %}Konzerte und Aktivitäten - Chorgemeinschaft Teutonia Willstätt{% endblock %}

{% block body %}
<!-- template: templates/pages/konzerte-und-aktivitaeten.html.twig -->
<main id="main-content">
    <div class="container" id="page-container">
        <h1 id="page-title">Konzerte und Aktivitäten</h1>

        <p class="lead" id="page-lead">Unser Chor entfaltet eine vielfältige und lebendige Konzerttätigkeit.</p>

        <div class="row">
            {% if years is defined and years|length > 0 %}
            <div class="col-md-2 pe-0">
                <label for="year-selector" class="form-label mb-1 small text-muted">Nach Jahr filtern:</label>
                <select id="year-selector" class="form-select form-select-sm">
                    <option value="">Alle Jahre</option>
                    {% for year in years %}
                        <option value="{{ year }}">{{ year }}</option>
                    {% endfor %}
                </select>
            </div>
            {% endif %}
            <div class="{% if years is defined and years|length > 0 %}col-md-10{% else %}col-12{% endif %}">
                {% if konzerte is defined and konzerte|length > 0 %}
                    {% include 'components/concerts_display.html.twig' %}
                {% endif %}
                {% include 'components/posts_display.html.twig' %}
            </div>
        </div>
    </div>
</main>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/pages-concerts.js') }}"></script>
{% endblock %}

