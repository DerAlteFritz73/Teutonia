<!DOCTYPE html>
<html lang="de" data-theme="{{ active_theme() }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Chorgemeinschaft Teutonia Willstätt{% endblock %}</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500;600;700&display=swap">
        <link rel="stylesheet" href="/css/app.css?v=10">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
        <style>
        /* Post photo galleries: centered/coverflow carousel (Swiper). Loaded
           site-wide since posts_display.html.twig is included from most
           public pages -- see components/_post_gallery.html.twig. */
        .post-gallery-swiper { padding: 10px 0 40px; }
        .post-gallery-swiper .swiper-slide {
            width: 260px;
            height: 220px;
            background-color: #e9ecef;
            border-radius: 0.5rem;
        }
        .post-gallery-swiper .swiper-slide img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            border-radius: 0.5rem;
            display: block;
        }
        .post-gallery-swiper .swiper-button-prev,
        .post-gallery-swiper .swiper-button-next {
            color: #0d6efd;
        }
        </style>
        {% block stylesheets %}
        {% endblock %}

        <script>
        // pageLoad is defined once in <head>; head scripts are never re-executed by Turbo.
        (function () {
            var _fired = false;
            document.addEventListener('turbo:before-visit', function () { _fired = false; });
            document.addEventListener('turbo:load',         function () { _fired = true;  });
            window.pageLoad = function (fn) {
                document.addEventListener('turbo:load', fn);
                if (_fired) fn();
            };
        }());
        // Canonical HTML-escape helper, shared by all page scripts.
        // Escapes a superset (& < > " ') so it is safe in text and attribute contexts.
        window.escapeHtml = function (s) {
            return String(s == null ? '' : s)
                .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
        };
        </script>
        <script src="/js/app.js"></script>
        <script src="/js/image-zoom.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
        <script src="/js/post-gallery.js"></script>
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
        <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
        <meta http-equiv="Pragma" content="no-cache">
        <meta http-equiv="Expires" content="0">
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    </head>
    <body>
        {% set currentRoute = app.request.attributes.get('_route') %}

        {#
          Navigation is built once from these macros and rendered in two forms:
          • lg+  → the original two horizontal bars (visually unchanged)
          • <lg  → a single top bar with one hamburger that opens an offcanvas
                   drawer containing the public links + a Mitglieder section + Admin.
        #}
        {% macro public_links(currentRoute, drawer) %}
            {% set links = [
                {r: 'app_home',        l: 'Startseite'},
                {r: 'page_chor',       l: 'Unser Chor'},
                {r: 'page_concerts',   l: 'Konzerte'},
                {r: 'page_history',    l: 'Historie'},
                {r: 'page_rehearsals', l: 'Chorproben'},
                {r: 'page_repertoire', l: 'Repertoire'},
                {r: 'page_events',     l: 'Termine'},
                {r: 'page_social',     l: 'Geselliges'},
            ] %}
            {% for link in links %}
                <li class="nav-item">
                    <a class="nav-link{{ currentRoute == link.r ? ' active' : '' }}"
                       href="{{ path(link.r) }}">{{ link.l }}</a>
                </li>
            {% endfor %}
        {% endmacro %}

        {% macro member_links(currentRoute, drawer) %}
            {% set links = [
                {r: 'member_proben',          l: 'Aktuelle Proben'},
                {r: 'member_noten',           l: 'Liederverzeichnis'},
                {r: 'member_konzerte',        l: 'Konzerte', active: ['member_konzerte', 'admin_konzerte']},
                {r: 'member_google_kalender', l: 'Kalender'},
                {r: 'member_ideenkiste',      l: 'Ideenkiste'},
                {r: 'member_archiv',          l: 'Archiv'},
            ] %}
            {% for link in links %}
                {% set isActive = currentRoute in (link.active ?? [link.r]) %}
                <li class="nav-item">
                    <a class="nav-link text-light py-1{{ isActive ? ' text-warning fw-semibold' : '' }}"
                       href="{{ path(link.r) }}">{{ link.l }}</a>
                </li>
            {% endfor %}
            {% if is_granted('ROLE_ADMIN') %}
                <li class="nav-item"><a class="nav-link text-danger py-1{{ currentRoute starts with 'admin_' ? ' fw-semibold' : '' }}"
                    href="{{ path('admin_dashboard') }}">
                    <i class="bi bi-gear-fill me-1"></i>Admin</a></li>
            {% elseif is_granted('ROLE_NOTENWART') %}
                <li class="nav-item"><a class="nav-link text-warning py-1{{ currentRoute starts with 'admin_liederlisten' ? ' fw-semibold' : '' }}"
                    href="{{ path('admin_liederlisten') }}">
                    <i class="bi bi-music-note-list me-1"></i>LiederListe</a></li>
            {% endif %}
        {% endmacro %}

        <!-- ░░ Mobile top bar (<lg): brand + single hamburger ░░ -->
        <nav class="navbar navbar-dark bg-dark d-lg-none" id="mobile-nav">
            <div class="container">
                <a class="navbar-brand text-truncate minw-0 me-2" href="{{ path('app_home') }}">Teutonia Willstätt</a>
                <button class="navbar-toggler flex-shrink-0" type="button"
                        data-bs-toggle="offcanvas" data-bs-target="#mobileNavDrawer" aria-controls="mobileNavDrawer">
                    <span class="navbar-toggler-icon"></span>
                </button>
            </div>
        </nav>

        <!-- ░░ Mobile offcanvas drawer (<lg) ░░ -->
        <div class="offcanvas offcanvas-end text-bg-dark d-lg-none" tabindex="-1" id="mobileNavDrawer" aria-label="Navigation">
            <div class="offcanvas-header border-bottom border-secondary">
                <h5 class="offcanvas-title">Menü</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Schließen"></button>
            </div>
            <div class="offcanvas-body">
                <ul class="navbar-nav">
                    {{ _self.public_links(currentRoute, true) }}
                </ul>

                {% if is_granted('ROLE_USER') %}
                    <hr class="border-secondary my-3">
                    <div class="text-warning small fw-semibold mb-1 px-1">
                        <i class="bi bi-person-fill me-1"></i>Mitglieder
                    </div>
                    <ul class="navbar-nav">
                        {{ _self.member_links(currentRoute, true) }}
                    </ul>
                {% endif %}

                <hr class="border-secondary my-3">
                <div class="d-flex align-items-center gap-2 flex-wrap px-1">
                    {% if app.user %}
                        <a class="btn btn-sm btn-outline-light" href="{{ path('member_dashboard') }}">
                            <i class="bi bi-person me-1"></i>Mitgliederbereich
                        </a>
                        <a class="btn btn-sm btn-outline-warning" href="{{ path('app_logout') }}" data-turbo="false">Abmelden</a>
                    {% else %}
                        <a class="btn btn-sm btn-outline-light" href="{{ path('app_login') }}">Anmelden</a>
                    {% endif %}
                    <button onclick="try{Turbo.cache.clear()}catch(e){} location.reload()"
                            class="btn btn-sm btn-outline-secondary text-light border-secondary" title="Seite neu laden">
                        <i class="bi bi-arrow-clockwise"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- ░░ Desktop main navigation (lg+) ░░ -->
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark d-none d-lg-block" id="main-nav">
            <div class="container" id="nav-container">
                <a class="navbar-brand" href="{{ path('app_home') }}" id="navbar-brand">Teutonia Willstätt</a>
                <div class="navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto" id="navbar-nav-main">
                        {{ _self.public_links(currentRoute, false) }}
                    </ul>

                    <ul class="navbar-nav me-2">
                        <li class="nav-item d-flex align-items-center">
                            <button onclick="try{Turbo.cache.clear()}catch(e){} location.reload()" class="btn btn-sm btn-outline-secondary text-light border-0 px-2" title="Seite neu laden">
                                <i class="bi bi-arrow-clockwise"></i>
                            </button>
                        </li>
                    </ul>

                    <ul class="navbar-nav">
                        {% if app.user %}
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    {{ app.user.firstName }}
                                </a>
                                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                                    <li><a class="dropdown-item" href="{{ path('member_dashboard') }}">Mitgliederbereich</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="{{ path('app_logout') }}" data-turbo="false">Abmelden</a></li>
                                </ul>
                            </li>
                        {% else %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_login') }}">Anmelden</a>
                            </li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        </nav>

        <!-- ░░ Desktop member navigation (lg+, logged-in only) ░░ -->
        {% if is_granted('ROLE_USER') %}
        <nav class="navbar navbar-expand-lg navbar-dark py-1 d-none d-lg-block member-nav">
            <div class="container">
                <span class="navbar-text text-warning me-3 small fw-semibold">
                    <i class="bi bi-person-fill me-1"></i>Mitglieder
                </span>
                <div class="navbar-collapse" id="memberNav">
                    <ul class="navbar-nav me-auto">
                        {{ _self.member_links(currentRoute, false) }}
                    </ul>
                </div>
            </div>
        </nav>
        {% endif %}

        <!-- Main Content -->
        <main>
            {% block body %}
<!-- template: templates/base.html.twig -->{% endblock %}
        </main>

        <!-- Footer -->
        <footer class="bg-dark text-light py-4 mt-auto">
            <div class="container text-center">
                <p>&copy; {{ "now"|date("Y") }} Chorgemeinschaft Teutonia Willstätt e.V. Alle Rechte vorbehalten.</p>
            </div>
        </footer>

        <script>
        // The mobile nav drawer (Bootstrap offcanvas) is closed by navigating, not by
        // a data-bs-dismiss link (that would preventDefault the link). Make sure it is
        // hidden before a Turbo visit and that no backdrop / locked body survives a
        // page swap, so the next page is always interactive.
        document.addEventListener('turbo:before-visit', function () {
            document.querySelectorAll('.offcanvas.show').forEach(function (el) {
                var oc = window.bootstrap && bootstrap.Offcanvas.getInstance(el);
                if (oc) oc.hide();
            });
        });
        document.addEventListener('turbo:load', function () {
            document.querySelectorAll('.offcanvas-backdrop, .modal-backdrop').forEach(function (b) { b.remove(); });
            document.body.classList.remove('offcanvas-backdrop', 'modal-open');
            document.body.style.overflow = '';
            document.body.style.paddingRight = '';
        });
        pageLoad(function () {
            document.querySelectorAll('.alert.alert-dismissible').forEach(function (el) {
                setTimeout(function () {
                    var bsAlert = bootstrap.Alert.getOrCreateInstance(el);
                    bsAlert.close();
                }, 15000);
            });
        });
        </script>
    </body>
</html>
