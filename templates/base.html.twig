<!DOCTYPE html>
<html lang="de">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Chorgemeinschaft Teutonia Willstätt{% endblock %}</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
        <link rel="stylesheet" href="/css/app.css">
        {% block stylesheets %}
        {% endblock %}

        <script>
        // pageLoad is defined once in <head>; head scripts are never re-executed by Turbo.
        (function () {
            var _fired = false;
            document.addEventListener('turbo:before-visit', function () { _fired = false; });
            document.addEventListener('turbo:load',         function () { _fired = true;  });
            window.pageLoad = function (fn) {
                document.addEventListener('turbo:load', fn);
                if (_fired) fn();
            };
        }());
        </script>
        <script src="/js/app.js"></script>
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
        <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
        <meta http-equiv="Pragma" content="no-cache">
        <meta http-equiv="Expires" content="0">
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    </head>
    <body>
        <!-- Main Navigation -->
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark" id="main-nav">
            <div class="container" id="nav-container">
                <a class="navbar-brand" href="{{ path('app_home') }}" id="navbar-brand">Teutonia Willstätt</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" id="navbar-toggler">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto" id="navbar-nav-main">
                        {% set currentRoute = app.request.attributes.get('_route') %}
                        <li class="nav-item"><a class="nav-link{{ currentRoute == 'app_home' ? ' active' : '' }}" href="{{ path('app_home') }}">Startseite</a></li>
                        <li class="nav-item"><a class="nav-link{{ currentRoute == 'page_chor' ? ' active' : '' }}" href="{{ path('page_chor') }}">Unser Chor</a></li>
                        <li class="nav-item"><a class="nav-link{{ currentRoute == 'page_concerts' ? ' active' : '' }}" href="{{ path('page_concerts') }}">Konzerte</a></li>
                        <li class="nav-item"><a class="nav-link{{ currentRoute == 'page_history' ? ' active' : '' }}" href="{{ path('page_history') }}">Historie</a></li>
                        <li class="nav-item"><a class="nav-link{{ currentRoute == 'page_rehearsals' ? ' active' : '' }}" href="{{ path('page_rehearsals') }}">Chorproben</a></li>
                        <li class="nav-item"><a class="nav-link{{ currentRoute == 'page_repertoire' ? ' active' : '' }}" href="{{ path('page_repertoire') }}">Repertoire</a></li>
                        <li class="nav-item"><a class="nav-link{{ currentRoute == 'page_events' ? ' active' : '' }}" href="{{ path('page_events') }}">Termine</a></li>
                        <li class="nav-item"><a class="nav-link{{ currentRoute == 'page_social' ? ' active' : '' }}" href="{{ path('page_social') }}">Geselliges</a></li>
                    </ul>

                    <ul class="navbar-nav me-2">
                        <li class="nav-item d-flex align-items-center">
                            <button onclick="try{Turbo.cache.clear()}catch(e){} location.reload()" class="btn btn-sm btn-outline-secondary text-light border-0 px-2" title="Seite neu laden">
                                <i class="bi bi-arrow-clockwise"></i>
                            </button>
                        </li>
                    </ul>

                    <ul class="navbar-nav">
                        {% if app.user %}
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    {{ app.user.firstName }}
                                </a>
                                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                                    <li><a class="dropdown-item" href="{{ path('member_dashboard') }}">Mitgliederbereich</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="{{ path('app_logout') }}" data-turbo="false">Abmelden</a></li>
                                </ul>
                            </li>
                        {% else %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_login') }}">Anmelden</a>
                            </li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        </nav>

        <!-- Member Navigation (only for logged-in users) -->
        {% if is_granted('ROLE_USER') %}
        <nav class="navbar navbar-expand-lg navbar-dark py-1" style="background-color: #2c2c2c; border-top: 2px solid #ffc107;">
            <div class="container">
                <span class="navbar-text text-warning me-3 small fw-semibold">
                    <i class="bi bi-person-fill me-1"></i>Mitglieder
                </span>
                <button class="navbar-toggler navbar-toggler-sm border-warning py-0" type="button" data-bs-toggle="collapse" data-bs-target="#memberNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="memberNav">
                    <ul class="navbar-nav me-auto">
                        {% set currentRoute = app.request.attributes.get('_route') %}
                        <li class="nav-item"><a class="nav-link text-light py-1{{ currentRoute == 'member_proben' ? ' text-warning fw-semibold' : '' }}" href="{{ path('member_proben') }}">Aktuelle Proben</a></li>
                        <li class="nav-item"><a class="nav-link text-light py-1{{ currentRoute in ['member_konzerte', 'admin_konzerte'] ? ' text-warning fw-semibold' : '' }}" href="{{ path('member_konzerte') }}">Konzerte</a></li>
                        <li class="nav-item"><a class="nav-link text-light py-1{{ currentRoute == 'member_google_kalender' ? ' text-warning fw-semibold' : '' }}" href="{{ path('member_google_kalender') }}">Kalender</a></li>
                        <li class="nav-item"><a class="nav-link text-light py-1{{ currentRoute == 'member_ideenkiste' ? ' text-warning fw-semibold' : '' }}" href="{{ path('member_ideenkiste') }}">Ideenkiste</a></li>
                        <li class="nav-item"><a class="nav-link text-light py-1{{ currentRoute == 'member_archiv' ? ' text-warning fw-semibold' : '' }}" href="{{ path('member_archiv') }}">Archiv</a></li>
                        {% if is_granted('ROLE_ADMIN') %}
                        <li class="nav-item"><a class="nav-link text-danger py-1{{ currentRoute starts with 'admin_' ? ' fw-semibold' : '' }}" href="{{ path('admin_dashboard') }}">
                            <i class="bi bi-gear-fill me-1"></i>Admin
                        </a></li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        </nav>
        {% endif %}

        <!-- Main Content -->
        <main>
            {% block body %}
<!-- template: templates/base.html.twig -->{% endblock %}
        </main>

        <!-- Footer -->
        <footer class="bg-dark text-light py-4 mt-auto">
            <div class="container text-center">
                <p>&copy; {{ "now"|date("Y") }} Chorgemeinschaft Teutonia Willstätt e.V. Alle Rechte vorbehalten.</p>
            </div>
        </footer>

    </body>
</html>
