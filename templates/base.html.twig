<!DOCTYPE html>
<html lang="de">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Chorgemeinschaft Teutonia Willstätt{% endblock %}</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
        <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
        <meta http-equiv="Pragma" content="no-cache">
        <meta http-equiv="Expires" content="0">
        <style>
            html, body { height: 100%; }
            body { display: flex; flex-direction: column; min-height: 100vh; }
            main { flex: 1 0 auto; padding-top: 1rem; }
            footer { flex-shrink: 0; }
            /* Hide empty paragraphs from Quill editor */
            p:empty, p:has(br:only-child) { display: none; }
        </style>
    </head>
    <body>
        <!-- Navigation -->
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark" id="main-nav">
            <div class="container" id="nav-container">
                <a class="navbar-brand" href="{{ path('app_home') }}" id="navbar-brand">Teutonia Willstätt</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" id="navbar-toggler">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto" id="navbar-nav-main">
                        {% set currentRoute = app.request.attributes.get('_route') %}
                        <li class="nav-item"><a class="nav-link{{ currentRoute == 'app_home' ? ' active' : '' }}" href="{{ path('app_home') }}">Startseite</a></li>
                        <li class="nav-item"><a class="nav-link{{ currentRoute == 'page_chor' ? ' active' : '' }}" href="{{ path('page_chor') }}">Unser Chor</a></li>
                        <li class="nav-item"><a class="nav-link{{ currentRoute == 'page_concerts' ? ' active' : '' }}" href="{{ path('page_concerts') }}">Konzerte</a></li>
                        <li class="nav-item"><a class="nav-link{{ currentRoute == 'page_history' ? ' active' : '' }}" href="{{ path('page_history') }}">Historie</a></li>
                        <li class="nav-item"><a class="nav-link{{ currentRoute == 'page_rehearsals' ? ' active' : '' }}" href="{{ path('page_rehearsals') }}">Chorproben</a></li>
                        <li class="nav-item"><a class="nav-link{{ currentRoute == 'page_repertoire' ? ' active' : '' }}" href="{{ path('page_repertoire') }}">Repertoire</a></li>
                        <li class="nav-item"><a class="nav-link{{ currentRoute == 'page_events' ? ' active' : '' }}" href="{{ path('page_events') }}">Termine</a></li>
                        <li class="nav-item"><a class="nav-link{{ currentRoute == 'page_social' ? ' active' : '' }}" href="{{ path('page_social') }}">Geselliges</a></li>
                        <li class="nav-item"><a class="nav-link{{ currentRoute == 'page_archive' ? ' active' : '' }}" href="{{ path('page_archive') }}">Archiv</a></li>

                        {% if is_granted('ROLE_USER') %}
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-warning{{ currentRoute starts with 'member_' ? ' active' : '' }}" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Mitglieder
                                </a>
                                <ul class="dropdown-menu dropdown-menu-dark">
                                    <li><a class="dropdown-item{{ currentRoute == 'member_proben' ? ' active' : '' }}" href="{{ path('member_proben') }}">Aktuelle Proben</a></li>
                                    <li><a class="dropdown-item{{ currentRoute == 'member_kalender' ? ' active' : '' }}" href="{{ path('member_kalender') }}">Kalender</a></li>
                                    <li><a class="dropdown-item{{ currentRoute == 'member_ideenkiste' ? ' active' : '' }}" href="{{ path('member_ideenkiste') }}">Ideenkiste</a></li>
                                </ul>
                            </li>
                        {% endif %}

                        {% if is_granted('ROLE_ADMIN') %}
                            <li class="nav-item">
                                <a class="nav-link text-danger{{ currentRoute starts with 'admin_' ? ' active' : '' }}" href="{{ path('admin_dashboard') }}">Admin</a>
                            </li>
                        {% endif %}
                    </ul>

                    <ul class="navbar-nav">
                        {% if app.user %}
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    {{ app.user.firstName }}
                                </a>
                                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                                    <li><a class="dropdown-item" href="{{ path('member_dashboard') }}">Mitgliederbereich</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="{{ path('app_logout') }}">Abmelden</a></li>
                                </ul>
                            </li>
                        {% else %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_login') }}">Anmelden</a>
                            </li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        </nav>

        <!-- Main Content -->
        <main>
            {% block body %}{% endblock %}
        </main>

        <!-- Footer -->
        <footer class="bg-dark text-light py-4 mt-auto">
            <div class="container text-center">
                <p>&copy; {{ "now"|date("Y") }} Chorgemeinschaft Teutonia Willstätt e.V. Alle Rechte vorbehalten.</p>
            </div>
        </footer>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
        <script>
            function togglePassword(inputId, button) {
                const input = document.getElementById(inputId);
                const icon = button.querySelector('svg');
                if (input.type === 'password') {
                    input.type = 'text';
                    icon.innerHTML = '<path d="M13.359 11.238C15.06 9.72 16 8 16 8s-3-5.5-8-5.5a7 7 0 0 0-2.79.588l.77.771A6 6 0 0 1 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755-.165.165-.337.328-.517.486z"/><path d="M11.297 9.176a3.5 3.5 0 0 0-4.474-4.474l.823.823a2.5 2.5 0 0 1 2.829 2.829zm-2.943 1.299.822.822a3.5 3.5 0 0 1-4.474-4.474l.823.823a2.5 2.5 0 0 0 2.829 2.829"/><path d="M3.35 5.47q-.27.24-.518.487A13 13 0 0 0 1.172 8l.195.288c.335.48.83 1.12 1.465 1.755C4.121 11.332 5.881 12.5 8 12.5c.716 0 1.39-.133 2.02-.36l.77.772A7 7 0 0 1 8 13.5C3 13.5 0 8 0 8s.939-1.721 2.641-3.238l.708.709z"/><path d="m14.854 14.146-13-13-.708.708 13 13z"/>';
                } else {
                    input.type = 'password';
                    icon.innerHTML = '<path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/><path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/>';
                }
            }

            // Fix Bootstrap dropdown issue - prevent default on dropdown toggles
            document.addEventListener('DOMContentLoaded', function() {
                document.querySelectorAll('[data-bs-toggle="dropdown"]').forEach(function(dropdownToggle) {
                    dropdownToggle.addEventListener('click', function(e) {
                        e.preventDefault();
                    });
                });
            });
        </script>
    </body>
</html>
