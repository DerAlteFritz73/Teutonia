<!DOCTYPE html>
<html lang="de">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Chorgemeinschaft Teutonia Willstätt{% endblock %}</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <!-- Navigation -->
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand" href="{{ path('app_home') }}">Teutonia Willstätt</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item"><a class="nav-link" href="{{ path('app_home') }}">Startseite</a></li>
                        <li class="nav-item"><a class="nav-link" href="{{ path('page_chor') }}">Unser Chor</a></li>
                        <li class="nav-item"><a class="nav-link" href="{{ path('page_concerts') }}">Konzerte</a></li>
                        <li class="nav-item"><a class="nav-link" href="{{ path('page_history') }}">Historie</a></li>
                        <li class="nav-item"><a class="nav-link" href="{{ path('page_rehearsals') }}">Chorproben</a></li>
                        <li class="nav-item"><a class="nav-link" href="{{ path('page_repertoire') }}">Repertoire</a></li>
                        <li class="nav-item"><a class="nav-link" href="{{ path('page_events') }}">Termine</a></li>
                        <li class="nav-item"><a class="nav-link" href="{{ path('page_social') }}">Geselliges</a></li>
                        <li class="nav-item"><a class="nav-link" href="{{ path('page_archive') }}">Archiv</a></li>
                    </ul>
                </div>
            </div>
        </nav>

        <!-- Main Content -->
        {% block body %}{% endblock %}

        <!-- Footer -->
        <footer class="bg-dark text-light mt-5 py-4">
            <div class="container text-center">
                <p>&copy; 2024 Chorgemeinschaft Teutonia Willstätt e.V. Alle Rechte vorbehalten.</p>
            </div>
        </footer>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    </body>
</html>
